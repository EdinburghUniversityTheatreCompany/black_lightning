<%= render Admin::ImportPreviewComponent.new(total: @import.rows.size, cancel_path: new_admin_membership_import_path, confirm_path: confirm_admin_membership_imports_path, cache_key: @cache_key) do %>
  <%= render Admin::ImportPreviewSectionComponent.new(items: @import.categorized[:activate_by_email], title: "Activate by Email Match", variant: :info, hint: "Will be activated automatically", headers: [ "Import Name", "Existing User", "Email Match", "Action" ]) do |section| %>
    <% section.items.each do |item| %>
      <%= render Admin::ImportExactMatchRowComponent.new(item:, value: item[:row][:email], action: "activate", badge: "Will Activate", badge_type: :info, show_row_id: true) do %>
        <% if item[:existing_user].student_id.blank? && item[:row][:student_id].present? %>
          <br><small class="text-success">+ will add student ID</small>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @import.categorized[:propose_merge].any? %>
    <%= render CardComponent.new(variant: :warning, flush: true) do |c| %>
      <% c.with_tools do %>
        <span class="text-base font-semibold flex-1">Possible Matches (Review Required)</span>
        <%= render(BadgeComponent.new(type: :dark, html_class: "ml-2")) { @import.categorized[:propose_merge].size.to_s } %>
        <small class="ml-auto">Please decide for each row</small>
      <% end %>
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Import Data</th>
            <th>Possible Match(es)</th>
            <th style="width: 280px;">Decision</th>
          </tr>
        </thead>
        <tbody>
          <% @import.categorized[:propose_merge].each do |item| %>
            <tr>
              <td>
                <strong><%= item[:row][:original_name] %></strong><br>
                <small class="text-gray-500"><%= item[:row][:email] %></small>
                <% if item[:row][:student_id] || item[:row][:associate_id] %>
                  <br><small class="text-gray-500">ID: <%= item[:row][:student_id] || item[:row][:associate_id] %></small>
                <% end %>
              </td>
              <td>
                <% item[:existing_users].each_with_index do |user, i| %>
                  <% years = @import.years_active_cache[user.id] %>
                  <%= link_to user.name_or_email, admin_user_path(user) %>
                  <small class="text-gray-500">(<%= format_years_active_label(years) %>)</small><br>
                  <small class="text-gray-500"><%= user.email %></small>
                  <% if user.student_id.present? %>
                    <br><small class="text-gray-500">ID: <%= user.student_id %></small>
                  <% end %>
                  <% if i < item[:existing_users].size - 1 %>
                    <hr class="my-1">
                  <% end %>
                <% end %>
              </td>
              <td>
                <% item[:existing_users].each_with_index do |user, i| %>
                  <%= import_choice(item[:index], "merge_#{user.id}", "Merge with #{user.name_or_email} (#{format_years_active_label(@import.years_active_cache[user.id])})", checked: i.zero?) %>
                <% end %>
                <%= import_choice(item[:index], "create", "Create New") %>
                <%= import_choice(item[:index], "skip", "Skip") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <% if @import.categorized[:create_new].any? %>
    <%= render CardComponent.new(variant: :primary, flush: true) do |c| %>
      <% c.with_tools do %>
        <span class="text-base font-semibold flex-1">New Users to Create</span>
        <%= render(BadgeComponent.new(type: :light, html_class: "ml-2")) { @import.categorized[:create_new].size.to_s } %>
        <small class="ml-auto">Will create and activate</small>
      <% end %>
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>ID</th>
            <th style="width: 150px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @import.categorized[:create_new].each do |item| %>
            <tr>
              <td><%= item[:row][:original_name] %></td>
              <td>
                <% if item[:row][:email].present? %>
                  <span class="font-mono"><%= item[:row][:email] %></span>
                <% else %>
                  <em class="text-gray-500">(will generate placeholder)</em>
                <% end %>
              </td>
              <td>
                <% if item[:row][:student_id] || item[:row][:associate_id] %>
                  <span class="font-mono"><%= item[:row][:student_id] || item[:row][:associate_id] %></span>
                <% else %>
                  <em class="text-gray-500">-</em>
                <% end %>
              </td>
              <td>
                <%= import_choice(item[:index], "create", "Create & Activate", checked: true) %>
                <%= import_choice(item[:index], "skip", "Skip") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <%= render Admin::ImportPreviewSectionComponent.new(items: @import.categorized[:already_active], title: "Already Active Members", variant: :secondary, hint: "No action needed", headers: [ "Import Name", "Existing User", "ID", "Status" ]) do |section| %>
    <% section.items.each do |item| %>
      <%= render Admin::ImportExactMatchRowComponent.new(item:, value: import_match_label(item), badge: "Already Member", badge_type: :success, row_class: "table-secondary") %>
    <% end %>
  <% end %>

  <%= render Admin::ImportPreviewSectionComponent.new(items: @import.categorized[:activate_by_id], title: "Activate by ID", variant: :info, hint: "Will be activated automatically", headers: [ "Import Name", "Existing User", "ID Match", "Action" ]) do |section| %>
    <% section.items.each do |item| %>
      <%= render Admin::ImportExactMatchRowComponent.new(item:, value: import_match_label(item), action: "activate", badge: "Will Activate", badge_type: :info) do %>
        <br><small class="text-gray-500"><%= item[:existing_user].email %></small>
      <% end %>
    <% end %>
  <% end %>
<% end %>
