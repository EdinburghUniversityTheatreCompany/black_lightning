#!/usr/bin/env sh
# Hot-restart the running Puma dev server in place (SIGUSR2).
#
# Puma re-execs itself on SIGUSR2, keeping the same PID, so `mise run serve`
# does not see a child die and tear down the whole dev group — Vite keeps running.
# Use this to reload boot-time state: config/initializers, config/*, Gemfile,
# env vars, and new/enum-backed DB columns. Everyday app code (models,
# controllers, views) is auto-reloaded and needs no restart.
#
# Note: this is NOT `touch tmp/restart.txt` — that only works with Passenger,
# which this project does not use.

set -e

# Puma tags its process with the directory it was started from, so a worktree's server is
# `[<worktree>]`, not `[BlackLightning]`. Matching the literal name restarted the MAIN checkout's
# server from every worktree, and left the worktree's own untouched.
tag=$(basename "$(cd "$(dirname "$0")/.." && pwd)")
pid=$(pgrep -f "puma .* \[$tag\]" || true)

if [ -z "$pid" ]; then
  echo "No running Puma dev server found (is the dev server running?)." >&2
  exit 1
fi

echo "Hot-restarting Puma (pid $pid) via SIGUSR2..."
kill -USR2 "$pid"
echo "Done. Watch the dev server for the restart log."
