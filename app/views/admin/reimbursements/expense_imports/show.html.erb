<%# The whole wizard lives in one Turbo Frame, as the budget import and
    Reconcile do: preview and apply POST the sheet back and render their step
    directly, because the wizard is stateless and a redirect can't carry the
    paste. OUTSIDE a frame Turbo Drive rejects non-redirect form responses and
    silently discards them. %>
<%= turbo_frame_tag "expense_import" do %>
<%# Every link out of this frame needs turbo_frame: "_top": a link inside a
    Turbo Frame navigates THE FRAME, and a destination with no matching frame
    lands as "Content missing" instead of the page. %>
<%= render "shared/back_link", text: "All expenses", turbo_frame: "_top",
           path: admin_reimbursements_expense_edits_path %>

<%# Flash lives in the layout, outside this frame, so a frame-only response
    would never show it. %>
<% if flash[:alert].present? %>
  <%= render AlertComponent.new(type: :danger) do %><%= flash[:alert] %><% end %>
<% end %>

<%# form_with wraps the CardComponent, never the other way round: the footer is
    a component SLOT, so a form opened inside the card renders its submit button
    outside the <form> and the button silently does nothing. %>
<%= form_with url: preview_admin_reimbursements_expense_import_path,
              method: :post, multipart: true do %>
  <%= render CardComponent.new(title: "Import expenses") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Preview import",
            cancel_path: admin_reimbursements_expense_edits_path,
            submit_html: { data: { disable_with: "Reading…" } } %>
    <% end %>

    <p class="mb-4 text-sm text-gray-600">
      Paste the sheet of claims the portal doesn't have (including its header row), or upload
      the .xlsx. Nothing is written yet — the next screen shows exactly what would be created,
      which column it read for each field, and what will happen to any claim imported at a live
      status. Receipts aren't imported: attach any you have to the claim afterwards.
    </p>

    <p class="mb-4 text-sm text-gray-600">
      Columns read: <strong><%= ::Reimbursements::ExpenseImport::TSV_HEADERS.to_sentence %></strong>.
      <strong><%= ::Reimbursements::ExpenseImport.required_labels.to_sentence %></strong>
      are required on every line — the reference is your own sheet's id for the claim (a row
      number will do), and it's what stops importing the same sheet twice creating everything
      twice.
      <%= link_to "Download a template",
                  template_admin_reimbursements_expense_import_path(format: :csv),
                  class: "text-primary underline", data: { turbo_frame: "_top" } %>.
    </p>

    <div class="flex flex-col gap-4">
      <%# Both halves of the destination. A claim's budget is matched by name
          within one (year, cost centre), so neither can be assumed — whichever
          side the link prefilled arrives selected, and the operator picks the
          other. %>
      <%= render "shared/form/field", label: "Financial year", name: :year,
            hint: "Which year these claims belong to.", html_class: "sm:w-1/2" do %>
        <%= select_tag :year,
                       options_from_collection_for_select(selectable_financial_years, :key, :label,
                                                          selected_financial_year&.key),
                       class: input_classes %>
      <% end %>

      <%= render "shared/form/field", label: "Cost centre", name: :cost_centre_id,
            hint: "Which pot paid them.", html_class: "sm:w-1/2" do %>
        <%= select_tag :cost_centre_id,
                       options_from_collection_for_select(selectable_cost_centres, :id, :name,
                                                          selected_cost_centre&.id ||
                                                            selectable_cost_centres.first&.id),
                       class: input_classes %>
      <% end %>

      <%= render "shared/form/paste_or_upload",
            text_name: :pasted_text, text_label: "Paste the sheet", text_value: params[:pasted_text],
            rows: 12, placeholder: ::Reimbursements::ExpenseImport::TSV_HEADERS.join("\t"),
            file_name: :file, file_label: "…or upload an .xlsx", file_accept: ".xlsx",
            file_hint: "The first sheet's first row is read as the header. A file takes precedence " \
                       "over pasted text." %>
    </div>
  <% end %>
<% end %>
<% end %>
