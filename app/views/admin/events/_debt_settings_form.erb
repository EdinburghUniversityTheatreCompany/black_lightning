<p class="text-sm text-gray-600 mb-1">
    Configure the number of debts to assign to team members. Once configured, debts will be
    automatically created when team members are added to the <%= event.class.name.downcase %>. Saving these settings will
    also sync debts for all existing team members.
</p>
<p class="text-sm text-gray-600 mb-1">
    <span class="font-medium text-gray-700">Position rules:</span> Assistants (all roles must be assistant) get max 1 staffing debt.
    Welfare contacts (if their only role) get 0 staffing debts.
</p>

<% if event.debt_configuration_active? %>
    <p class="text-sm text-gray-500 mb-3">
        <span class="font-medium text-gray-700">Current configuration:</span>
        <%= event.maintenance_debt_amount.present? ? "#{event.maintenance_debt_amount} maintenance debt(s)" : "No maintenance debts" %>
        &bull;
        <%= event.staffing_debt_amount.present? ? "#{event.staffing_debt_amount} staffing debt(s)" : "No staffing debts" %>
    </p>
<% end %>

<% if event.tag_debt_recommendations.any? %>
    <%= render AlertComponent.new(type: :info) do %>
        <p class="text-xs font-semibold uppercase tracking-wide mb-1">Tag recommendations</p>
        <% event.tag_debt_recommendations.each do |rec| %>
            <p class="text-sm mb-0">
                Tag "<%= rec[:tag_name] %>":
                <span class="font-medium"><%= rec[:maintenance] || 0 %> maintenance, <%= rec[:staffing] || 0 %> staffing</span>
            </p>
        <% end %>
    <% end %>
<% end %>

<%= simple_horizontal_form_for event, url: polymorphic_path([:update_debt_settings, :admin, event]), method: :patch do |f| %>
    <%= f.error_notification %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <% { maintenance: Admin::MaintenanceDebt, staffing: Admin::StaffingDebt }.each do |kind, debt_class| %>
            <% next unless can?(:create, debt_class) %>
            <div class="rounded border border-gray-200 p-4">
                <p class="text-sm font-semibold text-gray-700 mb-3"><%= kind.to_s.titleize %> Debts</p>
                <%= f.input :"#{kind}_debt_amount", label: 'Amount per person', as: :integer, min: 0, max: 5,
                            hint: 'Leave blank or set to 0 to disable auto-creation' %>
                <%= f.input :"#{kind}_debt_start", as: :date, label: 'Due date',
                            default: ((event.end_date || Date.current) + 14) %>
            </div>
        <% end %>
    </div>

    <%= f.button :submit, value: 'Save Debt Settings', class: btn_classes(:primary) %>
<% end %>
