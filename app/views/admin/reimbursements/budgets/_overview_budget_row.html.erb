<%# locals: (budget:, name_area: true) %>
<%# name_area: false only where the AREA is already the heading above this row
    (_area_group). The nominal-code card groups by code, where three shows'
    "Marketing" lines sit under 432320 with nothing to tell them apart. %>
<tr>
  <td>
    <%= link_to (name_area ? budget.display_name : budget.name).presence || "-",
          edit_admin_reimbursements_budget_path(budget.record_id),
          class: "text-primary underline" %>
    <% unless budget.active %>
      <span class="text-gray-400 text-xs">(hidden)</span>
    <% end %>
  </td>
  <td><%= budget.budget_type %></td>
  <td class="text-right"><%= reimbursements_money(budget.initial_budget) %></td>
  <td class="text-right"><%= reimbursements_money(budget.projected_amount) %></td>
  <td class="text-right"><%= reimbursements_money(budget.committed_amount) %></td>
  <td class="text-right"><%= reimbursements_money(budget.pipeline_amount) %></td>
  <td class="text-right"><%= reimbursements_money(budget.paid_portal_amount) %></td>
  <td class="text-right"><%= reimbursements_money(budget.eusa_actual_amount) %></td>
  <td class="text-right"><%= reimbursements_money(budget.expected_outturn) %></td>
</tr>
