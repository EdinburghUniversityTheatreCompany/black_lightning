<%# locals: () %>
<%# Drop target and status line for the receipts-upload controller. The caller
    wraps this AND the gallery in the data-controller element, because the
    gallery's remove buttons dispatch to the same controller. %>
<div class="mb-3 rounded border-2 border-dashed border-gray-300 p-4 text-center"
     data-receipts-upload-target="zone"
     data-action="dragover->receipts-upload#dragover dragleave->receipts-upload#dragleave drop->receipts-upload#drop">
  <input type="file" multiple class="hidden" tabindex="-1" aria-hidden="true"
         accept="<%= Reimbursements::ExpenseForm::RECEIPT_ACCEPT_ATTRIBUTE %>"
         data-receipts-upload-target="input"
         data-action="change->receipts-upload#inputChanged">
  <div class="text-gray-600">
    <h3>
      Drag a receipt here, or
      <button type="button" class="font-medium underline" data-action="receipts-upload#pick">browse for a file</button>
    </h3>
    <span class="text-sm">PDF or photo, max 5&nbsp;MB. It's added straight away.</span>
  </div>
</div>
<p class="mb-2 text-sm text-gray-600" aria-live="polite" data-receipts-upload-target="status"></p>
