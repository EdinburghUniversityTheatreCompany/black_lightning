<p class="mb-3">
  <%= link_to "← All budgets", admin_reimbursements_budgets_path, class: "text-sm text-primary underline" %>
</p>

<p class="mb-3 text-gray-600">
  Every budget grouped by nominal code, with a subtotal per code and a grand total. Expected
  outturn is the greater of the current projection and what's already been spent or committed,
  so the number never drops below reality.
</p>

<%
  money = ->(amount) { reimbursements_money(amount) }
  expected_tip = "The greater of the current projection and what's already been spent or " \
                 "committed, so the number never drops below reality."
%>

<%= render CardComponent.new(title: "Budgets by nominal code", flush: true) do %>
  <div class="overflow-x-auto">
    <table class="table table-hover">
      <thead>
        <tr>
          <th scope="col">Budget</th>
          <th scope="col" class="text-right">Initial</th>
          <th scope="col" class="text-right">Projected</th>
          <th scope="col" class="text-right">Committed</th>
          <th scope="col" class="text-right">Pipeline</th>
          <th scope="col" class="text-right">Paid (portal)</th>
          <th scope="col" class="text-right">EUSA actual</th>
          <th scope="col" class="text-right" title="<%= expected_tip %>">Expected outturn</th>
        </tr>
      </thead>
      <% @rollups.each do |rollup| %>
        <tbody>
          <tr class="bg-gray-50">
            <th scope="rowgroup" colspan="8" class="text-left font-semibold py-2">
              Nominal code <%= rollup.code %>
            </th>
          </tr>
          <% rollup.budgets.sort_by { |b| b.name.to_s.downcase }.each do |budget| %>
            <tr>
              <td>
                <%= link_to budget.name.presence || "-",
                      edit_admin_reimbursements_budget_path(budget.record_id),
                      class: "text-primary underline" %>
                <% unless budget.active %>
                  <span class="text-gray-400 text-xs">(hidden)</span>
                <% end %>
              </td>
              <td class="text-right"><%= money.(budget.initial_budget) %></td>
              <td class="text-right"><%= money.(budget.projected_amount) %></td>
              <td class="text-right"><%= money.(budget.committed_amount) %></td>
              <td class="text-right"><%= money.(budget.pipeline_amount) %></td>
              <td class="text-right"><%= money.(budget.paid_portal_amount) %></td>
              <td class="text-right"><%= money.(budget.eusa_actual_amount) %></td>
              <td class="text-right"><%= money.(budget.expected_outturn) %></td>
            </tr>
          <% end %>
          <tr class="border-t border-gray-300 font-medium">
            <td class="text-right">Subtotal <%= rollup.code %></td>
            <td class="text-right"><%= money.(rollup.initial) %></td>
            <td class="text-right"><%= money.(rollup.projected) %></td>
            <td class="text-right"><%= money.(rollup.committed) %></td>
            <td class="text-right"><%= money.(rollup.pipeline) %></td>
            <td class="text-right"><%= money.(rollup.paid_portal) %></td>
            <td class="text-right"><%= money.(rollup.eusa_actual) %></td>
            <td class="text-right"><%= money.(rollup.expected) %></td>
          </tr>
        </tbody>
      <% end %>
      <tfoot>
        <tr class="border-t-2 border-gray-400 font-semibold">
          <td class="text-right">Grand total</td>
          <td class="text-right"><%= money.(@grand_total.initial) %></td>
          <td class="text-right"><%= money.(@grand_total.projected) %></td>
          <td class="text-right"><%= money.(@grand_total.committed) %></td>
          <td class="text-right"><%= money.(@grand_total.pipeline) %></td>
          <td class="text-right"><%= money.(@grand_total.paid_portal) %></td>
          <td class="text-right"><%= money.(@grand_total.eusa_actual) %></td>
          <td class="text-right"><%= money.(@grand_total.expected) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>

<%= render CardComponent.new(title: "Unbudgeted spend", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-3">
    EUSA ledger rows booked against a nominal code that has no budget. These are real spend
    no one planned for — give each a budget on the Budgets page so it stops showing here.
  </p>

  <% if @unbudgeted_actuals.empty? %>
    <p class="py-2 text-center text-gray-600">No unbudgeted spend — every actual matches a budget.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-gray-200">
            <th scope="col" class="py-2 pr-3">Nominal code</th>
            <th scope="col" class="py-2 pr-3">Date</th>
            <th scope="col" class="py-2 pr-3">Narrative</th>
            <th scope="col" class="py-2 pr-3">Type</th>
            <th scope="col" class="py-2 text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @unbudgeted_actuals.each do |actual| %>
            <% debit = actual.debit&.positive? %>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-3 whitespace-nowrap"><%= actual.nominal_code.presence || "-" %></td>
              <td class="py-2 pr-3 whitespace-nowrap"><%= reimbursements_date(actual.date) %></td>
              <td class="py-2 pr-3"><%= actual.narrative.presence || "-" %></td>
              <td class="py-2 pr-3"><%= debit ? "Debit" : (actual.credit&.positive? ? "Credit" : "-") %></td>
              <td class="py-2 text-right"><%= reimbursements_money(debit ? actual.debit : actual.credit) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
