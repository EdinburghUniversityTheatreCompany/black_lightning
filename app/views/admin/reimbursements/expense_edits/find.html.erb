<p class="mb-3 text-gray-600">
  Enter an expense number (the # on the card) or a record id, or browse
  <%= link_to "all expenses", admin_reimbursements_expense_edits_path, class: "text-primary underline" %>.
</p>

<%= form_with url: find_admin_reimbursements_expense_edits_path, method: :get,
              class: "flex flex-wrap items-end gap-2" do %>
  <div>
    <%= label_tag :q, "Expense number or record id", class: FormStyles::LABEL %>
    <%= text_field_tag :q, params[:q], placeholder: "e.g. 42",
                       class: input_classes(width: "w-64") %>
  </div>
  <%= submit_tag "Find", class: btn_classes(:primary, :sm) %>
<% end %>
