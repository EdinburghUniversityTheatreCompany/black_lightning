<%= render "shared/back_link", text: "All actuals", path: actuals_path_with_filters %>

<p class="mb-3 text-gray-600">
  Attach this EUSA row to a claim the automatic matcher missed. The matcher only links a row it is
  sure about, so anything it left alone ends up here. Linking marks the claim
  <strong>Paid</strong> on the row's date, exactly as a reconcile run would, and nobody is emailed.
</p>

<%= render "row_summary", actual: @actual, title: "The EUSA row", amount_label: "Amount",
                          amount: reimbursements_money(@actual.debit) %>

<% if @candidates.empty? %>
  <%= render CardComponent.new(title: "Which claim did this pay?") do %>
    <p class="mb-0 text-gray-600">
      No claim here can be settled by this row. Paid claims are settled already, and drafts and
      rejected claims are never offered. So this row is income, someone else's, or a cost nobody
      claimed - in which case
      <%= link_to "create an expense from it", new_expense_admin_reimbursements_actual_path(@actual.record_id, actual_filters) %>
      instead.
    </p>
  <% end %>
<% else %>
  <%# form_with wraps the card, never the reverse: the footer is a component slot, so a form opened
      inside the card puts the submit button outside the <form>. %>
  <%= form_with url: confirm_link_admin_reimbursements_actual_path(@actual.record_id, actual_filters),
                method: :post do |f| %>
    <%= render CardComponent.new(title: "Which claim did this pay?") do |card| %>
      <p class="mb-3 text-sm text-gray-600">
        A claim whose payee the row's narrative names comes first; after that, closest amount.
        Draft and rejected claims are not offered: settling one would mark paid something
        nobody agreed to pay. An <strong>international</strong> claim's amount is only the
        estimate finance typed at review, so it will not match the row exactly; linking it
        corrects the claim to what EUSA actually charged.
      </p>

      <div class="space-y-1">
        <% @candidates.each do |expense| %>
          <label class="flex items-start gap-3 rounded border border-gray-200 p-2 hover:bg-gray-50">
            <%= f.radio_button :expense_id, expense.record_id, class: "mt-1" %>
            <span class="text-sm">
              <span class="font-medium">#<%= expense.auto_number %></span>
              <%= expense.person&.name.presence || "(no payee)" %>
              <span class="font-medium"><%= reimbursements_money(expense.amount) %></span>
              <% if expense.international? %>
                <%= render BadgeComponent.new(type: :info, pill: true).with_content("International") %>
                <span class="text-gray-500">invoice <%= reimbursements_payment_amount(expense) %></span>
              <% end %>
              <%= render BadgeComponent.new(
                    type: Reimbursements::Status.badge_variant(expense.status), pill: true
                  ).with_content(expense.status) %>
              <span class="block text-gray-600">
                <%= expense.budget&.display_name.presence || "(no budget)" %>
                <%# The claim's pot: a row belongs to one centre, so a candidate from the other is almost
                    certainly wrong. %>
                <% if (centre = @cost_centres_by_id[expense.budget&.cost_centre_id]) %>
                  <span class="text-gray-500">(<%= centre.name %>)</span>
                <% end %>
                <%= "- #{expense.description}" if expense.description.present? %>
              </span>
            </span>
          </label>
        <% end %>
      </div>

      <% card.with_footer do %>
        <%= render "shared/form/actions", submit: "Link and mark Paid", cancel_path: actuals_path_with_filters %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
