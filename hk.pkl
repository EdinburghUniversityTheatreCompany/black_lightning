// dev-env standard (dev-hooks:dev-env-setup); version tracked via DEV_ENV_VERSION in mise/config.toml.
amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["rubocop"] {
        glob = "**/*.rb"
        check = "rubocop"
        fix = "rubocop -A"
    }
    // --- JavaScript (eslint) ----------------------------------------------------
    // Stimulus controllers + custom lib modules (this is a Vite app — JS lives in
    // app/javascript, see CLAUDE.md). Mirrors the `pnpm lint` script and CI's lint_js job;
    // preserves the JS coverage the old overcommit EsLint hook provided.
    ["eslint"] {
        glob = List("app/javascript/controllers/**/*.js", "app/javascript/lib/**/*.js")
        check = "pnpm exec eslint app/javascript/controllers app/javascript/lib"
        fix = "pnpm exec eslint --fix app/javascript/controllers app/javascript/lib"
    }
    // --- ERB linting (herb) -----------------------------------------------------
    // `analyze` is pure libherb (parse errors, no network); `lint` runs @herb-tools/linter through
    // npx (needs `node`, see mise/config.toml) and reads `.herb.yml`. The version is pinned here and
    // in ci.yml, so bump both together: `bundle exec herb lint` runs an unpinned npx, and 0.11.0's
    // new html-no-duplicate-ids findings turned CI red on 2026-09-25.
    // herb-analyze is advisory (`|| true`) only because shared/mail/_header and _footer are
    // intentional HTML-email fragments no per-file parser can validate, and `herb analyze` has no
    // exclude flag (.herb.yml excludes them from herb-lint, whose `parser-no-errors` rule gates the rest).
    ["herb-analyze"] {
        glob = "**/*.erb"
        check = "bundle exec herb analyze app/ || true"
    }
    ["herb-lint"] {
        glob = "**/*.erb"
        check = "npx --yes @herb-tools/linter@0.10.4 app/"
        fix = "npx --yes @herb-tools/linter@0.10.4 app/ --fix"
    }
    // --- Schema annotations (annotaterb, auto-regenerate) -----------------------
    // Custom step: regenerate the `# == Schema Information` blocks on models when a model or
    // the schema is committed. annotaterb reads columns from the DB connection, so probe first
    // and skip cleanly (exit 0) when no dev/test DB is reachable, so a fresh worktree never blocks
    // a commit. `fix`-only (no `check`): it runs on pre-commit/`fix`, never as a CI gate that
    // would rewrite files in CI. annotaterb rewrites all models; with pre-commit's stash="git"
    // the staged model(s) get re-staged, and pre-existing drift elsewhere surfaces as unstaged
    // changes. Keep loop-free: hk's internal `sh` aborts on `while read` inside `$(...)`.
    ["annotate-models"] {
        glob = List("db/schema.rb", "app/models/**/*.rb")
        fix = "if rails runner \"ActiveRecord::Base.connection\" >/dev/null 2>&1; then bundle exec annotaterb models; else echo 'annotaterb: no DB reachable, skipping'; fi"
    }
    // Versions are pinned in several files (mise/config.toml for local dev, .ruby-version and
    // .node-version for CI, Dockerfile ARGs for the image, `image:` tags for the services) and
    // nothing makes them agree, so a bump that misses one file is silent. The script checks the
    // files that exist and prints what it skipped; CI's `versions` job runs it too. Extend the
    // glob if a version is pinned somewhere else.
    ["versions"] {
        glob = List("mise/config.toml", ".ruby-version", ".node-version", "Dockerfile", "package.json", "config/deploy.yml", ".devcontainer/compose.yaml", ".github/workflows/*.yml")
        check = "bash scripts/check_version_sync.sh"
    }
    // The Dockerfile derives the Node major at build time (`setup_$(cut -d. -f1 < .node-version)`),
    // so the `versions` gate has no static pin to compare. This keeps it that way: no hardcoded
    // major, no `ARG NODE_VERSION`.
    ["dockerfile-node-style"] {
        glob = List("Dockerfile", ".node-version")
        check = "fail=0; grep -qF 'setup_$(cut -d. -f1 < .node-version)' Dockerfile || { echo 'prod Dockerfile must derive the Node major from .node-version, not hardcode it'; fail=1; }; ! grep -q '^ARG NODE_VERSION=' Dockerfile || { echo 'remove hardcoded ARG NODE_VERSION from Dockerfile; derive it from .node-version'; fail=1; }; exit $fail"
    }
    // A shebang script must be mode 100755 in the git index: with core.fileMode=false a local
    // chmod +x never reaches git, and clones get binstubs that die with exit 126. One awk on
    // purpose: hk's internal `sh` dies on a while/read loop inside $(), even when it exits 0.
    ["exec-bit-scripts"] {
        check = "bad=$(git ls-files -s | awk -F'\\t' '$1 ~ /^100644/ { if ((getline line < $2) > 0 && line ~ /^#!/) print $2; close($2) }'); if [ -n \"$bad\" ]; then echo 'Shebang scripts missing the executable bit in the git index. Fix: git update-index --chmod=+x <file>'; echo \"$bad\"; exit 1; fi"
    }
    // --- Audits (dead-code + duplication) ---------------------------------------
    // flay (Ruby structural, advisory, finds renamed clones) and jscpd (token-based, polyglot, the
    // enforcing gate) complement each other; debride finds dead methods. jscpd runs via npx (needs
    // `node`, see mise/config.toml) and reads `.jscpd.json`.
    ["debride"] {
        glob = "**/*.rb"
        // Exclude vendor (CI's bundler-cache lands gems in vendor/bundle), or debride reports every
        // gem as dead code.
        check = "bundle exec debride --exclude vendor,node_modules,tmp,log ."
    }
    ["flay"] {
        glob = "**/*.rb"
        check = "bundle exec flay ."
    }
    // `-f` scopes to code formats (no config equivalent) so docs/configs aren't flagged. The
    // version-cooldown policy and offline fallback live in scripts/run-jscpd.sh, shared with CI.
    ["jscpd"] {
        glob = List("**/*.rb", "**/*.erb", "**/*.js", "**/*.css", "**/*.scss")
        check = "bash scripts/run-jscpd.sh ruby,erb,javascript,typescript,css,scss,sass,vue"
    }
    // --- Security + correctness -------------------------------------------------
    // bundler-audit: `update` refreshes the advisory DB when online (swallowed offline), then
    // `check` gates. importmap-audit skips here (this Vite app has no bin/importmap). fasterer is
    // advisory (exits non-zero on offenses, hence `|| true`). database_consistency needs a
    // reachable DB, so a `rails runner` probe skips it (exit 0) when none is up. Keep every
    // command loop-free: hk's internal `sh` aborts on `while read` inside `$(...)`.
    ["brakeman"] {
        glob = "**/*.rb"
        check = "bundle exec brakeman -q --no-pager --exit-on-warn"
    }
    ["bundler-audit"] {
        glob = "**/Gemfile.lock"
        check = "bundle exec bundle-audit update >/dev/null 2>&1 || true; bundle exec bundle-audit check"
    }
    ["importmap-audit"] {
        glob = "**/importmap.rb"
        check = "if [ -f bin/importmap ]; then bin/importmap audit; else echo 'no bin/importmap — skipping'; fi"
    }
    ["fasterer"] {
        glob = "**/*.rb"
        check = "bundle exec fasterer || true"
    }
    // ADVISORY (|| true): ~330 schema findings (NOT NULL, length, unique-index, FK) that need
    // data-aware migrations on the legacy DB; drop `|| true` to gate.
    ["database_consistency"] {
        glob = List("db/schema.rb", "db/structure.sql", "app/models/**/*.rb")
        check = "if bin/rails runner \"ActiveRecord::Base.connection\" >/dev/null 2>&1; then bundle exec database_consistency || true; else echo 'database_consistency: no DB reachable, skipping'; fi"
    }
    // -shellcheck= is deliberate: run: blocks word-split on purpose ($files), and real *.sh files
    // are covered elsewhere.
    ["actionlint"] = (Builtins.actionlint) {
        check = "actionlint -shellcheck= {{ files }}"
    }
    // Workflow security: credential persistence, template injection, token scope.
    ["zizmor"] = Builtins.zizmor
    ["gitleaks"] = Builtins.gitleaks
    ["check-added-large-files"] = Builtins.check_added_large_files
}

// `check` is the linters plus the full test suite. The test step stays out of `linters` so
// pre-commit skips it: the suite takes several minutes, and CI's `test` job runs it anyway.
// Run it locally with `hk run check` or `bin/rails test`.
local checkSteps: Mapping<String, Step> = (linters) {
    ["test"] {
        glob = "**/*.rb"
        check = "rails test"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = checkSteps
    }
}
