<p>Hi,</p>

<p>
  You built a batch of <strong><%= pluralize(@expenses.size, "approved expense") %></strong>
  for BACS date <strong><%= @run_date %></strong>.
</p>

<p>The EUSA draft email has been created in the send mailbox. Please review and send it:</p>

<% if @draft_link.present? %>
  <p style="margin: 1.5em 0;">
    <a href="<%= @draft_link %>" style="background-color: #0078d4; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-family: sans-serif;">Open draft in Outlook</a>
  </p>
<% end %>

<p><strong><%= link_to "Batch summary", admin_reimbursements_batch_url(@batch_id) %>:</strong></p>
<%= render "reimbursements/emails/claims_table", expenses: @expenses, total: @total %>

<% if @errors.blank? %>
  <p>Producer notification emails have also been sent to payees.</p>
<% else %>
  <div>
    <p><strong>Note:</strong> the EUSA draft above is valid and ready to send, but one or more
    other steps hit a problem. Please check before assuming everything else completed
    (e.g. a producer notification email, a SharePoint receipt backup, or a batch flag):</p>
    <ul>
      <% @errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<p>Best,<br><%= @cost_centre.automated_sign_off %></p>
