<%# locals: (index:, share:, budgets:) %>
<%# One share of a split credit. Extracted so the rows already on the form and
    the <template> "Add another share" clones are ONE definition: a template
    that had drifted from the live rows would post a share the server reads
    differently from the ones beside it.

    +index+ is a string, not a number: the clone's is the timestamp
    nested-form substitutes for NEW_RECORD. #submitted_shares reads
    params[:shares].values, so the keys never have to be 0..n. %>
<div class="flex flex-wrap items-end gap-3">
  <%= render "shared/form/field", label: "Budget", name: "shares[#{index}][budget_id]",
        id: "share_#{index}_budget_id", html_class: "grow max-w-lg" do %>
    <%# Only `simple-select2`: Tom Select copies the select's classes
        onto its own wrapper, which already draws the box. %>
    <%= select_tag "shares[#{index}][budget_id]",
          options_for_select(budgets.map { |b| [ b.display_name, b.record_id ] },
                             share[:budget_id]),
          id: "share_#{index}_budget_id", class: "simple-select2",
          include_blank: "No budget" %>
  <% end %>
  <%= render "shared/form/field", label: "Share (£)", name: "shares[#{index}][amount]",
        id: "share_#{index}_amount", html_class: "w-44" do %>
    <%= text_field_tag "shares[#{index}][amount]", share[:amount_typed],
          id: "share_#{index}_amount", inputmode: "decimal",
          autocomplete: "off", class: input_classes,
          data: { apportion_total_target: "amount",
                  action: "input->apportion-total#recalculate" } %>
  <% end %>
</div>
