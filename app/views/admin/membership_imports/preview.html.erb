<%= render Admin::ImportPreviewComponent.new(total: @import.rows.size, cancel_path: new_admin_membership_import_path, confirm_path: confirm_admin_membership_imports_path, cache_key: @cache_key) do %>
  <%= render Admin::ImportPreviewSectionComponent.new(items: @import.categorized[:activate_by_email], title: "Activate by Email Match", variant: :info, hint: "Will be activated automatically", headers: [ "Import Name", "Existing User", "Email Match", "Action" ]) do |section| %>
    <% section.items.each do |item| %>
      <%= render Admin::ImportExactMatchRowComponent.new(item:, value: item[:row][:email], action: "activate", badge: "Will Activate", badge_type: :info, show_row_id: true) do %>
        <% if item[:existing_user].student_id.blank? && item[:row][:student_id].present? %>
          <br><small class="text-success">+ will add student ID</small>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Admin::ImportPossibleMatchesComponent.new(items: @import.categorized[:propose_merge], years_active: @import.years_active_cache, choice: "merge", choice_label_prefix: "Merge with ", create_label: "Create New", show_blank_email: true) %>

  <%= render Admin::ImportNewUsersComponent.new(items: @import.categorized[:create_new], hint: "Will create and activate", create_label: "Create & Activate", note_generated_email: false) %>

  <%= render Admin::ImportPreviewSectionComponent.new(items: @import.categorized[:already_active], title: "Already Active Members", variant: :secondary, hint: "No action needed", headers: [ "Import Name", "Existing User", "ID", "Status" ]) do |section| %>
    <% section.items.each do |item| %>
      <%= render Admin::ImportExactMatchRowComponent.new(item:, value: import_match_label(item), badge: "Already Member", badge_type: :success, row_class: "table-secondary") %>
    <% end %>
  <% end %>

  <%= render Admin::ImportPreviewSectionComponent.new(items: @import.categorized[:activate_by_id], title: "Activate by ID", variant: :info, hint: "Will be activated automatically", headers: [ "Import Name", "Existing User", "ID Match", "Action" ]) do |section| %>
    <% section.items.each do |item| %>
      <%= render Admin::ImportExactMatchRowComponent.new(item:, value: import_match_label(item), action: "activate", badge: "Will Activate", badge_type: :info) do %>
        <br><small class="text-gray-500"><%= item[:existing_user].email %></small>
      <% end %>
    <% end %>
  <% end %>
<% end %>
