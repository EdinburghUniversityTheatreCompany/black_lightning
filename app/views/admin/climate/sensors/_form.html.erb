<%# locals: (submit_label:, title:, intro:) %>
<%# The card sits inside the form so the footer's Save and Cancel stay inside it. %>
<%= simple_form_for [:admin, @sensor] do |f| %>
  <%= render CardComponent.new(title: title) do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: submit_label, cancel_path: admin_climate_sensors_path %>
    <% end %>

    <%= f.error_notification %>
    <%= intro %>

    <%= f.input :display_name, label: "Name",
                hint: "What it is called on the dashboard and in the import picker." %>
    <%= f.input :location, label: "Location",
                hint: "Where in the building it sits, e.g. \"Crypt, north wall\"." %>
    <%= f.input :position, label: "Order", hint: "Lower numbers appear first on the dashboard." %>
    <%= f.input :active, as: :boolean, label: "Active", wrapper_html: { class: ("mb-0" if @sensor.outdoor?) },
                hint: "Inactive sensors keep their readings but are left off the dashboard." %>
    <% unless @sensor.outdoor? %>
      <%= f.input :in_crypt, as: :boolean, label: "In the crypt", wrapper_html: { class: "mb-0" },
                  hint: "Include this sensor in the condensation-risk and ventilation charts." %>
    <% end %>
  <% end %>
<% end %>
