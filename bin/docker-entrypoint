#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database.
#
# Matched on the BASENAME, because the command is spelled differently depending on
# whether /rails/bin is on PATH: the Dockerfile's CMD was "./bin/rails server" and
# is now "rails server". An exact-string test silently stopped matching when that
# changed, so db:prepare stopped running and every deploy after it shipped code
# against an un-migrated database — which surfaces as NoMethodError on the new
# column, nowhere near the cause.
last_arg="${@: -1:1}"
second_last_arg="${@: -2:1}"
if [ "$last_arg" == "server" ] && [ "$(basename "$second_last_arg")" == "rails" ]; then
  rails db:prepare
fi

exec "${@}"
