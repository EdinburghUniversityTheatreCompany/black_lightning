<% show_remove = current_user.can?(:remove_user, @group) %>
<% remove_url_lambda = ->(user_id) { remove_user_admin_group_path(@group, user_id) } %>

<%= turbo_stream.replace dom_id(@group, :users) do %>
  <div id="<%= dom_id(@group, :users) %>">
    <%= render(UsersTableComponent.new(users: @users, url: admin_group_url(@group), q: @q,
      show_remove_buttons: show_remove, remove_url_helper: remove_url_lambda)) %>
  </div>
<% end %>

<% if flash[:success].present? %>
  <turbo-stream action="toast" type="success" message="<%= j flash[:success].first %>"></turbo-stream>
  <% flash.discard(:success) %><%# herb:disable erb-no-unused-expressions %>
<% end %>
<% if flash[:error].present? %>
  <turbo-stream action="toast" type="error" message="<%= j flash[:error].first %>"></turbo-stream>
  <% flash.discard(:error) %><%# herb:disable erb-no-unused-expressions %>
<% end %>
