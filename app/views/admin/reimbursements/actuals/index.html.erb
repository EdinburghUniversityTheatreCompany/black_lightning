<%= render "admin/reimbursements/shared/cost_centre_selector" %>
<p class="mb-3 text-gray-600">
  The EUSA ledger, imported on the
  <%= link_to "Reconcile", admin_reimbursements_reconciliation_path, class: "underline" %> page.
  Opens on the rows a reconcile could not place; an unlinked debit can become a From-EUSA
  expense here.
  <%= link_to "What the words mean", admin_reimbursements_glossary_path, class: "underline" %>.
</p>

<%
  # Every filter the page is on, so a row's Remove split / Not offsetting
  # button comes back to the list the operator was reading rather than to an
  # unfiltered first page. Built once here, since four controls need it.
  filters = { period: @period.presence, search: @search.presence, state: @state,
              include_offsets: (@include_offsets ? "1" : nil) }.compact
  attention_state = ::Admin::Reimbursements::ActualsController::STATE_NEEDS_ATTENTION
  needs_attention = @state == attention_state
  all_state = ::Admin::Reimbursements::ActualsController::STATE_ALL
%>

<%= render CardComponent.new(title: "Filter") do %>
  <%= form_with url: admin_reimbursements_actuals_path, method: :get, class: "flex flex-wrap items-end gap-3" do %>
    <div>
      <%= label_tag :state, "Show", class: FormStyles::LABEL %>
      <%= select_tag :state,
                     options_for_select([ [ "Rows needing attention", attention_state ],
                                          [ "All rows", all_state ] ], @state),
                     class: input_classes(width: "w-56") %>
    </div>
    <% if @periods.any? %>
      <div>
        <%= label_tag :period, "EUSA period", class: FormStyles::LABEL %>
        <%= select_tag :period,
                       options_for_select([ [ "All periods", "" ] ] + @periods.map { |p| [ p, p ] }, @period),
                       class: input_classes(width: "w-44") %>
      </div>
    <% end %>
    <div>
      <%= label_tag :search, "Search", class: FormStyles::LABEL %>
      <%= search_field_tag :search, @search, placeholder: "Narrative, ref or amount",
                           class: input_classes(width: "w-64") %>
    </div>
    <%# Full ledger only: an offset leg never needs attention. %>
    <% unless needs_attention %>
      <div class="flex items-center gap-2 pb-1">
        <%= check_box_tag :include_offsets, "1", @include_offsets, class: "h-4 w-4" %>
        <%= label_tag :include_offsets, "Show offsetting rows", class: "text-sm" %>
      </div>
    <% end %>
    <%= submit_tag "Apply filter", class: btn_classes(:secondary, :sm) %>
    <% if @period.present? || @search.present? || @include_offsets || !needs_attention %>
      <%= link_to "Clear", admin_reimbursements_actuals_path, class: "text-sm text-gray-600 underline" %>
    <% end %>
  <% end %>
<% end %>

<div class="my-2 flex flex-wrap items-center justify-between gap-3">
  <p class="mb-0 text-sm text-gray-600">
    <%# Outside the branch: herb-lint flags a tag repeated across every branch. %>
    <strong><%= pluralize(needs_attention ? @needs_attention_count : @actuals.total_count, "row") %></strong>
    <% if needs_attention %>
      <%= @needs_attention_count == 1 ? "needs" : "need" %> attention
      <%= "of #{pluralize(@matching_count, 'row')} here" if @matching_count != @needs_attention_count %><%= " (period #{@period})" if @period.present? %>.
      A row attached to a claim or a budget is finished with, and is left out.
    <% else %>
      shown<%= " (period #{@period})" if @period.present? %>,
      <%= @needs_attention_count %> of them needing attention.
    <% end %>
  </p>
  <div class="flex flex-wrap items-center gap-2">
    <% if needs_attention %>
      <%= link_to "Show all rows",
                  admin_reimbursements_actuals_path(filters.merge(state: all_state)),
                  class: btn_classes(:secondary, :sm) %>
    <% else %>
      <%= link_to "Show only rows needing attention",
                  admin_reimbursements_actuals_path(filters.except(:include_offsets).merge(state: attention_state)),
                  class: btn_classes(:secondary, :sm) %>
    <% end %>
    <%= link_to "Download CSV",
                admin_reimbursements_actuals_path(request.query_parameters.merge(format: :csv)),
                class: btn_classes(:secondary, :sm) %>
  </div>
</div>

<%# Hidden-offsets sentence: the only route to "Not offsetting" from the default view. %>
<% if @offset_count.positive? && !@include_offsets %>
  <p class="mb-2 text-sm text-gray-600">
    <%= pluralize(@offset_count, "row") %> cancel out against a counterpart
    <%= @offset_count == 1 ? "and is" : "and are" %> hidden.
    <%= link_to "Show them on the full ledger",
                admin_reimbursements_actuals_path(filters.merge(state: all_state, include_offsets: "1")),
                class: "text-primary underline" %>,
    where a pairing proposed in error can be undone.
  </p>
<% end %>

<% if @actuals.total_count.zero? %>
  <%= render CardComponent.new(title: @title) do %>
    <p class="py-4 text-center text-gray-600">
      <% if needs_attention && @matching_count.positive? %>
        Nothing here needs attention: every row is attached to a claim or a budget.
        <%= link_to "Show all rows",
                    admin_reimbursements_actuals_path(filters.merge(state: all_state)),
                    class: "text-primary underline" %>.
      <% elsif @period.present? || @search.present? %>
        No rows match these filters.
      <% else %>
        No EUSA Actuals imported yet.
      <% end %>
    </p>
  <% end %>
<% else %>
  <% headers = [ "Nominal", "Period", "Date", "Narrative", "Debit", "Credit", "Linked to", "" ] %>
  <% field_sets = @actuals.map do |actual|
       linked =
         if actual.offset?
           render(BadgeComponent.new(type: :warning, pill: true).with_content("Offset"))
         elsif actual.expense_id?
           link_to(edit_admin_reimbursements_expense_edit_path(actual.expense_id), class: "no-underline") do
             render(BadgeComponent.new(type: :primary, pill: true).with_content("Expense"))
           end
         elsif actual.apportioned?
           # Name the lines and shares: "Split" alone is only the state the row is in.
           safe_join([
             render(BadgeComponent.new(type: :info, pill: true).with_content("Split")),
             content_tag(:span, actual.allocation_summary,
                         class: "block text-xs text-gray-600")
           ], " ")
         elsif actual.budget_id?
           render(BadgeComponent.new(type: :info, pill: true).with_content("Budget"))
         else
           render(BadgeComponent.new(type: :secondary, pill: true).with_content("Unlinked"))
         end
       {
         fields: [
           actual,
           content_tag(:span, actual.nominal_code.presence || "-", class: "font-mono"),
           content_tag(:span, actual.period.presence || "-", class: "font-mono"),
           # nowrap: an ISO date wrapping after the month reads as two dates.
           content_tag(:span, reimbursements_date(actual.date), class: "whitespace-nowrap"),
           actual.narrative.presence || "-",
           (reimbursements_money(actual.debit) if actual.debit&.positive?),
           (reimbursements_money(actual.credit) if actual.credit&.positive?),
           linked,
           safe_join([ (if actual.convertible_to_expense?
              safe_join([
                link_to("Link to claim",
                        link_expense_admin_reimbursements_actual_path(actual.record_id),
                        class: btn_classes(:secondary, :sm)),
                link_to("Create expense",
                        new_expense_admin_reimbursements_actual_path(actual.record_id),
                        class: btn_classes(:secondary, :sm))
              ], " ")
            elsif actual.apportionable?
              link_to("Split across budgets",
                      apportion_admin_reimbursements_actual_path(actual.record_id),
                      class: btn_classes(:secondary, :sm))
            elsif actual.apportioned?
              button_to("Remove split",
                        remove_apportionment_admin_reimbursements_actual_path(
                          actual.record_id, **filters
                        ),
                        class: btn_classes(:secondary, :sm), form_class: "inline-block",
                        data: { turbo_confirm: "Undo this split? The row goes back to being an " \
                                               "unplaced credit and each budget loses its share." })
            elsif actual.offset?
              # A wrong pair hides real spend from every rollup, so it must stay undoable.
              button_to("Not offsetting",
                        unoffset_admin_reimbursements_actual_path(
                          actual.record_id, **filters
                        ),
                        class: btn_classes(:secondary, :sm), form_class: "inline-block",
                        data: { turbo_confirm: "Treat these two rows as real spend or income " \
                                               "again? Both stay on the ledger." })
            end),
           # Additive: a row needing attention gets its main action AND this.
           (if actual.pairable?
              link_to("Mark as offsetting",
                      offset_pair_admin_reimbursements_actual_path(actual.record_id),
                      class: btn_classes(:secondary, :sm))
            end),
           # Additive, not an elsif: a budget-linked debit is still convertible, and a linked
           # offset leg must keep "Not offsetting".
           (if actual.expense_id? || actual.budget_id?
              button_to("Unlink",
                        unlink_admin_reimbursements_actual_path(actual.record_id, **filters),
                        class: btn_classes(:secondary, :sm), form_class: "inline-block",
                        data: { turbo_confirm: reimbursements_unlink_confirm(actual) })
            end) ].compact, " ")
         ]
       }
     end %>
  <%= render "shared/pages/index_results",
        resources: @actuals, resource_class: ::Reimbursements::EusaActual,
        headers: headers, field_sets: field_sets,
        include_edit_button: false, include_link_to_item: false, include_pagination: true %>
<% end %>
