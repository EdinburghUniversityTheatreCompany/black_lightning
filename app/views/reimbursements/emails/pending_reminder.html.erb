<p>Hi,</p>

<p>
  The nightly check ran on <strong><%= @run_date %></strong> and found
  <%= @rows.size %> <%= "submission".pluralize(@rows.size) %> that
  <%= @rows.size == 1 ? "has" : "have" %> been <strong>waiting for approval</strong>
  for more than <%= @threshold_days %> days. Nothing can be batched or paid until
  someone approves (or rejects) them on the
  <%= link_to "Review page", admin_reimbursements_review_url(tab: "to_approve", cost_centre: @cost_centre.key) %>.
</p>

<table border="1" cellspacing="0" cellpadding="4" style="border-collapse: collapse; font-family: sans-serif; margin-bottom: 1em;">
  <thead style="background-color: #f0f0f0;">
    <tr>
      <th scope="col">#</th><th scope="col">Payee</th><th scope="col">Amount</th><th scope="col">Waiting</th>
    </tr>
  </thead>
  <tbody>
    <% @rows.each do |row| %>
      <tr>
        <td><%= link_to "##{row[:auto_number]}", edit_admin_reimbursements_expense_edit_url(row[:record_id]) %></td>
        <td><%= row[:payee_name] %></td>
        <td><%= reimbursements_money(row[:amount]) %></td>
        <td><%= row[:age_days] %> <%= "day".pluralize(row[:age_days]) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>Best,<br><%= @cost_centre.automated_sign_off %></p>
