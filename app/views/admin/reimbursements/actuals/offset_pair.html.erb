<%= render "shared/back_link", text: "All actuals", path: admin_reimbursements_actuals_path %>

<p class="mb-3 text-gray-600">
  Record a pair the reconcile wizard did not propose, or re-pair two rows after
  <strong>Not offsetting</strong>. Both rows stay on the ledger and stop counting as spend or
  income. Nobody is emailed.
</p>

<% is_debit = @actual.debit&.positive? %>
<%= render "row_summary", actual: @actual, title: "The row you are pairing", amount_label: "Amount",
                          amount: "#{reimbursements_money(is_debit ? @actual.debit : @actual.credit)} #{is_debit ? 'debit' : 'credit'}" %>

<% if @candidates.empty? %>
  <%= render CardComponent.new(title: "Which row does it cancel out?", html_class: "mt-4") do %>
    <p class="mb-0 text-gray-600">
      <%# Naming the four gates lets the operator tell "nothing matches" from "wrong place". %>
      Nothing on the ledger can cancel this row out. A counterpart has to be the same amount on
      the opposite side, on the same nominal code, in the same financial year and the same cost
      centre, and be attached to nothing itself.
    </p>
  <% end %>
<% else %>
  <%# form_with wraps the card, never the reverse: the footer is a component slot, so a form opened
      inside the card puts the submit button outside the <form>. %>
  <%= form_with url: confirm_offset_admin_reimbursements_actual_path(@actual.record_id),
                method: :post do |f| %>
    <%= render CardComponent.new(title: "Which row does it cancel out?", html_class: "mt-4") do |card| %>
      <p class="mb-3 text-sm text-gray-600">
        Same amount, opposite side, same nominal code, same financial year and cost centre, and
        attached to nothing itself. Nothing here is ranked by how likely it is, unlike the
        automatic matcher, so check the date and the narrative before choosing.
      </p>

      <div class="space-y-1">
        <% @candidates.each do |candidate| %>
          <label class="flex items-start gap-3 rounded border border-gray-200 p-2 hover:bg-gray-50">
            <%= f.radio_button :counterpart_id, candidate.record_id, class: "mt-1" %>
            <span class="text-sm">
              <span class="font-medium">
                <%= reimbursements_money(candidate.debit&.positive? ? candidate.debit : candidate.credit) %>
                <%= candidate.debit&.positive? ? "debit" : "credit" %>
              </span>
              <span class="text-gray-600"><%= reimbursements_date(candidate.date) %></span>
              <span class="font-mono text-gray-600"><%= candidate.period.presence || "-" %></span>
              <% if candidate.ref.present? && candidate.ref == @actual.ref %>
                <%# The strongest signal the matcher scores on, so worth marking though nothing is ranked. %>
                <%= render BadgeComponent.new(type: :success, pill: true).with_content("Same reference") %>
              <% end %>
              <span class="block text-gray-600">
                <%= candidate.narrative.presence || "(no narrative)" %>
                <% if candidate.ref.present? %>
                  <span class="font-mono text-gray-500">· <%= candidate.ref %></span>
                <% end %>
              </span>
            </span>
          </label>
        <% end %>
      </div>

      <% card.with_footer do %>
        <%= render "shared/form/actions", submit: "Mark these two as offsetting",
                                          cancel_path: admin_reimbursements_actuals_path,
                                          note: 'Both rows stay on the ledger and stop counting as spend or income. "Not offsetting" on either one undoes it.' %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
