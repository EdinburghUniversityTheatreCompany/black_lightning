<%#
  Locals: messages, the split, blank-free strings.
  Past INLINE_FAILURE_MESSAGES the list collapses behind a disclosure: one
  batch's per-receipt failures (about 5,000 characters) pushed the batch list
  off screen for the seven days the attempt row lives.
%>
<% list = capture do %>
  <ul class="list-disc list-inside mt-1">
    <% messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>
<% if messages.size <= Admin::Reimbursements::BatchesController::INLINE_FAILURE_MESSAGES %>
  <%= list %>
<% else %>
  <details class="mt-1">
    <summary class="cursor-pointer underline">Show all <%= messages.size %> messages</summary>
    <%= list %>
  </details>
<% end %>
