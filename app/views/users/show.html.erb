<% display_title = true if display_title.nil? %>
<% if display_title %>
  <h1><%= @title %></h1>
<% end %>

<%= render CardComponent.new(html_class: "overflow-hidden") do %>
  <% if @user.avatar.present? %>
    <%# Proxy URL is safe here: UsersController#show authorizes :view_shows_and_bio, which is only granted for public_profile: true users %>
    <%= render ImageComponent.new(image: @user.avatar, variant: square_thumb_variant, proxy: true, full_width: false, image_options: { class: "img-thumbnail zoomable float-right ml-3 mb-2" }) %>
  <% end %>
  <%= render_markdown @user.bio %>
  <%= get_link @user, :edit, variant: :primary %>
<% end %>

<h3>Projects</h3>
<%= render(EventsGridComponent.new(items: team_membership_grid_items(@team_memberships), col_size: 12, link_to_admin_events: @link_to_admin_events)) %>
