<p class="mb-3 text-gray-600">
  Every claim finance can see, at any status. Open one to edit it, or
  <%= link_to "jump straight to a number", find_admin_reimbursements_expense_edits_path, class: "text-primary underline" %>.
</p>

<%= render CardComponent.new(title: "Filter & search") do %>
  <%= form_with url: admin_reimbursements_expense_edits_path, method: :get,
                class: "flex flex-wrap items-end gap-3" do %>
    <div>
      <%= label_tag :status, "Status", class: FormStyles::LABEL %>
      <%= select_tag :status,
                     options_for_select([ [ "All statuses", "" ] ] + @statuses.map { |s| [ s, s ] }, @status_filter),
                     class: input_classes(width: "w-44") %>
    </div>
    <div>
      <%= label_tag :budget, "Budget", class: FormStyles::LABEL %>
      <%= select_tag :budget,
                     options_for_select([ [ "All budgets", "" ] ] + @budgets.map { |b| [ b.display_name, b.record_id ] }, @budget_filter),
                     class: input_classes(width: "w-44") %>
    </div>
    <div>
      <%= label_tag :q, "Search", class: FormStyles::LABEL %>
      <%= text_field_tag :q, @query, placeholder: "description, payee, submitter, ref, £, or #",
                         class: input_classes(width: "w-64") %>
    </div>
    <label class="flex items-center gap-2 text-sm">
      <%= check_box_tag :attention, "1", @attention_only %>
      Needs attention only
    </label>
    <%# Carried through Apply as a hidden field, so narrowing one person's
        claims by status does not silently widen back to everybody's. %>
    <% if @person_filter.present? %>
      <%= hidden_field_tag :person, @person_filter %>
    <% end %>
    <%= submit_tag "Apply", class: btn_classes(:secondary, :sm) %>
    <% if @status_filter.present? || @budget_filter.present? || @query.present? ||
          @attention_only || @person_filter.present? %>
      <%= link_to "Clear", admin_reimbursements_expense_edits_path, class: "text-sm text-gray-600 underline" %>
    <% end %>
  <% end %>
  <% if @person_filter.present? %>
    <p class="mt-2 text-sm text-gray-600">
      Showing only the claims submitted by
      <strong><%= @person&.name.presence || @person&.email.presence || "this person" %></strong>.
    </p>
  <% end %>
<% end %>

<div class="mb-2 flex items-center justify-between gap-3">
  <p class="text-sm text-gray-600"><%= pluralize(@expenses.total_count, "expense") %></p>
  <span class="flex flex-wrap gap-2">
    <%# Carries the selected centre through, so the import lands in the pot
        whose claims are on screen rather than the first in the list. The year
        is the import's own selector and this list isn't year-scoped. %>
    <%= link_to "Import expenses",
                admin_reimbursements_expense_import_path(cost_centre: selected_cost_centre&.key),
                class: btn_classes(:secondary, :sm) %>
    <%= link_to "Download CSV",
                admin_reimbursements_expense_edits_path(request.query_parameters.merge(format: :csv)),
                class: btn_classes(:secondary, :sm) %>
  </span>
</div>

<% if @expenses.total_count.zero? %>
  <%= render CardComponent.new(title: @title) do %>
    <p class="py-4 text-center text-gray-600">No expenses match these filters.</p>
  <% end %>
<% else %>
  <%# "Paid to" is the EFFECTIVE payee — on an Invoice, the supplier — and
      "Submitted by" is the person who filed the claim. They are different
      people often enough that one column headed "Payee" made a producer's own
      claims unfindable. The CSV exporter is deliberately NOT changed: an
      export is a stable contract. %>
  <% headers = [ "#", "Status", "Paid to", "Submitted by", "Budget", "Amount",
                 "Description", "Submitted", "Flags", "" ] %>
  <% field_sets = @expenses.map do |expense|
       number = link_to("##{expense.auto_number}", edit_admin_reimbursements_expense_edit_path(expense.record_id),
                        class: "text-primary underline font-mono")
       status = render(BadgeComponent.new(type: ::Reimbursements::Status.badge_variant(expense.status), pill: true)
                                     .with_content(expense.status))
       amount = safe_join([
         content_tag(:span, reimbursements_money(expense.amount), class: "whitespace-nowrap"),
         (content_tag(:span, "#{reimbursements_money(expense.amount_excl_vat)} ex VAT", class: "block text-xs text-gray-500") \
            if expense.amount_excl_vat.present? && expense.amount_excl_vat.positive?)
       ].compact)
       # Suppress the attention flag on non-actionable rows (Submitted/Paid/
       # Rejected) — the same flag there is just noise that trains the eye to
       # skip it on the Pending/Approved rows where it matters.
       attention = if ::Reimbursements::ReviewSupport.attention_actionable?(expense)
         ::Reimbursements::ReviewSupport.attention_summary(expense, @budget_by_id, modulus_checker)
       else
         { blocking: [], advisory: [] }
       end
       flags = content_tag(:div, class: "flex flex-wrap gap-1") do
         safe_join([
           (reimbursements_reasons_popover(reasons: attention[:blocking], key: "edits-block-#{expense.record_id}",
                                           label: "Can't approve yet", heading: "Fix before approving:",
                                           badge_type: :danger,
                                           record_label: "##{expense.auto_number}") if attention[:blocking].any?),
           (reimbursements_reasons_popover(reasons: attention[:advisory], key: "edits-adv-#{expense.record_id}",
                                           label: "Check first", heading: "Check before approving:",
                                           badge_type: :warning,
                                           record_label: "##{expense.auto_number}") if attention[:advisory].any?)
         ].compact, " ")
       end
       # The submitter, linked to their People row — the registry is where a
       # wrong name, a missing email or bad bank details actually get fixed.
       submitted_by = if expense.person&.record_id.present?
         link_to(expense.person.name.presence || expense.person.email.presence || "(no name)",
                 admin_reimbursements_people_path(person: expense.person.record_id,
                                                  anchor: "person-#{expense.person.record_id}"),
                 class: "text-primary underline")
       else
         "-"
       end
       edit = link_to("Edit", edit_admin_reimbursements_expense_edit_path(expense.record_id),
                      "aria-label": "Edit ##{expense.auto_number}", class: btn_classes(:secondary, :sm))
       {
         fields: [
           expense, number, status,
           expense.effective_payee_name.presence || "-",
           submitted_by,
           expense.budget&.display_name.presence || "-",
           amount,
           truncate(expense.description.to_s, length: 60),
           content_tag(:span, reimbursements_date(expense.submitted_at), class: "whitespace-nowrap"),
           flags, edit
         ]
       }
     end %>
  <%= render "shared/pages/index_results",
        resources: @expenses, resource_class: ::Reimbursements::Expense,
        headers: headers, field_sets: field_sets,
        include_edit_button: false, include_link_to_item: false, include_pagination: true %>
<% end %>
