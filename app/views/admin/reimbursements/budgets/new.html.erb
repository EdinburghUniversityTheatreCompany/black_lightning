<%= render "shared/back_link", text: "All budgets", path: admin_reimbursements_budgets_path(year: selected_financial_year&.key) %>

<%= form_with url: admin_reimbursements_budgets_path(year: selected_financial_year&.key),
              method: :post do |form| %>
  <%= render CardComponent.new(title: "New budget") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Create budget",
            cancel_path: admin_reimbursements_budgets_path(year: selected_financial_year&.key) %>
    <% end %>

    <p class="mb-4 text-sm text-gray-600">
      For the one-off line that turns up mid-year. To set a whole year up, import the committee's
      spreadsheet from
      <%= link_to "Financial years", admin_reimbursements_financial_years_path,
                  class: "text-primary underline" %> instead.
      <% if selected_financial_year %>
        This budget will belong to <strong><%= selected_financial_year.label %></strong>.
      <% end %>
    </p>

    <%= render "fields", form: form, people: @people, cost_centres: @cost_centres,
          name: params[:name], nominal_code: params[:nominal_code], budget_type: params[:budget_type],
          initial_budget: params[:initial_budget], notes: params[:notes],
          active: params[:active].present? || params[:name].blank?,
          owner_ids: Array(params[:owner_ids]), cost_centre_id: params[:cost_centre_id] || selected_cost_centre&.id,
          areas: @areas, area_id: params[:area_id] %>
  <% end %>
<% end %>
