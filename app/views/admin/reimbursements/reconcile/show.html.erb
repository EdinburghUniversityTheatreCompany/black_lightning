<%# The whole wizard lives in one Turbo Frame: the stateless steps render directly rather than
    redirect, and Turbo Drive silently discards non-redirect form responses outside a frame. %>
<%= turbo_frame_tag "reconcile" do %>
<p class="mb-3 text-gray-600">
  Import the monthly EUSA actuals sheet and reconcile it against submitted expenses
  and income budgets.
  <%= link_to "What the words mean", admin_reimbursements_glossary_path, class: "underline" %>.
</p>

<%= render CardComponent.new(title: "Where this sheet comes from", html_class: "mb-4") do %>
  <p class="mb-0 text-sm text-gray-600">
    EUSA's finance office emails its ledger export once a month, and it lands weeks after the
    BACS run it confirms. If it has not come, ask them for the latest one: nothing here can
    fetch it.
  </p>
<% end %>

<% if flash[:alert].present? %>
  <%= render AlertComponent.new(type: :danger) do %><%= flash[:alert] %><% end %>
<% end %>

<%# multipart: true is required on form_with url:, or only the file's NAME is posted. A request test
    cannot see it. %>
<%= form_with url: preview_admin_reimbursements_reconciliation_path, method: :post,
              multipart: true do %>
  <%= render CardComponent.new(title: "Step 1: Paste actuals data") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Parse and match" %>
    <% end %>

    <%= render "shared/form/paste_or_upload",
          text_name: :pasted_text,
          text_label: "Actuals data (tab- or comma-separated, include the header row)",
          file_name: :actuals_file,
          file_label: "…or upload the sheet EUSA sent",
          file_accept: ::Reimbursements::ActualsUpload::ACCEPT,
          file_hint: "An .xlsx or .csv. Its first sheet is read, header row included.",
          text_value: @pasted_text, rows: 10,
          placeholder: "Nominal\tCost Centre\tRef\tDate\tPeriod\tNarrative\tNarrative 1\tDebit\tCredit\tNet",
          text_hint: "Each row's EUSA period (P1–P12) and cost centre are read from the pasted data, so " \
                     "there's no need to enter a month or pick a cost centre. A paste may cover several " \
                     "cost centres: each row is imported under its own, rows naming a cost centre that " \
                     "isn't set up here are skipped (and reported), and rows with no cost centre at all " \
                     "will ask you where they belong." %>
  <% end %>
<% end %>
<% end %>
