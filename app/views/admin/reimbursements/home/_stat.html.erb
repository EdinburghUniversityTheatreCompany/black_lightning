<%# A zero count still renders, so the page keeps its shape. h-full + mt-auto
    keep the cards' buttons on one line however their details wrap. %>
<% tone = local_assigns.fetch(:tone, :neutral) %>
<div class="flex h-full flex-col gap-1 rounded border border-gray-200 p-3">
  <p class="text-sm text-gray-600"><%= label %></p>
  <p class="text-2xl font-semibold tabular-nums <%= "text-warning" if tone == :warning && count.positive? %><%= "text-danger" if tone == :danger && count.positive? %>">
    <%= count %>
  </p>
  <% if local_assigns[:amount] %>
    <p class="text-sm text-gray-700 tabular-nums"><%= reimbursements_money(amount) %></p>
  <% end %>
  <% if local_assigns[:detail].present? %>
    <p class="text-xs text-gray-500"><%= detail %></p>
  <% end %>
  <p class="mt-auto pt-2">
    <%= link_to link_text, path, class: btn_classes(:secondary, :sm) %>
  </p>
</div>
