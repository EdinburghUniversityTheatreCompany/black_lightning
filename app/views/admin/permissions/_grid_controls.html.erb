<div class="px-4 py-3 border-t border-gray-200 flex items-center gap-3">
  <%= submit_tag("Update", class: btn_classes(:secondary)) %>
  <span class="text-sm text-gray-500 hidden" data-admin--permissions-grid-target="changeCount">
    <span data-admin--permissions-grid-target="changeCountText"></span>
  </span>
</div>

<%= render Admin::ModalComponent.new(id: "permission-changes", title: "Confirm Permission Changes",
                                     dialog_data: { admin__permissions_grid_target: "modal" }) do |modal| %>
  <div data-admin--permissions-grid-target="changeList"></div>
  <% modal.with_footer do %>
    <div class="flex gap-2 ml-auto">
      <button type="button" class="<%= btn_classes(:secondary) %>" data-action="click->modal#close">Cancel</button>
      <button type="button" class="<%= btn_classes(:success) %>" data-action="click->admin--permissions-grid#approveSubmit">Apply Changes</button>
    </div>
  <% end %>
<% end %>
