<p class="mb-3">
  <%= link_to "← Back to the charts", admin_climate_dashboard_path, class: "text-sm text-primary underline" %>
</p>

<%= render CardComponent.new(title: "Import a Govee export") do %>
  <% if @sensors.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      There are no sensors to import against yet.
      <%= link_to "Add one first", new_admin_climate_sensor_path, class: "text-primary underline" %>.
    <% end %>
  <% else %>
    <p class="text-gray-600">
      <strong>The crypt sensors have no WiFi.</strong> They're reachable over Bluetooth from the
      dressing room, so open the Govee Home app there and wait for it to connect. Once it has, open
      the sensor, choose <strong>Export Data</strong> and send the CSV to yourself.
    </p>

    <p class="text-gray-600">
      Drop the file here. Importing the same one twice is harmless, because readings are keyed by
      sensor and timestamp, so an overlapping export just overwrites what it already covers.
    </p>

    <%= form_with url: admin_climate_import_path, method: :post, multipart: true,
                  data: { turbo: false }, class: "flex flex-col gap-4" do %>
      <div>
        <%= label_tag :sensor_id, "Which sensor is this file from?", class: "block font-semibold mb-1" %>
        <p class="text-sm text-gray-600 mb-1">
          The export does not say which device it came from, so this is the one thing worth
          double-checking, because readings land against whichever sensor is picked here.
        </p>
        <%= select_tag :sensor_id,
                       options_from_collection_for_select(@sensors, :id, :to_label, params[:sensor_id]),
                       include_blank: "Choose a sensor…", class: "form-control" %>
      </div>

      <div>
        <%= label_tag :file, "CSV file", class: "block font-semibold mb-1" %>
        <%= file_field_tag :file, accept: ".csv,text/csv", class: "text-sm" %>
      </div>

      <div>
        <%= label_tag :pasted_text, "…or paste the contents", class: "block font-semibold mb-1" %>
        <%= text_area_tag :pasted_text, params[:pasted_text], rows: 8, class: "form-control font-mono text-xs",
                          placeholder: "Timestamp,Temperature_Celsius,Relative_Humidity" %>
      </div>

      <div>
        <%= submit_tag "Import", class: btn_classes(:primary) %>
        <%= link_to "Cancel", admin_climate_dashboard_path, class: btn_classes(:secondary) %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render CollapsibleSectionComponent.new(title: "What the importer expects", html_class: "mt-4") do %>
  <ul class="list-disc pl-5 space-y-2 text-gray-700">
    <li>
      A header row naming a <strong>timestamp</strong>, a <strong>temperature</strong> and a
      <strong>humidity</strong> column, then one row per reading. Comma or tab separated.
    </li>
    <li>
      <strong>The temperature column must say its unit.</strong> Govee exports
      <code>Temperature_Celsius</code> or <code>Temperature_Fahrenheit</code> depending on what the
      app is set to display. A file that does not say is refused rather than guessed at: guessing
      is how a year of readings ends up silently wrong by 30 degrees.
    </li>
    <li>
      Timestamps are read as Edinburgh local time, matching what the app exports.
    </li>
    <li>
      Readings outside <%= Climate::ReadingIngest::PLAUSIBLE_CELSIUS %> °C or
      <%= Climate::ReadingIngest::PLAUSIBLE_HUMIDITY %> % are skipped and reported, so one bad line
      does not cost you the rest of the file.
    </li>
  </ul>
<% end %>
