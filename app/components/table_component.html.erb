<table class="table table-sticky-head table-hover" <% if fixed_layout? %>style="table-layout: fixed; width: 100%"<% end %>>
  <% if fixed_layout? %>
    <colgroup>
      <% @col_widths.each do |width| %>
        <col style="width: <%= width %>">
      <% end %>
    </colgroup>
  <% end %>

  <thead>
    <tr>
      <% rendered_headers.each do |header| %>
        <th scope="col"><%= header %></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% @field_sets.each do |field_set| %>
      <tr class="<%= field_set[:class] %>">
        <% field_set[:fields].each do |field| %>
          <td> <%= field %> </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
