<%# locals: (form:, people:, owner_ids:, cost_centres: [], cost_centre_id: nil) %>
<%# The area's own fields via simple_form — Area is genuinely model-backed
    (the controller assigns straight onto @area and saves), so this follows
    CLAUDE.md's "model-backed forms use simple_form" rule rather than the
    flat form_with convention the store-mediated Budget form uses. Shared by
    new and edit; the cost centre picker only exists on new and only when
    there is a choice to make. %>
<%= form.input :name, label: "Name" %>
<%= form.input :initial_budget, label: "Agreed total (£)",
      input_html: { step: "0.01", value: reimbursements_amount_value(form.object.initial_budget) } %>

<%# A radio pair rather than a checkbox: two named states read better than one
    negated one, and these are the words the card then prints beside the
    figure (Area::BASIS_LABELS), so a finance user picks what they read back. %>
<%= form.input :budget_basis, as: :radio_buttons,
      collection: ::Reimbursements::Area::BASIS_OPTIONS,
      label: "What that total covers",
      hint: "A show's total is a spend cap: what it raises buys it no more room, " \
            "and its income lines are listed on their own. A committee's is a net " \
            "allowance: money it raises genuinely raises what it may spend." %>

<% if cost_centres.size > 1 %>
  <%= form.input :cost_centre_id, collection: cost_centres, label_method: :name, value_method: :id,
        selected: cost_centre_id, include_blank: false, label: "Cost centre" %>
<% end %>

<%= form.input :active, as: :boolean, label: "Active" %>

<%# A Tom Select multiple rather than a checkbox list: the registry runs to
    dozens of people, so a scrolling column of tickboxes meant hunting for a
    name that a type-ahead finds in three keystrokes. Only `simple-select2` on
    the control (CollectionSelectInput sets it) — Tom Select copies the
    select's classes onto its own wrapper, which already draws the box. Area
    has no owner_ids= writer (the controller syncs through
    store.sync_area_owners!), so `selected:` is passed explicitly rather than
    read off the object; Rails emits the empty hidden field for a multiple
    select, so clearing everyone still clears the owners. %>
<%= form.input :owner_ids, label: "Owners", collection: people,
      value_method: :record_id,
      label_method: ->(person) { person.name.presence || person.email },
      selected: owner_ids, include_blank: false,
      hint: "Everyone who owns this area.",
      input_html: { multiple: true, data: { placeholder: "Search people…" } } %>
<% if form.object.persisted? && owner_ids.empty? %>
  <%# An area with no owners reports none for every budget under it, and
      OwnerReview.gate_applies? is false with no owners — so its claims skip
      owner endorsement, the nightly job never names them and Review's
      Awaiting-owner tab never shows them. Warned in the spirit of the
      budgets index's "No owner" badge. %>
  <p class="-mt-2 mb-4 text-sm text-warning">
    Nobody is named, so claims on this area's budget lines
    skip budget-owner sign-off entirely.
  </p>
<% end %>

<%= form.input :notes, label: "Notes", input_html: { rows: 3 } %>
