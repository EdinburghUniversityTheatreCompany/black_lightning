<%# locals: (articles:) %>
<div class="relative flex h-full w-full flex-col bg-neutral-950 px-24 py-16">
  <%= display_logo(css_class: "absolute right-24 top-12 h-14 w-auto") %>

  <%= display_label("Latest News", css_class: "mb-10") %>

  <%# Same auto-scroll as What's On: the kiosk has no pointer, so overflow would
      be unreachable. Chrome (25rem) is the space around the track: py-16 4 + logo
      row ~2.5 + mb-10 2.5 + mt-8 2 + footer 10 (the QR code, h-40) + py-16 4.
      See display.css. %>
  <div class="display-marquee" style="--display-marquee-chrome: 25rem">
    <ul class="display-marquee__track flex flex-col gap-8">
      <% articles.each do |article| %>
        <li>
          <h2 class="text-5xl font-bold leading-tight text-white"><%= article.title %></h2>
          <p class="mt-3 text-3xl text-neutral-500"><%= article.publish_date&.strftime("%-d %B %Y") %></p>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="mt-8 flex items-center gap-8">
    <%= display_qr_code(news_index_url, css_class: "h-40 w-40", label: "Scan to read the latest news") %>
    <p class="text-4xl text-neutral-300">Scan to read the latest news</p>
  </div>
</div>
