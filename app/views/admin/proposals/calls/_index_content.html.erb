<% can_act = can_act_on_proposals(@awaiting_approval) || can_act_on_proposals(@approved) %>
<% headers = can_act ? [ "Show Title", "Actions" ] : [ "Show Title" ] %>

<%= render CardComponent.new do %>
  <div class="callout callout-info mb-0">
    <p>
      Active proposals across every call. Awaiting Approval decisions happen before the General Meeting;
      Approved proposals are set to successful or unsuccessful after the General Meeting.
    </p>
    <% unless can_act %>
      <p class="mb-0"><em>You have view-only access. Contact an approver to make changes.</em></p>
    <% end %>
  </div>
<% end %>

<%= render CardComponent.new(title: "Open Calls") do %>
  <% if @open_calls.any? %>
    <% @open_calls.each do |call| %>
      <div class="flex flex-wrap gap-2 justify-between items-center <%= 'mt-3' unless call == @open_calls.first %>">
        <div><%= render "admin/proposals/calls/call_heading", call: call %></div>
        <%= get_link(Admin::Proposals::Proposal, :new, link_target: new_admin_proposals_proposal_path(call_id: call.id), link_text: "New Proposal") %>
      </div>
    <% end %>
  <% else %>
    <p class="mb-0"><em>There are no open calls.</em></p>
  <% end %>
<% end %>

<% [
  [ "Awaiting Approval", @awaiting_approval, "No proposals are awaiting approval." ],
  [ "Approved (Awaiting GM Outcome)", @approved, "No approved proposals are awaiting a GM outcome." ]
].each do |heading, proposals, empty_text| %>
  <% by_call = proposals.group_by(&:call) %>
  <%= render CardComponent.new(flush: true) do |c| %>
    <% c.with_tools do %>
      <span class="text-base font-semibold flex-1"><%= heading %></span>
      <%= render(BadgeComponent.new(type: :secondary)) { proposals.size.to_s } %>
    <% end %>
    <% if by_call.any? %>
      <% by_call.each do |call, call_proposals| %>
        <div class="p-4 border-b pb-2">
          <div class="mb-2"><%= render "admin/proposals/calls/call_heading", call: call %></div>

          <% field_sets = call_proposals.map do |proposal|
            fields = [ get_link(proposal, :show, link_text: proposal.show_title) ]
            fields << proposal_action_buttons(proposal) if can_act
            { fields: fields }
          end %>

          <%= render TableComponent.new(headers: headers, field_sets: field_sets, col_widths: [ "70%", "30%" ]) %>
        </div>
      <% end %>
    <% else %>
      <div class="p-4">
        <p class="mb-0"><em><%= empty_text %></em></p>
      </div>
    <% end %>
  <% end %>
<% end %>
