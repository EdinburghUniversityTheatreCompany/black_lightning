<%# Same Turbo Frame as show/apply — see show.html.erb for why the wizard
    renders inside a frame. %>
<%= turbo_frame_tag "reconcile" do %>
<p class="mb-3 text-gray-600">
  Review the matches below. Every row is imported under the cost centre its own Cost Centre
  column names. Debits are matched to Submitted or Paid expenses, credits to income budgets,
  both within that row's cost centre. Rows that cancel each other out are proposed as
  offsetting pairs for you to confirm. When you're happy, apply the reconciliation to save
  everything, mark the matched expenses Paid, and email the producers.
</p>

<% if flash.now[:alert].present? %>
  <%= render AlertComponent.new(type: :danger) do %><%= flash[:alert] %><% end %>
<% end %>

<%# What the paste covers, when it covers more than one pot: the old wizard
    filtered to a single code and dropped the rest in silence, so say plainly
    which centres these rows landed in. %>
<% attributed_by_centre = @attribution.attributed.map(&:cost_centre).tally %>
<% if attributed_by_centre.size > 1 %>
  <%= render AlertComponent.new(type: :info) do %>
    This paste covers <%= attributed_by_centre.size %> cost centres, and each row is imported
    under its own:
    <%= attributed_by_centre.map { |centre, count| "#{centre.name} (#{pluralize(count, 'row')})" }.to_sentence %>.
  <% end %>
<% end %>

<%# A code we don't have set up is another society's spend in a whole-organisation
    export. Skipping it is right; skipping it silently is the bug this replaces. %>
<% if @attribution.unrecognised_rows.any? %>
  <%= render AlertComponent.new(type: :warning) do %>
    <%= pluralize(@attribution.unrecognised_rows.size, "row") %> skipped:
    <%= "cost centre".pluralize(@attribution.unrecognised_codes.size) %>
    <strong><%= @attribution.unrecognised_codes.to_sentence %></strong>
    <%= @attribution.unrecognised_codes.size == 1 ? "is" : "are" %> not set up here.
  <% end %>
<% end %>

<%# A blank cost centre is never inferred, not even when only one is configured:
    that guess is exactly what files real spend under the wrong pot the day a
    second pot exists. Nothing imports until the operator answers. %>
<% if @attribution.blank_choice_required? %>
  <%= render CardComponent.new(title: "Rows with no cost centre") do %>
    <p class="mb-3 text-gray-600">
      <%= pluralize(@attribution.unassigned_blank_rows.size, "row") %> in this paste
      <%= @attribution.unassigned_blank_rows.size == 1 ? "has" : "have" %> no cost centre of
      <%= @attribution.unassigned_blank_rows.size == 1 ? "its" : "their" %> own — the export
      left the column out or blank. Say which cost centre they belong to, or skip them if they
      are not ours. Nothing at all is imported until you answer.
    </p>
    <%= form_with url: preview_admin_reimbursements_reconciliation_path, method: :post do %>
      <%= hidden_field_tag :pasted_text, @pasted_text %>
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <%= label_tag :blank_cost_centre_id, "These rows belong to",
                        class: "block text-sm font-medium mb-1" %>
          <%= select_tag :blank_cost_centre_id,
                         options_for_select(blank_cost_centre_options(@cost_centres),
                                            params[:blank_cost_centre_id]),
                         class: "border border-gray-300 rounded px-2 py-1" %>
        </div>
        <%= submit_tag "Apply that choice", class: btn_classes(:secondary) %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @attribution.skipped_blank_rows.any? %>
  <%= render AlertComponent.new(type: :info) do %>
    <%= pluralize(@attribution.skipped_blank_rows.size, "row") %> with no cost centre
    <%= @attribution.skipped_blank_rows.size == 1 ? "is" : "are" %> being skipped, as you chose.
  <% end %>
<% end %>

<% if @skipped_rows.any? %>
  <%= render AlertComponent.new(type: :info) do %>
    <%= pluralize(@skipped_rows.size, "row") %>
    <%= @skipped_rows.size == 1 ? "was" : "were" %> already imported for
    <%= "period".pluralize(@skipped_rows.map(&:period).uniq.size) %>
    <strong><%= @skipped_rows.map(&:period).uniq.sort.join(", ") %></strong> and
    <%= @skipped_rows.size == 1 ? "was" : "were" %> skipped.
  <% end %>
<% else %>
  <%= render AlertComponent.new(type: :info) do %>
    No already-imported rows found for these periods. All rows are new.
  <% end %>
<% end %>

<% if @new_rows.empty? %>
  <%= render AlertComponent.new(type: :warning) do %>
    <%= if @attribution.blank_choice_required?
          "Nothing can be imported until you say where the rows with no cost centre belong."
        elsif @attribution.attributed.empty?
          "None of these rows belong to a cost centre set up here, so there is nothing to reconcile."
        else
          "All rows are already imported, nothing new to reconcile."
        end %>
  <% end %>
<% else %>
  <%= render CardComponent.new(title: "Matched expenses (#{@matched_debits.size})") do %>
    <% if @matched_debits.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left border-b border-gray-200">
              <th scope="col" class="py-1 pr-3">Nominal</th><th scope="col" class="py-1 pr-3">Period</th>
              <th scope="col" class="py-1 pr-3">Date</th>
              <th scope="col" class="py-1 pr-3">Narrative</th><th scope="col" class="py-1 pr-3 text-right">Debit</th>
              <th scope="col" class="py-1 pr-3">Expense #</th><th scope="col" class="py-1 pr-3">Payee</th>
              <th scope="col" class="py-1 text-right">Expense amount</th>
            </tr>
          </thead>
          <tbody>
            <% @matched_debits.each do |row, expense| %>
              <tr class="border-b border-gray-100">
                <td class="py-1 pr-3 font-mono"><%= row.nominal_code %></td>
                <td class="py-1 pr-3 font-mono"><%= row.period %></td>
                <td class="py-1 pr-3"><%= reimbursements_date(row.date) %></td>
                <td class="py-1 pr-3"><%= row.narrative %></td>
                <td class="py-1 pr-3 text-right"><%= reimbursements_money(row.debit) %></td>
                <td class="py-1 pr-3">#<%= expense.auto_number %></td>
                <td class="py-1 pr-3"><%= expense.effective_payee_name %></td>
                <td class="py-1 text-right"><%= reimbursements_money(expense.amount_excl_vat || expense.amount || 0) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="py-2 text-gray-600">No debit rows matched any submitted expense.</p>
    <% end %>
  <% end %>

  <%= render CardComponent.new(title: "Matched income budgets (#{@matched_credits.size})") do %>
    <% if @matched_credits.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left border-b border-gray-200">
              <th scope="col" class="py-1 pr-3">Nominal</th><th scope="col" class="py-1 pr-3">Period</th>
              <th scope="col" class="py-1 pr-3">Date</th>
              <th scope="col" class="py-1 pr-3">Narrative</th><th scope="col" class="py-1 pr-3 text-right">Credit</th>
              <th scope="col" class="py-1">Budget</th>
            </tr>
          </thead>
          <tbody>
            <% @matched_credits.each do |row, budget| %>
              <tr class="border-b border-gray-100">
                <td class="py-1 pr-3 font-mono"><%= row.nominal_code %></td>
                <td class="py-1 pr-3 font-mono"><%= row.period %></td>
                <td class="py-1 pr-3"><%= reimbursements_date(row.date) %></td>
                <td class="py-1 pr-3"><%= row.narrative %></td>
                <td class="py-1 pr-3 text-right"><%= reimbursements_money(row.credit) %></td>
                <td class="py-1"><%= budget.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="py-2 text-gray-600">No credit rows matched any income budget.</p>
    <% end %>
  <% end %>

  <%= render CardComponent.new(title: "Unmatched rows (#{@unmatched_rows.size})") do %>
    <% if @unmatched_rows.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left border-b border-gray-200">
              <th scope="col" class="py-1 pr-3">Nominal</th><th scope="col" class="py-1 pr-3">Period</th>
              <th scope="col" class="py-1 pr-3">Date</th>
              <th scope="col" class="py-1 pr-3">Narrative</th><th scope="col" class="py-1 pr-3 text-right">Debit</th>
              <th scope="col" class="py-1 pr-3 text-right">Credit</th><th scope="col" class="py-1">Reason</th>
            </tr>
          </thead>
          <tbody>
            <% @unmatched_rows.each do |row| %>
              <tr class="border-b border-gray-100">
                <td class="py-1 pr-3 font-mono"><%= row.nominal_code %></td>
                <td class="py-1 pr-3 font-mono"><%= row.period %></td>
                <td class="py-1 pr-3"><%= reimbursements_date(row.date) %></td>
                <td class="py-1 pr-3"><%= row.narrative %></td>
                <td class="py-1 pr-3 text-right"><%= reimbursements_money(row.debit) if row.debit.positive? %></td>
                <td class="py-1 pr-3 text-right"><%= reimbursements_money(row.credit) if row.credit.positive? %></td>
                <td class="py-1 text-gray-600">
                  <%= if row.debit.positive?
                        "No matching submitted expense"
                      elsif row.credit.positive?
                        "No matching income budget"
                      else
                        "Zero debit and credit"
                      end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="py-2 text-success">All rows matched.</p>
    <% end %>
  <% end %>

  <%# The offsetting-pair tickboxes and the Apply button are one form: the
      pairs you leave ticked are the pairs that get collapsed. %>
  <%= form_with url: apply_admin_reimbursements_reconciliation_path, method: :post do %>
    <%= hidden_field_tag :pasted_text, params[:pasted_text] %>
    <%# The wizard keeps no session state, so the blank-cost-centre answer rides
        along with the paste the way the pair ticks do. Without it, apply
        re-derives "no choice made" and refuses. %>
    <%= hidden_field_tag :blank_cost_centre_id, params[:blank_cost_centre_id] %>

    <%= render CardComponent.new(title: "Offsetting pairs (#{@offsetting_pairs.size})") do %>
      <% if @offsetting_pairs.any? %>
        <p class="mb-3 text-gray-600">
          These rows cancel each other out: an accrual and its reversal, or a journal booked
          and re-booked. Both rows are still imported, but a ticked pair is marked as offsetting
          so it drops out of the working set instead of looking like real spend. Untick any pair
          that is really two separate transactions and its rows will be matched normally.
        </p>
        <%# Always posted, so an untick is a real "no" rather than a missing parameter. %>
        <%= hidden_field_tag "offset_pair_keys[]", "", id: nil %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left border-b border-gray-200">
                <th scope="col" class="py-1 pr-3">Offset?</th><th scope="col" class="py-1 pr-3">Nominal</th>
                <th scope="col" class="py-1 pr-3">Period</th><th scope="col" class="py-1 pr-3">Date</th>
                <th scope="col" class="py-1 pr-3">Ref</th><th scope="col" class="py-1 pr-3">Narrative</th>
                <th scope="col" class="py-1 pr-3 text-right">Debit</th>
                <th scope="col" class="py-1 pr-3 text-right">Credit</th>
                <th scope="col" class="py-1 text-right">
                  <abbr title="How much the two rows agree: their reference (4), nominal code (2), EUSA period (1) and narrative (1), less 1 or 2 points for how far apart their dates are. 8 is everything agreeing on the same day. A pair is only ever proposed when both rows sit on the same nominal code, and it needs at least 4.">Evidence</abbr>
                </th>
              </tr>
            </thead>
            <tbody>
              <% @offsetting_pairs.each do |pair| %>
                <% checkbox_id = "offset-pair-#{pair.key}" %>
                <% consequence = @offset_pair_consequences[pair.key] || {} %>
                <% untick_expense = consequence[:expense] %>
                <% untick_budget = consequence[:budget] %>
                <% spans = untick_expense || untick_budget ? 3 : 2 %>
                <tr class="border-t border-gray-200">
                  <td class="py-1 pr-3" rowspan="<%= spans %>">
                    <%= check_box_tag "offset_pair_keys[]", pair.key, true, id: checkbox_id,
                                      class: "h-4 w-4" %>
                    <%= label_tag checkbox_id, "Treat as offsetting", class: "sr-only" %>
                  </td>
                  <td class="py-1 pr-3 font-mono"><%= pair.debit_row.nominal_code %></td>
                  <td class="py-1 pr-3 font-mono"><%= pair.debit_row.period %></td>
                  <td class="py-1 pr-3"><%= reimbursements_date(pair.debit_row.date) %></td>
                  <td class="py-1 pr-3 font-mono"><%= pair.debit_row.ref.presence || "-" %></td>
                  <td class="py-1 pr-3"><%= pair.debit_row.narrative %></td>
                  <td class="py-1 pr-3 text-right"><%= reimbursements_money(pair.debit_row.debit) %></td>
                  <td class="py-1 pr-3"></td>
                  <td class="py-1 text-right text-gray-600" rowspan="<%= spans %>">
                    <%= pair.score %>/8
                  </td>
                </tr>
                <tr class="<%= spans == 3 ? "" : "border-b border-gray-100" %>">
                  <td class="py-1 pr-3 font-mono"><%= pair.credit_row.nominal_code %></td>
                  <td class="py-1 pr-3 font-mono"><%= pair.credit_row.period %></td>
                  <td class="py-1 pr-3"><%= reimbursements_date(pair.credit_row.date) %></td>
                  <td class="py-1 pr-3 font-mono"><%= pair.credit_row.ref.presence || "-" %></td>
                  <td class="py-1 pr-3"><%= pair.credit_row.narrative %></td>
                  <td class="py-1 pr-3"></td>
                  <td class="py-1 pr-3 text-right"><%= reimbursements_money(pair.credit_row.credit) %></td>
                </tr>
                <%# Applying restores an unticked pair's legs to the ordinary
                    matching, so say what that would do BEFORE the operator
                    submits: the "N matched expenses" count above covers the
                    unpaired rows only. %>
                <% if spans == 3 %>
                  <tr class="border-b border-gray-100">
                    <td class="py-1 pr-3 text-warning" colspan="7">
                      If you untick this pair:
                      <% if untick_expense %>
                        its debit matches expense #<%= untick_expense.auto_number %>
                        (<%= untick_expense.effective_payee_name %>), which would be marked Paid
                        and its producer emailed.
                      <% end %>
                      <% if untick_budget %>
                        Its credit would be logged against the
                        <strong><%= untick_budget.name %></strong> income budget.
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="py-2 text-gray-600">No offsetting pairs found in this paste.</p>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "Step 3: Apply reconciliation") do %>
      <% if @attribution.blank_choice_required? %>
        <p class="mb-3 text-warning">
          Answer the cost-centre question above first. Until then nothing here can be applied —
          not even the rows that do have a cost centre, because importing those while the rest
          quietly vanished is exactly what this step exists to prevent.
        </p>
      <% else %>
        <p class="mb-3 text-gray-600">
          Applying will create the EUSA Actuals records, mark the
          <%= pluralize(@matched_debits.size, "matched expense") %> Paid, and email those producers.
          <% if @offset_pair_consequences.values.any? { |c| c[:expense] } %>
            Any offsetting pair you untick above is matched as well, so it can add to that count:
            the pairs flagged in orange say which expense each one would pay.
          <% end %>
        </p>
        <%= submit_tag "Apply reconciliation", class: btn_classes(:primary),
                       data: { turbo_confirm: "Apply this reconciliation? This marks matched expenses Paid and emails producers." } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="mt-4">
  <%= link_to "← Start over", admin_reimbursements_reconciliation_path, class: "text-sm text-gray-600 underline" %>
</div>
<% end %>
