<%= render Admin::ImportPreviewComponent.new(total: @import.rows.size, cancel_path: new_admin_show_show_crew_import_path(@event), confirm_path: confirm_admin_show_show_crew_imports_path(@event), cache_key: @cache_key, event_name: @event.name) do %>
  <%= render Admin::ImportPreviewSectionComponent.new(items: @existing_team_members, title: "Already on Team (Review Required)", variant: :warning, hint: "These people are already on #{@event.name}", headers: [ "Team Member", "Current Position", "Import Position", [ "Decision", "200px" ] ]) do |section| %>
    <% section.items.each do |user_id, data| %>
      <tr>
        <td><%= data["user_name"] %></td>
        <td><span class="font-mono"><%= data["current_position"] %></span></td>
        <td><span class="font-mono"><%= data["new_position"] %></span></td>
        <td>
          <% { "skip" => "Skip (keep current)", "merge" => "Merge positions", "replace" => "Replace with new" }.each do |value, label| %>
            <div class="form-check">
              <%= radio_button_tag "existing_actions[#{user_id}]", value, value == "skip", class: "form-check-input", id: "existing_action_#{user_id}_#{value}" %>
              <%= label_tag "existing_action_#{user_id}_#{value}", label, class: "form-check-label" %>
            </div>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>

  <% { exact_match_id: "Matched by ID", exact_match_email: "Matched by Email" }.each do |bucket, title| %>
    <% items_not_on_team = @import.categorized[bucket].reject { |item| @existing_team_members.key?(item[:existing_user].id) } %>
    <%= render Admin::ImportPreviewSectionComponent.new(items: items_not_on_team, title:, variant: :success, hint: "Will add to crew", headers: [ "Import Name", "Existing User", "Position", "Action" ]) do |section| %>
      <% section.items.each do |item| %>
        <%= render Admin::ImportExactMatchRowComponent.new(item:, value: item[:row][:position], action: "link", badge: "Will Add", badge_type: :success, row_class: "table-success") do %>
          <% if item[:match_type] %>
            <br><small class="text-gray-500">Matched by <%= UserImport::MATCH_TYPE_LABELS[item[:match_type]] %></small>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% items_not_on_team = @import.categorized[:fuzzy_match].reject { |item| item[:existing_users].all? { |u| @existing_team_members.key?(u.id) } } %>
  <%= render Admin::ImportPossibleMatchesComponent.new(items: items_not_on_team, years_active: @import.years_active_cache, show_ids: false, show_position: true) %>

  <%= render Admin::ImportNewUsersComponent.new(items: @import.categorized[:create_new], hint: "Will create and add to crew", create_label: "Create & Add", show_position: true) %>
<% end %>
