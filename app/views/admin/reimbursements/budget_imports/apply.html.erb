<%# Same frame as the earlier steps — see show.html.erb. %>
<%= turbo_frame_tag "budget_import" do %>
<%= render CardComponent.new(title: "Imported into #{selected_financial_year.label}") do %>
  <ul class="mb-4 list-disc pl-5 text-sm">
    <% if @result.areas_created.positive? %>
      <li><strong><%= pluralize(@result.areas_created, "area") %></strong> created.</li>
    <% end %>
    <li><strong><%= pluralize(@result.created, "budget") %></strong> created.</li>
    <li>
      <strong><%= pluralize(@result.revised, "figure") %></strong>
      revised<%= " (logged as one budget update)" if @result.budget_update %>.
    </li>
    <% if @result.re_homed.positive? %>
      <li>
        <strong><%= pluralize(@result.re_homed, "budget") %></strong> moved into the area the
        sheet named.
      </li>
    <% end %>
    <% if @result.owners_synced.positive? %>
      <li><strong><%= pluralize(@result.owners_synced, "budget") %></strong> had their owners updated.</li>
    <% end %>
  </ul>

  <% if @import.unknown_owner_emails.any? %>
    <p class="mb-4 text-sm text-amber-800">
      These owner emails matched nobody and were skipped:
      <%= @import.unknown_owner_emails.to_sentence %>.
    </p>
  <% end %>

  <div class="flex flex-wrap gap-3">
<%# Every link out of this frame needs turbo_frame: "_top": a link inside a
    Turbo Frame navigates THE FRAME, and a destination with no matching frame
    lands as "Content missing" instead of the page. %>
    <%= link_to "See the budgets",
                admin_reimbursements_budgets_path(year: selected_financial_year.key),
                class: btn_classes(:primary), data: { turbo_frame: "_top" } %>
    <%= link_to "Import another sheet", import_path, class: btn_classes(:secondary) %>
    <% unless selected_financial_year.active? %>
      <%= link_to "Financial years", admin_reimbursements_financial_years_path,
                  class: btn_classes(:secondary), data: { turbo_frame: "_top" } %>
    <% end %>
  </div>

  <% unless selected_financial_year.active? %>
    <p class="mt-4 text-sm text-gray-600">
      <%= selected_financial_year.label %> is still a draft — submitters won't see these budgets until you
      make it the active year.
    </p>
  <% end %>
<% end %>
<% end %>
