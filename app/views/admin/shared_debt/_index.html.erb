<%# locals: (debt_class:, is_specific_user:) %>
<% search_fields = is_specific_user ? nil : {
  user_full_name_cont:  { slug: 'defaults.user' },
  show_name_cont:       { slug: 'defaults.show_name' },
  show_fulfilled:       { slug: 'defaults.show_fulfilled', type: :boolean, checked: @show_fulfilled },
  show_non_members:     { slug: 'defaults.show_non_members', type: :boolean }
} %>

<%= render 'shared/pages/index', resource_class: debt_class, content: render("#{controller_path}/index_results"),
  search_fields: search_fields %>
