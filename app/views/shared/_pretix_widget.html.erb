<%# locals: (event:) -%>

<% content_for :head do %>
   <%# The stylesheet comes from the shop itself — see PretixHelper. It stays a server-rendered
       <link> so the widget is styled the moment it appears; the script does not, because when
       pretix's script runs is exactly what used to break here (see javascript/lib/pretix.js). %>
   <%= stylesheet_link_tag pretix_widget_stylesheet_url %>
<% end %>

<%# An empty container, not a <pretix-widget>: building one replaces the element with pretix's
    rendered markup, so a server-rendered element survives at most one build and Turbo would
    restore the spent copy from its cache. The controller drops a fresh element in on connect. %>
<div data-controller="pretix-widget"
     data-pretix-widget-base-url-value="<%= pretix_shop_url %>"
     data-pretix-widget-event-url-value="<%= pretix_event_url(event) %>"
     data-pretix-widget-list-type-value="<%= event.pretix_view %>"></div>
<noscript>
   <div class="pretix-widget">
        <div class="pretix-widget-info-message">
            JavaScript is disabled in your browser. To access our ticket shop without JavaScript, please <a target="_blank" rel="noopener" href="<%= pretix_event_url(event) %>">click here</a>.
        </div>
    </div>
</noscript>
