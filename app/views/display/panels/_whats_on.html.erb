<%# locals: (events:, on:) %>
<div class="flex h-full w-full flex-col bg-neutral-950 px-16 py-12">
  <%# h-18 and h-9 are pinned, not content-sized: display.css subtracts them from
      100vh for the marquee's height. Change one and change the sum there too. %>
  <div class="mb-10 flex h-18 items-center justify-between gap-10">
    <h1 class="text-7xl font-bold tracking-tight text-display-accent">What's On</h1>
    <%= display_logo %>
  </div>

  <div class="display-marquee">
    <%# `grow` rather than `flex-1`: flex-1 sets a zero basis, so a two-line title
        would be squeezed back onto one. %>
    <ul class="display-marquee__track flex flex-col divide-y divide-neutral-800">
      <% events.each do |event| %>
        <li class="flex grow items-center gap-10 py-4">
          <%# No `truncate`, for the same reason the title has none: this column now
              carries a run AND its hours, and the longest of those ("Wed 30 Sep -
              Sun 4 Oct, 10.30am - 11.30pm") wants ~700px at text-4xl. Widening to
              the worst case would eat the title; wrapping costs a line only on the
              rows that need one, and the marquee scrolls whatever that pushes
              past the bottom. 31rem fits every ordinary line without wrapping. %>
          <span class="w-[31rem] shrink-0 text-4xl font-semibold leading-descender text-neutral-300">
            <%= display_when(event, on: on) %>
          </span>
          <%# No `truncate`: naming the show is this board's whole job, and a title
              cut off mid-word tells nobody what is on. It wraps, and the marquee
              scrolls whatever that pushes past the bottom. %>
          <span class="min-w-0 flex-1 text-5xl font-bold leading-tight text-white"><%= event.name %></span>
          <span class="w-64 shrink-0 truncate text-right text-3xl leading-descender text-neutral-400"><%= display_price(event) %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <p class="mt-8 flex h-9 items-center text-3xl text-neutral-500">bedlamtheatre.co.uk</p>
</div>
