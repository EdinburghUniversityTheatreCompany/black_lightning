<%= render "admin/reimbursements/shared/year_selector" %>
<%= render "admin/reimbursements/shared/cost_centre_selector" %>

<%= render "shared/back_link", text: "All budgets", path: admin_reimbursements_budgets_path %>

<p class="mb-3 text-gray-600">
  The same budgets down two axes: by nominal code, the axis EUSA's ledger uses, and by area,
  the show the committee agreed a total for. Expense and income budgets are totalled separately,
  since adding spend to income gives a figure that is neither.
</p>

<%= render "admin/reimbursements/shared/glossary_terms",
           terms: ::Reimbursements::Glossary.terms(:nominal_code, :area, :projected, :committed,
                                                   :pipeline, :remaining, :eusa_actual,
                                                   :unattributed) %>

<%# The health check in one line, above the tables. %>
<%= render AlertComponent.new(type: @over_budget_count.positive? ? :warning : :info) do %>
  <% if @over_budget_count.positive? %>
    <strong><%= pluralize(@over_budget_count, "line") %></strong>
    <%= @over_budget_count == 1 ? "is" : "are" %> over budget
    (<%= link_to "see them below", "#budgets-by-code", class: "underline" %>, badged in red).
  <% else %>
    No line is over budget.
  <% end %>
  <%# The COUNT leads and the net is a parenthetical: debits less credits can be
      negative, and a bare negative reads as bad news. %>
  <% if @unattributed_count.zero? %>
    Every EUSA ledger row is attributed to a budget.
  <% else %>
    <%= link_to pluralize(@unattributed_count, "EUSA ledger row"),
                "#unattributed-actuals", class: "underline" %>
    <%= @unattributed_count == 1 ? "is" : "are" %> attributed to no budget
    (net <%= reimbursements_money(@unattributed_total) %>, debits less credits).
  <% end %>
<% end %>

<%
  expected_tip = "The greater of the current projection and what's already been spent or " \
                 "committed, so the number never drops below reality. Blank on income lines."
%>

<%# The summary's anchor (CardComponent takes no id). %>
<div id="budgets-by-code">
<%= render CardComponent.new(title: "Budgets by nominal code", flush: true) do %>
  <div class="table-scroll">
    <table class="table table-hover table-sticky-head">
      <%= render "overview_head", expected_tip: expected_tip %>
      <% @rollups.each do |rollup| %>
        <tbody>
          <tr class="bg-gray-50">
            <th scope="rowgroup" colspan="11" class="text-left font-semibold py-2">
              Nominal code <%= rollup.code %><%
                label = nominal_code_labels[rollup.code.to_s.downcase] %><% if label.present? %>
                <span class="font-normal text-gray-600">· <%= label %></span>
              <% end %>
            </th>
          </tr>
          <%= render partial: "overview_budget_row", collection: rollup.rows, as: :budget %>
          <%# One subtotal per type: spend and income never add up. %>
          <% rollup.by_type.each do |subtotal| %>
            <%= render "rollup_row", rollup: subtotal,
                  label: "Subtotal #{rollup.code} (#{subtotal.budget_type})" %>
          <% end %>
        </tbody>
      <% end %>
      <tfoot>
        <% @grand_total.by_type.each do |total| %>
          <%= render "rollup_row", rollup: total,
                label: "Grand total (#{total.budget_type} budgets)",
                row_class: "border-t-2 border-gray-400 font-semibold" %>
        <% end %>
      </tfoot>
    </table>
  </div>
<% end %>
</div>

<%= render CardComponent.new(title: "Budgets by area", html_class: "mt-4", flush: true) do %>
  <%# No grand total: it would restate the card above's. %>
  <% if @area_rollups.empty? && @unassigned_rollup.nil? %>
    <p class="px-4 py-4 text-center text-gray-600">No budgets to group.</p>
  <% else %>
    <div class="table-scroll">
      <table class="table table-hover table-sticky-head">
        <%= render "overview_head", expected_tip: expected_tip %>
        <% @area_rollups.each do |rollup| %>
          <%= render "area_group", rollup: rollup, label: rollup.name %>
        <% end %>
        <% if @unassigned_rollup %>
          <%= render "area_group", rollup: @unassigned_rollup, label: "Not in an area" %>
        <% end %>
      </table>
    </div>
  <% end %>
<% end %>

<div id="unattributed-actuals">
<%= render CardComponent.new(title: "Actuals not attributed to any budget", html_class: "mt-4") do %>
  <%
    # The ledger, not Reconcile, which has no per-row linking. It carries the
    # cost centre the tables above are scoped to.
    ledger_path = lambda do |extra = {}|
      admin_reimbursements_actuals_path(
        { cost_centre: selected_cost_centre&.key,
          state: ::Admin::Reimbursements::ActualsController::STATE_NEEDS_ATTENTION }
          .merge(extra).compact_blank
      )
    end
  %>
  <p class="text-sm text-gray-600 mb-3">
    EUSA ledger rows linked to neither an expense nor a budget, so nothing above counts them,
    <em>including</em> rows on a nominal code that does have a budget. Offsetting pairs are left
    out. Resolve them on the
    <%= link_to "EUSA Actuals ledger", ledger_path.call, class: "text-primary underline" %>
    (link a row to the claim it paid, convert a debit into an expense, or split a credit
    across income budgets) and it stops showing here.
  </p>

  <% if @unattributed_by_code.empty? %>
    <p class="py-2 text-center text-gray-600">
      Every EUSA actual is attributed to a budget.
    </p>
  <% else %>
    <div class="table-scroll">
      <table class="w-full text-sm table-sticky-head">
        <thead>
          <tr class="text-left text-gray-500 border-b border-gray-200">
            <th scope="col" class="py-2 pr-3">Date</th>
            <th scope="col" class="py-2 pr-3">Narrative</th>
            <th scope="col" class="py-2 pr-3">Ref</th>
            <th scope="col" class="py-2 pr-3">Type</th>
            <th scope="col" class="py-2 text-right">Amount</th>
          </tr>
        </thead>
        <% @unattributed_by_code.each do |code, actuals| %>
          <tbody>
            <tr class="bg-gray-50">
              <th scope="rowgroup" colspan="5" class="text-left font-semibold py-2">
                Nominal code <%= code %>
                <span class="font-normal text-gray-600">
                  (net <%= reimbursements_money(reimbursements_actuals_net(actuals)) %>)
                </span>
              </th>
            </tr>
            <% actuals.each do |actual| %>
              <% debit = actual.debit&.positive? %>
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-3 whitespace-nowrap"><%= reimbursements_date(actual.date) %></td>
                <%# Each row links to itself on the ledger: its ref (or
                    narrative) plus its period. %>
                <td class="py-2 pr-3">
                  <%= link_to actual.narrative.presence || "(no narrative)",
                              ledger_path.call(period: actual.period,
                                               search: actual.ref.presence || actual.narrative),
                              class: "text-primary underline" %>
                </td>
                <td class="py-2 pr-3"><%= actual.ref.presence || "-" %></td>
                <td class="py-2 pr-3"><%= debit ? "Debit" : (actual.credit&.positive? ? "Credit" : "-") %></td>
                <td class="py-2 text-right"><%= reimbursements_money(debit ? actual.debit : actual.credit) %></td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
        <tfoot>
          <tr class="border-t-2 border-gray-400 font-semibold">
            <td colspan="4" class="py-2 text-right">Total unattributed (debits less credits)</td>
            <td class="py-2 text-right">
              <%= reimbursements_money(@unattributed_total) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
<% end %>
</div>
