<%# locals: (label:, name:, hint: nil, error: nil, html_class: nil, id: nil) %>
<%# One field of a hand-rolled (form_with url:) form: label above, the control
    yielded from the caller, then error and hint. Styled from the same
    FormStyles constants as simple_form's vertical wrapper so the finance
    screens read like the rest of the admin. `id` is only needed when the
    control's id is not derived from its name (a per-row form on a list). %>
<div class="<%= html_class %>">
  <%= label_tag (id || name), label, class: FormStyles::LABEL %>
  <%= yield %>
  <% if error.present? %>
    <div class="<%= FormStyles::ERROR %>" role="alert"><%= error %></div>
  <% end %>
  <% if hint.present? %>
    <small class="<%= FormStyles::HINT %>"><%= hint %></small>
  <% end %>
</div>
