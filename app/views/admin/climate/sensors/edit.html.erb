<p class="mb-3">
  <%= link_to "← All sensors", admin_climate_sensors_path, class: "text-sm text-primary underline" %>
</p>

<%= render CardComponent.new(title: @sensor.display_name) do %>
  <% if @sensor.open_meteo? %>
    <p class="text-gray-600">
      The outdoor feed. Its coordinates are set in code and it is refreshed hourly; only its name,
      ordering and whether it appears on the dashboard are editable here.
    </p>
  <% end %>

  <%= render "form", url: admin_climate_sensor_path(@sensor), method: :patch, submit_label: "Save" %>
<% end %>
