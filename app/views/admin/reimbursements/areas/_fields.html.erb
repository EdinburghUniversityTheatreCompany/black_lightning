<%# locals: (form:, people:, owner_ids:, cost_centres: [], cost_centre_id: nil) %>
<%# Shared by new and edit; the cost centre picker is new-only, and only when
    there is a choice to make. %>
<%= form.input :name, label: "Name" %>
<%= form.input :initial_budget, label: "Agreed total (£)",
      input_html: { step: "0.01", value: reimbursements_amount_value(form.object.initial_budget) } %>

<%# These are the words the card prints beside the figure (Area::BASIS_LABELS),
    so a finance user picks what they read back. %>
<%= form.input :budget_basis, as: :radio_buttons,
      collection: ::Reimbursements::Area::BASIS_OPTIONS,
      label: "What that total covers",
      hint: "A show's total is a spend cap: what it raises buys it no more room, " \
            "and its income lines are listed on their own. A committee's is a net " \
            "allowance: money it raises genuinely raises what it may spend." %>

<% if cost_centres.size > 1 %>
  <%= form.input :cost_centre_id, collection: cost_centres, label_method: :name, value_method: :id,
        selected: cost_centre_id, include_blank: false, label: "Cost centre" %>
<% end %>

<%= form.input :active, as: :boolean, label: "Active" %>

<%# Area has no owner_ids= writer, so selected: is passed. Rails' empty hidden
    field for a multiple select is what makes clearing everyone clear the owners. %>
<%= form.input :owner_ids, label: "Owners", collection: people,
      value_method: :record_id,
      label_method: ->(person) { person.name.presence || person.email },
      selected: owner_ids, include_blank: false,
      hint: "Everyone who owns this area.",
      input_html: { multiple: true, data: { placeholder: "Search people…" } } %>
<% if form.object.persisted? && owner_ids.empty? %>
  <%# OwnerReview.gate_applies? is false with no owners, so every claim under
      this area skips owner endorsement. %>
  <p class="-mt-2 mb-4 text-sm text-warning">
    Nobody is named, so claims on this area's budget lines
    skip budget-owner sign-off entirely.
  </p>
<% end %>

<%= form.input :notes, label: "Notes", input_html: { rows: 3 } %>
