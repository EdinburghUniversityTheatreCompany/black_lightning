<%# Nil unless the check applies — see ReviewSupport.modulus_result, which owns
    that rule so this banner and the Review summary cannot disagree. %>
<% modulus = ::Reimbursements::ReviewSupport.modulus_result(@expense, modulus_checker) %>

<p class="mb-3 text-gray-600">
  Finance edit for a single expense at any status. Changes save immediately.
  <%= link_to "All expenses", admin_reimbursements_expense_edits_path, class: "text-primary underline" %>
  or the <%= link_to "Review queue", admin_reimbursements_review_path, class: "text-primary underline" %>.
</p>

<%= render CardComponent.new do %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <span class="font-medium">
      #<%= @expense.auto_number %>: <%= @expense.person&.name.presence || "(no payee)" %>
      <span class="text-gray-500">(<%= @expense.person&.email.presence || "no email" %>)</span>
    </span>
    <span>Amount: <strong><%= reimbursements_money(@expense.amount) %></strong></span>
    <span class="flex items-center gap-1">Bank: <%= reimbursements_effective_modulus_badge(@expense, checker: modulus_checker) %></span>
    <span>Receipts: <%= @expense.receipt_count %></span>
    <%= render BadgeComponent.new(type: Reimbursements::Status.badge_variant(@expense.status), pill: true).with_content(@expense.status) %>
  </div>

  <%# --- Why this needs attention (blocked vs advisory) ---
      Only while the claim can still be approved or paid. On a Submitted, Paid
      or Rejected row the same reasons are advice about a decision nobody is
      going to take again: a Paid claim opened with "This can't be approved
      until these are fixed" stacked above "already been paid". The expenses
      index has suppressed them on those rows for a while; this is the page
      catching up. %>
  <% advice = ::Reimbursements::ReviewSupport.attention_actionable?(@expense) %>
  <% if advice && @attention[:blocking].any? %>
    <div class="mt-3"><%= render AlertComponent.new(type: :danger) do %>
        <p class="font-medium">This can't be approved until these are fixed:</p>
        <ul class="mt-1 list-disc pl-5">
          <% @attention[:blocking].each do |reason| %>
            <li><%= reason %></li>
          <% end %>
        </ul>
      <% end %></div>
  <% end %>
  <% if advice && @attention[:advisory].any? %>
    <div class="mt-3"><%= render AlertComponent.new(type: :warning) do %>
        <p class="font-medium">Worth checking before approving (approval still goes through):</p>
        <ul class="mt-1 list-disc pl-5">
          <% @attention[:advisory].each do |reason| %>
            <li><%= reason %></li>
          <% end %>
        </ul>
      <% end %></div>
  <% end %>

  <%# --- Already-processed note (Submitted / Paid) --- %>
  <% if @expense.status == Reimbursements::Status::SUBMITTED %>
    <div class="mt-3"><%= render AlertComponent.new(type: :warning) do %>
        This expense has <strong>already been sent to EUSA</strong>. Edits here won't change what
        EUSA has already processed. Update it only to keep our records straight, then follow up with
        EUSA directly if the payment itself needs to change.
      <% end %></div>
  <% elsif @expense.status == Reimbursements::Status::PAID %>
    <div class="mt-3"><%= render AlertComponent.new(type: :warning) do %>
        This expense has <strong>already been paid</strong>. Edits here won't change what EUSA has
        already processed. Update it only to keep our records straight.
      <% end %></div>
  <% end %>

  <% if @expense.payee_override? %>
    <div class="mt-3"><%= render AlertComponent.new(type: :info) do %>
        Direct payment to <strong><%= @expense.effective_payee_name %></strong>
        (not the submitter <%= @expense.person&.name %>), paying
        <% if @expense.international? %>
          IBAN <strong><%= Reimbursements::BankDetails.format_iban(@expense.effective_iban) %></strong>
          (BIC <strong><%= @expense.effective_bic %></strong>)
        <% else %>
          <%= render Admin::Reimbursements::BankDetailsComponent.new(
              sort_code: @expense.effective_sort_code,
              account_number: @expense.effective_account_number,
              payee: @expense.effective_payee_name) %>
        <% end %>.
      <% end %></div>
  <% end %>

  <% if modulus == Reimbursements::ModulusCheck::INVALID %>
    <div class="mt-3"><%= render AlertComponent.new(type: :danger) do %>
        Modulus check failed for the effective sort code + account number. Likely a typo.
      <% end %></div>
  <% end %>

<% end %>

<%# --- History: what has actually happened to this claim ---
    Read-only. It had no timeline at all — submitted, endorsed, approved,
    batched and paid live on four tables and no screen assembled them — so a
    Paid claim's page was a status pill and nothing else, and the rejection
    reason and the override note, both stored, appeared nowhere in the portal.
    Every row is omitted when it has nothing to say, so a fresh claim shows
    only its submission. %>
<% has_history = @expense.submitted_at.present? || @endorsement.present? ||
                 @expense.rejection_reason.present? || @batch.present? ||
                 @expense.payment_confirmed_date.present? %>
<% if has_history %>
  <%= render CardComponent.new(title: "History", html_class: "mt-4") do %>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
      <% if @expense.submitted_at.present? %>
        <dt class="font-medium">Submitted</dt>
        <dd><%= reimbursements_date(@expense.submitted_at) %></dd>
      <% end %>

      <% if @endorsement&.owner_endorsement? %>
        <dt class="font-medium">Owner sign-off</dt>
        <dd>
          <%= @endorsing_person&.name.presence || "an owner" %>
          on <%= reimbursements_date(@endorsement.endorsed_at) %>
        </dd>
      <% elsif @endorsement&.finance_override? %>
        <%# Who bypassed the owner gate, when, and the reason they gave. The
            note was write-only before this. %>
        <dt class="font-medium">Owner sign-off overridden</dt>
        <dd>
          <%= @endorsement.overridden_by&.name_or_email.presence || "a finance user" %>
          on <%= reimbursements_date(@endorsement.endorsed_at) %><% if @endorsement.note.present? %>
            — <q><%= @endorsement.note %></q>
          <% end %>
        </dd>
      <% end %>

      <% if @expense.rejection_reason.present? %>
        <dt class="font-medium">Rejected</dt>
        <dd>
          <% if @expense.rejection_notified.present? %>
            <%= reimbursements_date(@expense.rejection_notified) %>, producer emailed —
          <% end %>
          <q><%= @expense.rejection_reason %></q>
        </dd>
      <% end %>

      <% if @batch.present? %>
        <dt class="font-medium">In batch</dt>
        <dd>
          <%= link_to @batch.name.presence || @batch.record_id,
                      admin_reimbursements_batch_path(@batch.record_id),
                      class: "text-primary underline" %>
          <%# "BACS date", never "sent": nothing records the manual send. %>
          <span class="text-gray-500">(BACS <%= reimbursements_date(@batch.date_sent) %>)</span>
        </dd>
      <% end %>

      <% if @expense.payment_confirmed_date.present? %>
        <dt class="font-medium">Payment confirmed</dt>
        <dd><%= reimbursements_date(@expense.payment_confirmed_date) %></dd>
      <% end %>
    </dl>
  <% end %>
<% end %>

<%# Details and receipts side by side, so the figure on the document and the
    figure in the form can be read together instead of in two tabs. Stacks on
    narrow screens, where squeezing both would leave neither readable. %>
<div class="flex flex-col gap-4 lg:flex-row lg:items-start">
  <div class="min-w-0 lg:flex-1">
    <%= form_with url: admin_reimbursements_expense_edit_path(@expense.record_id), method: :patch do %>
      <%= render CardComponent.new(title: "Details") do |card| %>
        <% card.with_footer do %>
          <%= render "shared/form/actions", submit: "Save changes",
                cancel_path: admin_reimbursements_expense_edits_path %>
        <% end %>

        <div class="flex flex-col gap-4">
          <%# All three types: From EUSA is finance's own, and this is the only place
              a claim a producer mis-typed can be corrected. %>
          <%= render "shared/form/field", label: "Type", name: :expense_type do %>
            <%= select_tag :expense_type,
                           options_for_select(Reimbursements::Expense::TYPES, @expense.expense_type),
                           include_blank: @expense.expense_type.blank?, class: input_classes %>
          <% end %>

          <div class="grid gap-4 sm:grid-cols-2">
            <%= render "shared/form/field", label: "Amount (GBP)", name: :amount do %>
              <%= number_field_tag :amount, reimbursements_amount_value(@expense.amount), step: 0.01, min: 0, class: input_classes %>
            <% end %>
            <%= render "shared/form/field", label: "Amount excl. VAT (GBP)", name: :amount_excl_vat do %>
              <%= number_field_tag :amount_excl_vat, reimbursements_amount_value(@expense.amount_excl_vat), step: 0.01, min: 0,
                                   class: input_classes %>
            <% end %>
          </div>

          <%= render "shared/form/field", label: "Description", name: :description do %>
            <%= text_area_tag :description, @expense.description, rows: 2, class: input_classes %>
          <% end %>

          <div class="grid gap-4 sm:grid-cols-2">
            <%= render "shared/form/field", label: "Payment reference", name: :payment_reference do %>
              <%= text_field_tag :payment_reference, @expense.payment_reference,
                                 maxlength: Reimbursements::ExpenseForm::REFERENCE_LIMIT, class: input_classes %>
            <% end %>
            <%= render "shared/form/field", label: "Budget", name: :budget_record_id do %>
              <% budget_options = @budgets.map { |b| [ b.display_name, b.record_id ] } %>
              <% if @expense.budget && @expense.budget.record_id.present? && budget_options.none? { |_, id| id == @expense.budget.record_id } %>
                <% budget_options.unshift([ @expense.budget.display_name, @expense.budget.record_id ]) %>
              <% end %>
              <%= select_tag :budget_record_id,
                             options_for_select(budget_options, @expense.budget&.record_id),
                             include_blank: @expense.budget&.record_id.blank?, class: input_classes %>
            <% end %>
          </div>

          <%= render "shared/form/field", label: "Nominal code override", name: :nominal_code_override,
                hint: "Effective nominal: #{@expense.effective_nominal_code.presence || '-'}",
                html_class: "sm:w-1/2 sm:pr-2" do %>
            <%= text_field_tag :nominal_code_override, @expense.nominal_code_override,
                               placeholder: "blank = use budget default", class: input_classes %>
          <% end %>

          <%# The invoice figure and its currency, which is what EUSA's bank
              actually pays. The GBP amount above stays finance's own estimate
              until reconcile corrects it. %>
          <% if @expense.international? %>
            <div class="grid gap-4 sm:grid-cols-2">
              <%= render "shared/form/field", label: "Invoice currency", name: :foreign_currency do %>
                <%# input_classes, not simple-select2: every other select on this
                    page is a plain styled one, and a lone Tom Select widget among
                    them reads as a different kind of control. %>
                <%= select_tag :foreign_currency,
                               options_for_select(Reimbursements::Expense::FOREIGN_CURRENCIES,
                                                  @expense.foreign_currency),
                               class: input_classes %>
              <% end %>
              <%= render "shared/form/field", label: "Invoice amount", name: :foreign_amount do %>
                <%= text_field_tag :foreign_amount, @expense.foreign_amount,
                                   placeholder: "as printed on the invoice", class: input_classes %>
              <% end %>
            </div>
          <% end %>

          <div class="border-t border-gray-200 pt-3">
            <h3 class="mb-1">Payee overrides</h3>
            <p class="mb-0 text-sm text-gray-600">
              To pay a third party directly. Leave blank to pay the submitter's own People-record details.
            </p>
          </div>

          <%= render "shared/form/field", label: "Payee name override", name: :payee_name_override do %>
            <%= text_field_tag :payee_name_override, @expense.payee_name_override, class: input_classes %>
          <% end %>
          <%# Only the rail's own pair is rendered. Showing both would invite
              filling in a sort code for a payment that goes over SWIFT, and the
              all-or-nothing rule reads whichever pair applies. %>
          <div class="grid gap-4 sm:grid-cols-2">
            <% if @expense.international? %>

              <%= render "shared/form/field", label: "Payee IBAN", name: :iban_override do %>
                <%= text_field_tag :iban_override,
                                   Reimbursements::BankDetails.format_iban(@expense.iban_override.to_s),
                                   placeholder: "DE89 3704 0044 0532 0130 00", class: input_classes %>
              <% end %>
              <%= render "shared/form/field", label: "Payee BIC / SWIFT", name: :bic_override do %>
                <%= text_field_tag :bic_override, @expense.bic_override,
                                   placeholder: "8 or 11 characters", class: input_classes %>
              <% end %>

            <% else %>

              <%= render "shared/form/field", label: "Sort code override", name: :sort_code_override do %>
                <%= text_field_tag :sort_code_override, @expense.sort_code_override, placeholder: "00-00-00",
                                   class: input_classes %>
              <% end %>
              <%= render "shared/form/field", label: "Account number override", name: :account_number_override do %>
                <%= text_field_tag :account_number_override, @expense.account_number_override,
                                   placeholder: "8 digits", class: input_classes %>
              <% end %>

            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Finance can still detach individual receipts and attach new ones: the same
      dropzone + gallery the producer's edit page has, pointed at the finance
      routes. %>
  <div class="min-w-0 lg:w-2/5"
       data-controller="receipts-upload"
       data-receipts-upload-url-value="<%= admin_reimbursements_expense_edit_receipts_path(@expense.record_id) %>">
    <%= render CardComponent.new(title: "Receipts") do %>
      <%= render "admin/reimbursements/shared/receipts_dropzone" %>
      <%= render "admin/reimbursements/expenses/receipts_gallery", expense: @expense, finance: true %>
    <% end %>
  </div>
</div>
