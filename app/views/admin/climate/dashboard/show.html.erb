<p class="mb-3 text-gray-600">
  Temperature, relative humidity and dew point in the crypt, compared with outside. Condensation
  forms on any surface at or below the dew point of the air touching it, so the walls need to sit a
  few degrees above the crypt's dew point to keep mould off them.
  <strong>Under <%= number_with_precision(Climate::CONDENSATION_RISK_MARGIN, precision: 0) %> °C of margin is worth acting on</strong>,
  which is roughly 80% humidity at the surface and where mould starts to grow.
</p>

<%= render CardComponent.new(title: "Now", html_class: "mb-4") do |card| %>
  <% card.with_tools do %>
    <% if can?(:manage, :climate) %>
      <%= link_to "Import readings", new_admin_climate_import_path, class: btn_classes(:primary, :sm) %>
      <%= link_to "Sensors", admin_climate_sensors_path, class: btn_classes(:secondary, :sm) %>
    <% end %>
  <% end %>

  <% if @sensors.empty? %>
    <p class="text-gray-600 mb-0">
      No active sensors yet.
      <%= link_to "Add one", new_admin_climate_sensor_path, class: "text-primary underline" if can?(:manage, :climate) %>
    </p>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
      <%= render partial: "sensor_tile", collection: @sensors, as: :sensor %>
    </div>
  <% end %>
<% end %>

<%= render "condensation_risk", crypt_sensors: @crypt_sensors, risk: @risk, margin_series: @margin_series %>

<%= render "ventilation", ventilation: @ventilation %>

<%= render CardComponent.new(title: "History") do |card| %>
  <% card.with_tools do %>
    <%= link_to "View as data",
                admin_climate_dashboard_path(climate_link_params(@range.to_param, @ventilation.selected_key).merge(format: :json)),
                class: btn_classes(:secondary, :sm) %>
  <% end %>

  <%= form_with url: admin_climate_dashboard_path, method: :get, data: { turbo: false },
                class: "flex flex-wrap items-end gap-3 mb-4" do |f| %>
    <%= hidden_field_tag :crypt, @ventilation.selected_key unless @ventilation.selected_key == Climate::VentilationSeries::WORST %>
    <div>
      <%= f.label :from, "From", class: "block text-sm text-gray-600" %>
      <%= f.date_field :from, value: @range.from.iso8601, class: "form-control" %>
    </div>
    <div>
      <%= f.label :to, "To", class: "block text-sm text-gray-600" %>
      <%= f.date_field :to, value: @range.to.iso8601, class: "form-control" %>
    </div>
    <%= f.submit "Show", class: btn_classes(:primary) %>

    <div class="flex flex-wrap gap-2 items-center ml-auto">
      <% climate_range_presets.each do |label, dates| %>
        <%= link_to label, admin_climate_dashboard_path(climate_link_params(dates, @ventilation.selected_key)),
                    class: btn_classes(:secondary, :sm) %>
      <% end %>
    </div>
  <% end %>

  <div data-controller="climate-charts"
       data-climate-charts-series-value="<%= @series.to_json %>"
       data-climate-charts-banded-value="<%= @banded %>">
    <% if @series.none? { |series| series[:points].any? } %>
      <p class="text-gray-600">
        No readings in this range yet. Outside conditions are fetched hourly; sensor readings
        appear once a CSV export covering this period has been imported<%= ", either by you or by the daily email" if Climate::Settings.mailbox.present? %>.
      </p>
    <% else %>
      <div class="relative h-64 mb-6"><canvas data-climate-charts-target="temperature"></canvas></div>
      <div class="relative h-64 mb-6"><canvas data-climate-charts-target="humidity"></canvas></div>
      <div class="relative h-64"><canvas data-climate-charts-target="dewPoint"></canvas></div>
    <% end %>
  </div>
<% end %>

<%= render CollapsibleSectionComponent.new(title: "How this works", html_class: "mt-4") do %>
  <ul class="list-disc pl-5 space-y-2 text-gray-700">
    <li>
      <strong>How readings get here.</strong> Sensor readings arrive as a CSV export from the Govee
      app.
      <% if Climate::Settings.mailbox.present? %>
        A scheduled daily report goes to <code><%= Climate::Settings.mailbox %></code> and this site
        imports it on its own. <strong>That report is only ever as fresh as the last Bluetooth
        sync, though.</strong>
      <% end %>
      The crypt is out of Wi-Fi range, so the sensors can't reach Govee's cloud by themselves:
      stand in the dressing room with the app open and wait for it to connect.
      <%= "If nobody does, the daily email keeps arriving with nothing new in it." if Climate::Settings.mailbox.present? %>
    </li>
    <li>
      <strong>The margin here is measured against the air, not the walls.</strong> It's the crypt's
      air temperature minus its dew point. The walls are underground and colder than the air, so the
      real margin at the wall is smaller than the number shown. Treat it as optimistic until
      something measures a wall directly.
    </li>
    <li>
      <strong>When to open up.</strong> Compare the outside dew point with the temperature of the
      crypt walls, not the humidity figures. If the outside dew point is comfortably below the wall
      temperature, ventilating dries the crypt out. If it's above, you're pumping in air that will
      condense on cold stone, however dry it feels outside. A warm muggy day is the worst time to
      air out a basement, and a cold crisp one is the best. Relative humidity can't be compared
      between two places at different temperatures, but dew point can. That's what the third chart
      is for.
    </li>
    <li>
      <strong>A break in a line is missing data</strong>, not a flat reading. Lines are deliberately
      not drawn across a gap, because that would imply readings that aren't there.
    </li>
    <li>
      Each sensor keeps about 20 days of readings before overwriting them, so sync at least that
      often.
    </li>
    <li>
      Long ranges are averaged into wider buckets (hourly, then six-hourly, then daily) so a year
      of readings stays legible.
    </li>
    <li>
      Outside conditions come from
      <%= link_to Climate::OpenMeteoClient::ATTRIBUTION, Climate::OpenMeteoClient::ATTRIBUTION_URL,
                  class: "text-primary underline", rel: "noopener", target: "_blank" %>
      (<%= Climate::OpenMeteoClient::LICENCE %>), modelled for Bedlam's own location and shown as a
      dashed line.
    </li>
  </ul>
<% end %>
