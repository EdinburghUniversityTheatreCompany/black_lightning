<%= render(QuickActionsCardComponent.new) do %>
  <%= link_to "Cancel", new_admin_show_show_crew_import_path(@event), class: btn_classes(:secondary) %>
<% end %>

<% total = @import.rows.size %>
<%= render AlertComponent.new(type: :info) do %>
  <strong>Found <%= total %> row(s) to process for <%= @event.name %>.</strong>
  Review the categorization below and adjust decisions as needed.
<% end %>

<%= form_with url: confirm_admin_show_show_crew_imports_path(@event), method: :post, local: true do |f| %>
  <%= hidden_field_tag :cache_key, @cache_key %>

  <% if @existing_team_members.any? %>
    <%= render CardComponent.new(variant: :warning, flush: true) do |c| %>
      <% c.with_tools do %>
        <span class="text-base font-semibold flex-1">Already on Team (Review Required)</span>
        <%= render(BadgeComponent.new(type: :dark, html_class: "ml-2")) { @existing_team_members.size.to_s } %>
        <small class="ml-auto">These people are already on <%= @event.name %></small>
      <% end %>
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Team Member</th>
            <th>Current Position</th>
            <th>Import Position</th>
            <th style="width: 200px;">Decision</th>
          </tr>
        </thead>
        <tbody>
          <% @existing_team_members.each do |user_id, data| %>
            <tr>
              <td><%= data["user_name"] %></td>
              <td><span class="font-monospace"><%= data["current_position"] %></span></td>
              <td><span class="font-monospace"><%= data["new_position"] %></span></td>
              <td>
                <% { "skip" => "Skip (keep current)", "merge" => "Merge positions", "replace" => "Replace with new" }.each do |value, label| %>
                  <div class="form-check">
                    <%= radio_button_tag "existing_actions[#{user_id}]", value, value == "skip", class: "form-check-input", id: "existing_action_#{user_id}_#{value}" %>
                    <%= label_tag "existing_action_#{user_id}_#{value}", label, class: "form-check-label" %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <% { exact_match_id: "Matched by ID", exact_match_email: "Matched by Email" }.each do |bucket, title| %>
    <% items_not_on_team = @import.categorized[bucket].reject { |item| @existing_team_members.key?(item[:existing_user].id) } %>
    <% next if items_not_on_team.empty? %>
    <%= render CardComponent.new(variant: :success, flush: true) do |c| %>
      <% c.with_tools do %>
        <span class="text-base font-semibold flex-1"><%= title %></span>
        <%= render(BadgeComponent.new(type: :light, html_class: "ml-2")) { items_not_on_team.size.to_s } %>
        <small class="ml-auto">Will add to crew</small>
      <% end %>
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Import Name</th>
            <th>Existing User</th>
            <th>Position</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% items_not_on_team.each do |item| %>
            <tr class="table-success">
              <td><%= item[:row][:original_name] %></td>
              <td>
                <%= link_to item[:existing_user].name_or_email, admin_user_path(item[:existing_user]) %>
                <% if item[:match_type] %>
                  <br><small class="text-gray-500">Matched by <%= UserImport::MATCH_TYPE_LABELS[item[:match_type]] %></small>
                <% end %>
              </td>
              <td><span class="font-monospace"><%= item[:row][:position] %></span></td>
              <td>
                <input type="hidden" name="actions[<%= item[:index] %>]" value="link">
                <%= render(BadgeComponent.new(type: :success)) { "Will Add" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <% if @import.categorized[:fuzzy_match].any? %>
    <% items_not_on_team = @import.categorized[:fuzzy_match].reject { |item| item[:existing_users].all? { |u| @existing_team_members.key?(u.id) } } %>
    <% if items_not_on_team.any? %>
      <%= render CardComponent.new(variant: :warning, flush: true) do |c| %>
        <% c.with_tools do %>
          <span class="text-base font-semibold flex-1">Possible Matches (Review Required)</span>
          <%= render(BadgeComponent.new(type: :dark, html_class: "ml-2")) { items_not_on_team.size.to_s } %>
          <small class="ml-auto">Please decide for each row</small>
        <% end %>
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Import Data</th>
              <th>Possible Match(es)</th>
              <th>Position</th>
              <th style="width: 280px;">Decision</th>
            </tr>
          </thead>
          <tbody>
            <% items_not_on_team.each do |item| %>
              <tr>
                <td>
                  <strong><%= item[:row][:original_name] %></strong><br>
                  <% if item[:row][:email].present? %>
                    <small class="text-gray-500"><%= item[:row][:email] %></small>
                  <% end %>
                </td>
                <td>
                  <% item[:existing_users].each_with_index do |user, i| %>
                    <% years = @import.years_active_cache[user.id] %>
                    <%= link_to user.name_or_email, admin_user_path(user) %>
                    <small class="text-gray-500">(<%= format_years_active_label(years) %>)</small><br>
                    <small class="text-gray-500"><%= user.email %></small>
                    <% if i < item[:existing_users].size - 1 %>
                      <hr class="my-1">
                    <% end %>
                  <% end %>
                </td>
                <td><span class="font-monospace"><%= item[:row][:position] %></span></td>
                <td>
                  <% item[:existing_users].each_with_index do |user, i| %>
                    <%= import_choice(item[:index], "link_#{user.id}", "#{user.name_or_email} (#{format_years_active_label(@import.years_active_cache[user.id])})", checked: i.zero?) %>
                  <% end %>
                  <%= import_choice(item[:index], "create", "Different person (create new)") %>
                  <%= import_choice(item[:index], "skip", "Skip") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>
  <% end %>

  <% if @import.categorized[:create_new].any? %>
    <%= render CardComponent.new(variant: :primary, flush: true) do |c| %>
      <% c.with_tools do %>
        <span class="text-base font-semibold flex-1">New Users to Create</span>
        <%= render(BadgeComponent.new(type: :light, html_class: "ml-2")) { @import.categorized[:create_new].size.to_s } %>
        <small class="ml-auto">Will create and add to crew</small>
      <% end %>
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Position</th>
            <th style="width: 150px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @import.categorized[:create_new].each do |item| %>
            <tr>
              <td><%= item[:row][:original_name] %></td>
              <td>
                <% if item[:row][:email].present? %>
                  <span class="font-monospace"><%= item[:row][:email] %></span>
                  <% if item[:row][:student_id].present? && item[:row][:email] == "#{item[:row][:student_id]}@ed.ac.uk" %>
                    <br><small class="text-gray-500">(auto-generated)</small>
                  <% end %>
                <% else %>
                  <em class="text-gray-500">(will generate placeholder)</em>
                <% end %>
              </td>
              <td><span class="font-monospace"><%= item[:row][:position] %></span></td>
              <td>
                <%= import_choice(item[:index], "create", "Create & Add", checked: true) %>
                <%= import_choice(item[:index], "skip", "Skip") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <%= render CardComponent.new(flush: true) do |c| %>
    <% c.with_footer do %>
      <div class="flex justify-between">
        <%= link_to "Cancel", new_admin_show_show_crew_import_path(@event), class: btn_classes(:secondary) %>
        <%= f.submit "Confirm Import", class: btn_classes(:success) %>
      </div>
    <% end %>
  <% end %>
<% end %>
