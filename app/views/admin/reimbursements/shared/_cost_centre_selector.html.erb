<%# Each centre is a link keeping the page's other params. "All" (no param) is
    the default because CostCentre.default is arbitrary. Hidden with one centre. %>
<% if selectable_cost_centres.size > 1 %>
  <%= render "admin/reimbursements/shared/scope_selector", label: "Cost centre",
             options: [ nil, *selectable_cost_centres ].map { |centre|
               [ centre&.name || "All", { cost_centre: centre&.key, cost_centre_id: nil }, centre == selected_cost_centre ]
             } %>
<% end %>
