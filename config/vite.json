{
  "all": {
    "sourceCodeDir": "app/javascript",
    "watchAdditionalPaths": [
      "app/views/**/*",
      "app/components/**/*",
      "app/helpers/**/*",
      "config/initializers/**/*"
    ]
  },
  "development": {
    "autoBuild": true,
    "publicOutputDir": "vite-dev",
    "port": 3036
  },
  "test": {
    "autoBuild": true,
    "publicOutputDir": "vite-test",
    "port": 3037
  },
  "production": {
    "autoBuild": false,
    "publicOutputDir": "vite"
  }
}
