<%# Same Turbo Frame as show/preview — see show.html.erb for why the wizard
    renders inside a frame. %>
<%= turbo_frame_tag "reconcile" do %>
<% if @reconciliation_errors.present? %>
  <%= render AlertComponent.new(type: :warning) do %>
    <p>Reconciliation finished, but <%= @reconciliation_errors.size %>
      row<%= "s" unless @reconciliation_errors.size == 1 %> hit a problem; everything else below
      still committed. Check these before assuming the paste is fully applied:</p>
    <ul class="list-disc list-inside mt-1">
      <% @reconciliation_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= render AlertComponent.new(type: :success) do %>
    Reconciliation complete.
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Summary") do %>
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 text-center">
    <div>
      <div class="text-2xl font-semibold"><%= @expenses_paid %></div>
      <div class="text-sm text-gray-600">Expenses marked Paid</div>
    </div>
    <div>
      <div class="text-2xl font-semibold"><%= @offsets_linked %></div>
      <div class="text-sm text-gray-600">Offsetting pairs linked</div>
    </div>
    <div>
      <div class="text-2xl font-semibold"><%= @credits_linked %></div>
      <div class="text-sm text-gray-600">Credit rows linked to budgets</div>
    </div>
    <div>
      <div class="text-2xl font-semibold"><%= @unmatched_saved %></div>
      <div class="text-sm text-gray-600">Unmatched rows saved</div>
    </div>
    <div>
      <div class="text-2xl font-semibold"><%= @skipped_count %></div>
      <div class="text-sm text-gray-600">Already-imported rows skipped</div>
    </div>
  </div>
<% end %>

<%# Rows this paste deliberately did not import. Reported after the fact as
    well as in the preview, so the numbers in the summary above are never quietly
    smaller than the paste. %>
<% if @attribution.unrecognised_rows.any? %>
  <%= render AlertComponent.new(type: :info) do %>
    <%= pluralize(@attribution.unrecognised_rows.size, "row") %> were not imported:
    <%= "cost centre".pluralize(@attribution.unrecognised_codes.size) %>
    <strong><%= @attribution.unrecognised_codes.to_sentence %></strong>
    <%= @attribution.unrecognised_codes.size == 1 ? "is" : "are" %> not set up here.
  <% end %>
<% end %>

<% if @attribution.skipped_blank_rows.any? %>
  <%= render AlertComponent.new(type: :info) do %>
    <%= pluralize(@attribution.skipped_blank_rows.size, "row") %> with no cost centre
    <%= @attribution.skipped_blank_rows.size == 1 ? "was" : "were" %> skipped, as you chose.
  <% end %>
<% end %>

<p class="mt-2 text-sm text-gray-600">
  Producers whose expenses were marked Paid have been emailed a "you've been paid" note.
</p>

<div class="mt-4">
  <%= link_to "Reconcile another month", admin_reimbursements_reconciliation_path, class: btn_classes(:secondary) %>
</div>
<% end %>
