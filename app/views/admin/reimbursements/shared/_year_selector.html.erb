<%# Renders nothing until a second year exists (one year is not a choice). Each year is a
    link carrying the other query params, so a filter or CSV link survives the switch. %>
<% if selectable_financial_years.size > 1 %>
  <%= render "admin/reimbursements/shared/scope_selector", label: "Financial year",
             options: selectable_financial_years.map { |year|
               [ year.label, { year: year.key }, year == selected_financial_year ]
             } %>
<% end %>
