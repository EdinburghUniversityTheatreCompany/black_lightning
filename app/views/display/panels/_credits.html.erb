<%# locals: (event:, cast:, crew:, tonight:) %>
<%
  # A 90-seat house still puts up big casts. Shrink the type once the list gets
  # long rather than letting it run off a screen nobody can scroll.
  #
  # The two columns are independent, so the height actually needed is the LONGER
  # of them, not the total: a 12-cast/12-crew show uses half the space a
  # 24-cast/0-crew one does, and used to shrink exactly as hard.
  longest = [ cast.size, crew.size ].max
  # Row counts that fit the 739px the header leaves: 13 at text-5xl, 15 at
  # text-4xl, 16 at text-3xl, 18 at text-2xl. One row of headroom on each step,
  # so the type shrinks only when it has to.
  name_size = case longest
              when 0..12  then "text-5xl"
              when 13..14 then "text-4xl"
              when 15..16 then "text-3xl"
              else             "text-2xl"
              end
  # Centre the columns in the space they leave -- unless the list needs all of
  # it, in which case start at the top so a long cast loses its tail rather
  # than its "Cast" heading.
  block_position = longest > 16 ? "content-start" : "content-center"
%>
<div class="flex h-full w-full flex-col bg-neutral-950 px-16 py-12">
  <div class="mb-10 flex items-start justify-between gap-10">
    <div class="min-w-0">
      <p class="mb-3 text-3xl font-bold uppercase tracking-[0.3em] text-display-accent">
        <%= tonight ? "Tonight's Credits" : "Next Show's Credits" %>
      </p>
      <%# leading-descender pairs with truncate -- see display.css. %>
      <h1 class="truncate text-7xl font-bold leading-descender text-white"><%= event.name %></h1>
    </div>
    <%= display_logo %>
  </div>

  <div class="grid flex-1 grid-cols-2 gap-16 overflow-hidden <%= block_position %>">
    <div>
      <%# A heading with nothing under it reads as a broken page from across the
          room, and an all-crew or all-cast event is normal here. %>
      <% if cast.any? %>
        <h2 class="mb-5 text-3xl font-semibold uppercase tracking-widest text-neutral-500">Cast</h2>
      <% end %>
      <ul class="space-y-2">
        <% cast.each do |member| %>
          <li class="<%= name_size %> text-white">
            <span class="font-semibold"><%= member.user_name %></span>
            <span class="text-neutral-400"><%= member.cast_display_name %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div>
      <% if crew.any? %>
        <h2 class="mb-5 text-3xl font-semibold uppercase tracking-widest text-neutral-500">Company</h2>
      <% end %>
      <ul class="space-y-2">
        <% crew.each do |member| %>
          <li class="<%= name_size %> text-white">
            <span class="font-semibold"><%= member.user_name %></span>
            <span class="text-neutral-400"><%= member.position %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
