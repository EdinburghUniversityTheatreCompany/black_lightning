<%= render(QuickActionsCardComponent.new) do %>
  <%= link_to generate_icon_prefix('list', 'All Techies'), admin_techies_url, class: btn_classes(:secondary) %>
  <%= link_to generate_icon_prefix('tree', 'Tree'), tree_admin_techies_url, class: btn_classes(:secondary) %>
  <%= link_to generate_icon_prefix('user-group', 'Mass Add Techies'), mass_new_admin_techies_url, class: btn_classes(:secondary) %>
<% end %>

<%= render CardComponent.new(title: @title) do %>
  <% if @grouped_data.empty? && @grouped_no_year.empty? %>
    <p class="text-gray-500">No techies found.</p>
  <% else %>
    <% @grouped_data.each do |year, parent_groups| %>
      <div class="mb-4">
        <h3 class="text-primary"><%= year %></h3>
        <%= render "parent_groups", groups: parent_groups %>
      </div>
    <% end %>

    <% unless @grouped_no_year.empty? %>
      <div class="mb-4">
        <h3 class="text-secondary">No Entry Year</h3>
        <%= render "parent_groups", groups: @grouped_no_year %>
      </div>
    <% end %>
  <% end %>
<% end %>
