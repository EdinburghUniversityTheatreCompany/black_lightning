<%# locals: (event:) %>

<% schedule = Event::Schedule.for(event) %>
<% details = event.schedule_details %>

<% if schedule.kind != :none || details.any? %>
  <%= render CardComponent.new(title: schedule.kind == :none ? 'Details' : event.occurrence_label.pluralize) do %>
    <% if schedule.kind == :weekly %>
      <%# The Improverts. Listing forty Fridays says less than naming the pattern,
          and the next few dates are what somebody actually needs. %>
      <p class="font-medium">Every <%= schedule.weekday_name %> at <%= short_time(schedule.starts_at) %></p>

      <% upcoming = schedule.occurrences.select { |o| o.on_date >= Date.current }.first(4) %>
      <% if upcoming.any? %>
        <p class="mt-1 text-sm text-gray-500">
          Next: <%= upcoming.map { |o| date_span(o.on_date, nil) }.to_sentence %>
        </p>
      <% end %>
    <% elsif schedule.blocks.any? %>
      <ul class="divide-y divide-gray-200">
        <% schedule.blocks.each do |block| %>
          <% first = block.occurrences.first %>
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2">
            <span class="font-medium"><%= date_span(block.starts_on, block.ends_on, long: true) %></span>
            <span><%= time_span(first.starts_at, first.ends_at) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%# Collapsing a run into a range loses which night is the relaxed one, which
        is exactly what people scan this list for -- so the exceptions are named. %>
    <% if schedule.exceptions.any? %>
      <ul class="mt-3 space-y-1 text-sm">
        <% event.schedule_exception_lines.each do |label, dates| %>
          <li>
            <span class="font-medium"><%= label %>:</span>
            <%= dates.map { |date| date_span(date, nil, long: true) }.to_sentence %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if details.any? %>
      <p class="mt-3 text-sm text-gray-500"><%= details.to_sentence.upcase_first %>.</p>
    <% end %>
  <% end %>
<% end %>
