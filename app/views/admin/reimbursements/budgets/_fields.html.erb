<%# locals: (people:, name:, nominal_code:, budget_type:, initial_budget:, active:, owner_ids:, notes:, cost_centres: [], cost_centre_id: nil, areas: [], area_id: nil, owners_from_area: nil) %>
<%# Shared by new and edit. The cost centre picker shows on new only, and only
    with a choice to make. %>
<%# select:ready: the owners widget is built after an async import(), so a form
    opened with an area chosen would otherwise disable the fieldset and leave
    the widget looking live. %>
<div class="flex flex-col gap-4" data-controller="reimbursements-budget-area"
     data-action="select:ready->reimbursements-budget-area#areaChanged">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "shared/form/field", label: "Name", name: :name do %>
      <%= text_field_tag :name, name, class: input_classes %>
    <% end %>
    <%# A datalist, NOT a select: the curated codes are suggestions, and an
        unlisted code is legitimate. %>
    <%= render "shared/form/field", label: "Nominal code", name: :nominal_code,
          hint: (if nominal_code_suggestions.any?
                   "Start typing to pick from the codes finance maintains on Settings, " \
                     "or enter another."
                 end) do %>
      <%= text_field_tag :nominal_code, nominal_code, class: input_classes,
                         list: ("nominal-code-suggestions" if nominal_code_suggestions.any?),
                         autocomplete: "off" %>
      <% if nominal_code_suggestions.any? %>
        <datalist id="nominal-code-suggestions">
          <% nominal_code_suggestions.each do |code, label| %>
            <option value="<%= code %>"><%= label %></option>
          <% end %>
        </datalist>
      <% end %>
    <% end %>
    <%= render "shared/form/field", label: "Type", name: :budget_type do %>
      <%= select_tag :budget_type, options_for_select(::Reimbursements::Budget::TYPES, budget_type),
                     class: input_classes %>
    <% end %>
    <%= render "shared/form/field", label: "Initial budget (£)", name: :initial_budget do %>
      <%= number_field_tag :initial_budget, reimbursements_amount_value(initial_budget), step: "0.01", class: input_classes %>
    <% end %>
    <%# Before Area, which it narrows: the controller drops every option tagged
        with another centre. %>
    <% if cost_centres.size > 1 %>
      <%= render "shared/form/field", label: "Cost centre", name: :cost_centre_id do %>
        <%= select_tag :cost_centre_id,
                       options_from_collection_for_select(cost_centres, :id, :name, cost_centre_id),
                       class: input_classes,
                       data: { reimbursements_budget_area_target: "costCentre",
                               action: "change->reimbursements-budget-area#costCentreChanged" } %>
      <% end %>
    <% end %>
    <%= render "shared/form/field", label: "Area", name: :area_id,
          hint: "Leave blank for a standalone line like Contingency or payroll." do %>
      <%# A plain select, not Tom Select, to match the Type and Cost centre
          selects beside it. %>
      <%= select_tag :area_id,
            options_for_select(
              areas.map { |area| [ area.name, area.record_id, { data: { cost_centre_id: area.cost_centre_id } } ] },
              area_id
            ),
            include_blank: "No area", class: input_classes,
            data: { reimbursements_budget_area_target: "area",
                    action: "change->reimbursements-budget-area#areaChanged" } %>
    <% end %>
  </div>

  <label class="inline-flex items-center gap-2 text-sm text-gray-700">
    <%= check_box_tag :active, "1", active, class: checkbox_classes %>
    Visible to submitters
  </label>

  <% if owners_from_area %>
    <%# READ-ONLY: Budget#owners reads the area's owners while sync_owner_ids!
        writes the line's own rows, so an editable list would read one table and
        write another. Ownership is edited on the area. %>
    <div>
      <p class="<%= FormStyles::LABEL %>">Owners</p>
      <% owner_names = owners_from_area.owners.map { |person| person.name.presence || person.email } %>
      <p class="text-sm text-gray-700">
        <% if owner_names.any? %>
          Owned by <%= owner_names.to_sentence %>
        <% else %>
          <%= render(BadgeComponent.new(type: :warning, pill: true).with_content("No owner")) %>
        <% end %>
        (<%= link_to "edit on the area", edit_admin_reimbursements_area_path(owners_from_area.record_id),
              class: "text-primary underline" %>)
      </p>
      <% if owner_names.empty? %>
        <%# An area naming nobody switches sign-off OFF for every line under it
            (OwnerReview.gate_applies?). %>
        <p class="mt-1 text-sm text-warning">
          This area names nobody, so claims on this line skip budget-owner sign-off entirely.
        </p>
      <% end %>
    </div>
  <% else %>
    <%# Disabled by reimbursements-budget-area once an area is chosen, since the
        area's owners then apply. With JavaScript off the controller refuses the
        post instead. %>
    <fieldset data-reimbursements-budget-area-target="owners">
      <%# A fieldset because only a fieldset can disable its descendants, so the
          browser posts no owner_ids once an area is chosen. %>
      <%= render "shared/form/field", label: "Owners", name: :owner_ids,
            hint: "Everyone who owns this budget. A line placed in an area takes the " \
                  "area's owners instead." do %>
        <%# Only simple-select2: Tom Select copies classes onto its wrapper, which
            draws the box. select_tag emits no hidden empty field, so clearing
            everyone would post no owner_ids; it sits INSIDE the fieldset so a
            disabled fieldset drops it too. %>
        <%= hidden_field_tag "owner_ids[]", "", id: nil %>
        <%= select_tag :owner_ids,
              options_from_collection_for_select(
                people, :record_id, ->(person) { person.name.presence || person.email }, owner_ids
              ),
              multiple: true, class: "simple-select2",
              data: { placeholder: "Search people…" } %>
      <% end %>
    </fieldset>
    <%# aria-live on the notice, not the fieldset, so taking the list away is
        announced once. %>
    <p class="text-sm text-gray-700" hidden aria-live="polite"
       data-reimbursements-budget-area-target="notice">
      This line goes in an area, so it takes the area's owners. Set them on the area itself.
    </p>
  <% end %>

  <%= render "shared/form/field", label: "Notes", name: :notes do %>
    <%= text_area_tag :notes, notes, rows: 3, class: input_classes %>
  <% end %>
</div>
