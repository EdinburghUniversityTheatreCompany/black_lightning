<p class="mb-3 text-gray-600">
  <% if @expense.status == Reimbursements::Status::DRAFT %>
    Finish this draft and submit it below.
  <% else %>
    You can edit this claim while it's still waiting for review. Once the finance team
    picks it up, contact <%= reimbursements_contact_link %> for changes.
  <% end %>
</p>

<div data-controller="receipts-upload"
     data-receipts-upload-url-value="<%= admin_reimbursements_expense_receipts_path(@expense.record_id) %>">
  <%= render CardComponent.new(title: "Receipts") do %>
    <%= render "admin/reimbursements/shared/receipts_dropzone" %>
    <%= render "receipts_gallery", expense: @expense %>
  <% end %>
</div>

<%= render "form", form: @form, budgets: @budgets,
      url: admin_reimbursements_expense_path(@expense.record_id), method: :patch,
      show_receipt_input: false, current_status: @expense.status %>

<% if @expense.status == Reimbursements::Status::DRAFT %>
  <%# Its own button_to form, deliberately: the destroy route is the same URL as
      the update this page posts to, so a Delete button inside the edit form
      would rely on its _method=delete outranking the form's hidden
      _method=patch — and if that ever lost, the click would silently SAVE the
      draft and report success. One form, one method. %>
  <div class="-mt-2 mb-4 flex flex-wrap items-center gap-3">
    <%= button_to "Delete draft", admin_reimbursements_expense_path(@expense.record_id),
          method: :delete, class: btn_classes(:danger),
          form: { data: { turbo_confirm: "Delete this draft for good? This can't be undone." } } %>
    <p class="mb-0 text-sm text-gray-500">
      Discards this unsent draft entirely. Only you ever saw it.
    </p>
  </div>
<% end %>
