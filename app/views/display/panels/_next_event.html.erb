<%# locals: (event:, tonight:, on:) %>
<div class="relative h-full w-full overflow-hidden bg-neutral-950">
  <%= render "display/panels/artwork", event: event %>

  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/90 to-transparent px-16 pb-14 pt-48">
    <div class="flex items-end gap-14">
      <div class="min-w-0 flex-1">
        <% if tonight %>
          <%= display_label("Tonight", css_class: "mb-4") %>
        <% end %>

        <%= render "display/panels/title", event: event %>

        <%# whitespace-pre-line: display_when separates a run's two stretches with a newline. %>
        <p class="mt-8 whitespace-pre-line text-5xl font-semibold text-white"><%= display_when(event, on: on) %></p>

        <% if display_price(event).present? %>
          <p class="mt-3 text-4xl text-neutral-300"><%= display_price(event) %></p>
        <% end %>

        <%# Guard on the rendered text: markdown can be present and still show nothing. %>
        <% content_warnings = display_content_warnings(event.content_warnings) if tonight %>
        <% if content_warnings.present? %>
          <p class="mt-8 max-w-5xl text-3xl leading-snug text-amber-300">
            Content warnings: <%= content_warnings %>
          </p>
        <% end %>
      </div>

      <div class="shrink-0 text-center">
        <%= display_qr_code(display_booking_url(event)) %>
        <p class="mt-4 text-2xl uppercase tracking-widest text-neutral-200">Book</p>
      </div>
    </div>
  </div>
</div>
