<%= render "shared/back_link", text: "All cost centres", path: admin_reimbursements_settings_path %>

<%= simple_form_for @cost_centre, as: :cost_centre, url: admin_reimbursements_settings_path,
                    method: :post do |f| %>
  <%= render CardComponent.new(title: "New cost centre") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Create cost centre",
            cancel_path: admin_reimbursements_settings_path %>
    <% end %>

    <p class="mb-4 text-sm text-gray-600">
      Set the basics for a new cost centre (its name, EUSA code and the two mailboxes it uses).
      After you create it, you'll land on its settings page to add the EUSA recipient, nightly
      run-days and SharePoint destinations.
    </p>

    <%= f.input :name, placeholder: "e.g. Bedlam Termtime",
          hint: "A human-readable label for this cost centre. The URL slug is generated from it " \
                "unless you set one yourself under Advanced." %>

    <div class="grid gap-x-4 sm:grid-cols-2">
      <%= f.input :eusa_code, label: "EUSA cost-centre code", placeholder: "e.g. F40",
            hint: "The EUSA finance code this cost centre pays against. Must be unique." %>
    </div>

    <div class="grid gap-x-4 sm:grid-cols-2">
      <%= f.input :receive_mailbox, label: "Receive mailbox (email-in)" %>
      <%= f.input :send_mailbox, label: "Send-from mailbox (drafts)" %>
    </div>
    <p class="<%= FormStyles::HINT %> -mt-2 mb-4">
      Each mailbox must be added to the app's Exchange management scope before email-in and
      draft-sending will work. The setup steps for that are on the settings page after you create
      this cost centre.
    </p>

    <%= f.input :notification_email, label: "Notification email",
          placeholder: "finance@bedlamfringe.co.uk",
          hint: "This cost centre's own finance mailbox, which gets its nightly reminders. " \
                "Separate several addresses with semicolons. Required — a cost centre whose " \
                "reminders reach nobody leaves producers waiting with nothing on screen to " \
                "explain it." %>

    <%= render CollapsibleSectionComponent.new(title: "Advanced") do %>
      <%# required: false because the model derives the key from the name when it
          is blank. It is presence-validated, so simple_form would mark it
          required, and a required control inside this collapsed section is one
          the browser cannot focus — it silently refuses to submit the form. %>
      <%= f.input :key, label: "URL key (slug)", placeholder: "auto-generated from the name",
            required: false, wrapper_html: { class: "mb-0" },
            hint: "Leave blank to derive it from the name. If you set it, use lowercase letters, " \
                  "numbers and hyphens only (it appears in the settings URL and can't be changed " \
                  "here later)." %>
    <% end %>
  <% end %>
<% end %>
