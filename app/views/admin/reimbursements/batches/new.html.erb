<p class="mb-3 text-gray-600">
  Every Approved expense goes into one BACS request. The money path uses each expense's
  <strong>effective</strong> payee and bank details, so an invoice override pays the third party
  directly (flagged "→ third party" below). Processing creates a <strong>draft</strong> in
  <%= @cost_centre.send_mailbox %> for you to review and send. Nothing is emailed to EUSA
  automatically.
</p>

<% if @expenses.empty? %>
  <%= render AlertComponent.new(type: :info) do %>
    No approved expenses to batch. Approve some on
    <%# A link, not the name of a page to go and find: this and Review's
        Approved tab named each other in prose both ways. Carries the centre
        this build is for, so the queue on screen is the one that feeds it. %>
    <%= link_to "the Review queue", admin_reimbursements_review_path(cost_centre: @cost_centre.key),
                class: "text-primary underline" %> first.
  <% end %>
<% else %>
  <%= render CardComponent.new(title: "#{@expenses.size} #{'expense'.pluralize(@expenses.size)} (#{reimbursements_money(@total)})") do %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-gray-500 border-b border-gray-200">
          <tr>
            <th scope="col" class="py-1 pr-3">#</th>
            <th scope="col" class="py-1 pr-3">Payee</th>
            <th scope="col" class="py-1 pr-3">Bank details</th>
            <th scope="col" class="py-1 pr-3 text-right">Amount</th>
            <th scope="col" class="py-1 pr-3">Nominal</th>
            <th scope="col" class="py-1 pr-3">Budget</th>
            <th scope="col" class="py-1 pr-3">Description</th>
            <th scope="col" class="py-1 pr-3 text-right">Receipts</th>
          </tr>
        </thead>
        <tbody>
          <% @expenses.each do |expense| %>
            <tr class="border-b border-gray-100 align-top">
              <%# The preview is the screen whose job is checking, so each row
                  opens the claim it is about. %>
              <td class="py-1 pr-3">
                <%= link_to expense.auto_number,
                            edit_admin_reimbursements_expense_edit_path(expense.record_id),
                            class: "text-primary underline" %>
              </td>
              <td class="py-1 pr-3">
                <%= expense.effective_payee_name %>
                <% if expense.payee_override? %>
                  <%= render BadgeComponent.new(type: :warning, pill: true).with_content("→ third party") %>
                <% end %>
              </td>
              <%# The one screen that would otherwise print every payee's
                  account number on page load. %>
              <td class="py-1 pr-3">
                <%= render Admin::Reimbursements::BankDetailsComponent.new(
                      sort_code: expense.effective_sort_code,
                      account_number: expense.effective_account_number,
                      payee: expense.effective_payee_name) %>
              </td>
              <td class="py-1 pr-3 text-right"><%= reimbursements_money(expense.amount) %></td>
              <td class="py-1 pr-3"><%= expense.effective_nominal_code %></td>
              <td class="py-1 pr-3"><%= expense.budget&.display_name %></td>
              <td class="py-1 pr-3"><%= expense.description %></td>
              <td class="py-1 pr-3 text-right"><%= expense.receipt_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%= form_with url: admin_reimbursements_batches_path, method: :post do %>
    <%# Which pot this batch pays, carried in the FORM and not merely in the URL
        that drew it: #create re-resolves the centre from the request, and a POST
        carries no query string, so without this the submit arrived with nothing
        and bounced the operator straight back to History. %>
    <%= hidden_field_tag :cost_centre, @cost_centre.key %>
    <%= render CardComponent.new(title: "EUSA email", html_class: "mt-4") do |card| %>
      <% card.with_footer do %>
        <%= render "shared/form/actions", submit: "Create draft and process batch",
              cancel_path: admin_reimbursements_batches_path(cost_centre: @cost_centre.key),
              submit_html: { data: { turbo_confirm: "Create the EUSA draft and mark #{@expenses.size} " \
                                                    "#{'expense'.pluralize(@expenses.size)} as Submitted?" } },
              note: "Processing will: generate the xlsx, upload it and every receipt to SharePoint, " \
                    "create the EUSA draft (you send it manually), record the batch, mark these " \
                    "expenses Submitted, and email each producer that their expense was submitted." %>
      <% end %>

      <div class="flex flex-col gap-4">
        <div class="grid gap-4 sm:grid-cols-3">
          <%= render "shared/form/field", label: "BACS date", name: :bacs_date do %>
            <%= date_field_tag :bacs_date, @bacs_date, class: input_classes %>
          <% end %>
          <%= render "shared/form/field", label: "EUSA recipient", name: :eusa_recipient do %>
            <%= text_field_tag :eusa_recipient, @eusa_recipient, class: input_classes %>
          <% end %>
          <%= render "shared/form/field", label: "Your name (signature)", name: :sender_name do %>
            <%= text_field_tag :sender_name, @sender_name, class: input_classes %>
          <% end %>
        </div>

        <%= render "shared/form/field", label: "Subject", name: :eusa_subject do %>
          <%= text_field_tag :eusa_subject, @default_email.subject, class: input_classes %>
        <% end %>

        <%# PLAIN TEXT, not the rendered HTML. This field used to hand the
            operator the whole body — the generated claims table included — as
            editable markup, on the one message that asks EUSA to move money: a
            mistyped tag breaks the table EUSA reads, silently, and nothing in
            the portal would show it. The note replaces the opening paragraphs;
            the table, totals and sign-off stay generated. %>
        <%= render "shared/form/field", label: "Your message to EUSA", name: :eusa_note,
              hint: "Leave blank for the standard wording. Sent from #{@cost_centre.send_mailbox}; " \
                    "the claims table, total and sign-off are added below whatever you write." do %>
          <%= text_area_tag :eusa_note, params[:eusa_note], rows: 6, class: input_classes %>
        <% end %>

        <div class="rounded border border-gray-200 bg-gray-50 p-3">
          <p class="mb-2 text-sm font-medium">You can use these in your message</p>
          <dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[max-content_1fr]">
            <% ::Reimbursements::EusaEmailComposer::SUBSTITUTIONS.each do |key| %>
              <dt class="font-mono">{{<%= key %>}}</dt>
              <%# What it expands to FOR THIS BATCH, off the same derivation the
                  email uses, so the list cannot promise something the message
                  then does differently. %>
              <dd class="text-gray-600"><%= @substitutions[key] %></dd>
            <% end %>
          </dl>
          <p class="mt-2 mb-0 text-xs text-gray-500">
            Anything else in double braces is left exactly as you typed it, so a misspelt one
            shows up in the preview rather than leaving a hole in a sentence.
          </p>
        </div>

        <details class="rounded border border-gray-200 p-3">
          <summary class="cursor-pointer text-sm font-medium">Preview the whole email</summary>
          <div class="mt-3 overflow-x-auto rounded border border-gray-200 bg-white p-3 text-sm">
            <%# The standard email for THIS batch, so the operator can see what
                their note sits above rather than imagining it. %>
            <%# Safe by construction, not by assertion: the composer marks its
                own output html_safe, and the only operator-supplied part of it
                is escaped before it gets there. %>
            <%= @default_email.body_html %>
          </div>
        </details>
      </div>
    <% end %>
  <% end %>
<% end %>
