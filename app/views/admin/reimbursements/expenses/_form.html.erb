<%# locals: (form:, budgets:, url:, method:, show_receipt_input: true, current_status: nil) %>
<%# Receipt-first expense form. The Stimulus controller holds on to the picked
    receipt across a failed submit and drives the inline warnings; everything
    still works with JavaScript disabled (plain manual form). %>
<%# The primary/secondary buttons and the line beneath them adapt to what the
    submit actually DOES, which depends on the claim's current status:
      - new / editing a Draft: primary submits to finance, secondary keeps it a
        private draft.
      - editing a Pending claim: primary re-saves it in the queue, secondary
        WITHDRAWS it back to a draft (out of the queue) — so that one confirms. %>
<% editing_pending = current_status == Reimbursements::Status::PENDING %>
<%= simple_horizontal_form_for form, url: url, method: method,
      html: { multipart: true,
              data: { controller: "reimbursements-receipt",
                      action: "turbo:submit-end->reimbursements-receipt#submitEnd",
                      reimbursements_receipt_resubmit_value: form.errors.any?,
                      reimbursements_receipt_invoice_type_value: Reimbursements::Expense::TYPE_INVOICE,
                      reimbursements_receipt_international_method_value:
                        Reimbursements::Expense::PAYMENT_METHOD_INTERNATIONAL,
                      reimbursements_receipt_large_amount_threshold_value:
                        Reimbursements::ExpenseForm::LARGE_AMOUNT_THRESHOLD.to_i } } do |f| %>

  <% content_for :override_card_footer do %>
    <div class="form-actions flex flex-wrap items-center gap-2">
      <% if editing_pending %>
        <%= f.button :submit, "Save changes", class: btn_classes(:primary) %>
        <%= button_tag "Withdraw back to draft", type: :submit, class: btn_classes(:secondary),
              name: "reimbursements_expense_form[save_as_draft]", value: "1", formnovalidate: true,
              data: { turbo_confirm: "This takes your claim out of the finance team's queue. " \
                                     "It won't be reviewed or paid until you submit it again. Continue?" } %>
      <% else %>
        <%= f.button :submit, "Submit expense", class: btn_classes(:primary) %>
        <%= button_tag "Save as draft", type: :submit, class: btn_classes(:secondary),
              name: "reimbursements_expense_form[save_as_draft]", value: "1", formnovalidate: true %>
      <% end %>
      <%= link_to "Cancel", admin_reimbursements_expenses_path, class: btn_classes(:secondary) %>
    </div>
    <p class="mt-2 mb-0 text-sm text-gray-500">
      <% if editing_pending %>
        This claim is with the finance team. <strong>Save changes</strong> keeps it in the review
        queue; <strong>Withdraw back to draft</strong> takes it out until you submit it again.
      <% elsif current_status == Reimbursements::Status::DRAFT %>
        This claim is a draft. Only you can see it. <strong>Submit expense</strong> sends it to the
        finance team for review; <strong>Save as draft</strong> keeps it private.
      <% else %>
        <strong>Submit expense</strong> sends it to the finance team for review.
        <strong>Save as draft</strong> keeps it private to you until you're ready.
      <% end %>
    </p>
  <% end %>

  <%= render('shared/pages/form', f: f) do %>
    <% if show_receipt_input %>
      <%# With JS, the controller re-attaches the file the user picked and
          hides this. This is the no-JS / no-file-attached fallback. %>
      <% if form.errors.any? %>
        <p class="mb-4 rounded border border-warning/40 bg-warning/10 p-2 text-sm text-warning"
           role="status" aria-live="polite"
           data-reimbursements-receipt-target="reattachNotice">
          Please re-attach your receipt below. Check the errors above, then submit again.
        </p>
      <% end %>
      <%= f.input :receipts, as: :file, label: "Receipt / invoice", required: true,
            hint: "Upload the receipt or invoice first, then fill in the details below. PDF or " \
                  "photo, max 5 MB. Ask for a VAT receipt if you can: without one we have to " \
                  "deduct the full amount from your budget instead of the ex-VAT amount, so a " \
                  "VAT receipt is in your own interest.",
            input_html: { multiple: true,
                          accept: Reimbursements::ExpenseForm::RECEIPT_ACCEPT_ATTRIBUTE,
                          data: { reimbursements_receipt_target: "files",
                                  action: "change->reimbursements-receipt#stash" } } %>
      <%# The controller's status line sits in the input column, under the hint. %>
      <div class="flex flex-wrap -mt-2 mb-4">
        <div class="hidden md:block md:w-3/12 px-2"></div>
        <p class="w-full md:w-9/12 px-2 mb-0 text-sm text-gray-600" aria-live="polite"
           data-reimbursements-receipt-target="status"></p>
      </div>
    <% end %>

    <%= f.input :expense_type, label: "Type",
          collection: Reimbursements::Expense::SUBMITTER_TYPES, include_blank: false,
          hint: "Reimbursement pays you back for something you've already paid for. " \
                "Invoice pays the supplier directly, so it needs their bank details below.",
          input_html: { data: { reimbursements_receipt_target: "expenseType",
                                action: "change->reimbursements-receipt#typeChanged" } } %>

    <%= f.input :payment_method, label: "How is this paid?",
          collection: [ [ "UK bank account", Reimbursements::Expense::PAYMENT_METHOD_UK_BACS ],
                        [ "International (IBAN)", Reimbursements::Expense::PAYMENT_METHOD_INTERNATIONAL ] ],
          include_blank: false,
          hint: "Pick International to pay a bank outside the UK. EUSA fills in a separate " \
                "payment form for those, and needs an IBAN and BIC instead of a sort code.",
          input_html: { data: { reimbursements_receipt_target: "paymentMethod",
                                action: "change->reimbursements-receipt#paymentMethodChanged" } } %>

    <%# Each rail's amount fields are BOTH rendered and the server picks which is
        visible, so the form is right with JavaScript off and after a 422
        re-render.
        `required:` follows the ACTIVE rail, and the Stimulus controller moves
        the attribute when the rail changes. A hidden input carrying
        `required` makes the browser refuse to submit the whole form, silently:
        it reports an invalid control it cannot scroll to, so the Submit button
        simply does nothing. simple_form's `required:` wins over
        `input_html: { required: false }` — it emits `required="required"`
        either way — so the attribute has to be driven by the rail, not
        suppressed. %>
    <div data-reimbursements-receipt-target="ukAmount" class="<%= 'hidden' if form.international? %>">
      <%= f.input :amount, label: "Amount (£, incl. VAT)", required: !form.international?,
            hint: "What actually left your account, or the invoice total.",
            input_html: { inputmode: "decimal", required: false,
                          data: { rail_required: true, reimbursements_receipt_target: "amount",
                                  action: "input->reimbursements-receipt#checkAmount " \
                                          "input->reimbursements-receipt#checkVat" } } %>
      <%= f.input :amount_excl_vat, label: "Amount excl. VAT (£)", required: !form.international?,
            hint: "From the receipt. Only this comes out of your budget; equal to the total when no VAT is shown.",
            input_html: { inputmode: "decimal", required: false,
                          data: { rail_required: true, reimbursements_receipt_target: "amountExclVat",
                                  action: "input->reimbursements-receipt#checkVat" } } %>

      <%# Shown when the amounts already say VAT isn't itemised or the ack failed;
          both amount inputs toggle it live via checkVat, so it announces. %>
      <div data-reimbursements-receipt-target="vatWarning" role="status" aria-live="polite"
           class="<%= 'hidden' unless form.errors[:vat_acknowledged].any? || form.vat_missing? %> mb-3 rounded border border-warning/40 bg-warning/10 p-3">
        <p class="mb-1 text-sm">
          This receipt doesn't itemise VAT, so we have to deduct the
          <strong>full amount</strong> from your budget. With a VAT receipt we'd only
          deduct the ex-VAT amount, so it's worth asking the seller for one.
        </p>
        <%= f.input :vat_acknowledged, as: :boolean,
              label: "I understand, submit anyway (I'll ask for a VAT receipt next time it's possible)" %>
      </div>
    </div>

    <div data-reimbursements-receipt-target="internationalAmount"
         class="<%= 'hidden' unless form.international? %>">
      <%# Only the invoice figure is asked for, and there is no ex-VAT field: a
          foreign invoice carries no reclaimable UK VAT, so the whole amount
          hits the budget. The submitter knows what the invoice says and nothing
          about the rate EUSA's bank will get, so finance enters the GBP
          equivalent when they review it — and cannot approve without it. %>
      <%# Not marked required and carrying no rail_required: the picker opens on
          EUR and offers no blank, so it can never be submitted empty. simple_form
          also refuses include_blank: false on a required field. %>
      <%= f.input :foreign_currency, label: "Currency", required: false,
            collection: Reimbursements::Expense::FOREIGN_CURRENCIES, include_blank: false,
            hint: "The currency the invoice is in. EUSA's form states it, so their bank pays " \
                  "the supplier in it.",
            input_html: { required: false } %>
      <%= f.input :foreign_amount, label: "Amount, as printed on the invoice", required: form.international?,
            hint: "The invoice total in the currency above. Finance works out the pound " \
                  "equivalent when they review this, so you don't need to convert it.",
            input_html: { inputmode: "decimal", required: false, data: { rail_required: true } } %>
    </div>

    <%# Soft-block a large claim (a mistyped amount would otherwise skew a
        budget). Shown when the amount is already large or the ack failed;
        the amount input toggles it live via checkAmount. %>
    <div data-reimbursements-receipt-target="largeAmountWarning" role="status" aria-live="polite"
         class="<%= 'hidden' unless form.errors[:large_amount_acknowledged].any? || form.large_amount? %> mb-3 rounded border border-warning/40 bg-warning/10 p-3">
      <p class="mb-1 text-sm">
        That's a large claim. Please double-check the amount is right; a common slip is
        typing pence as pounds (e.g. 4999 instead of 49.99).
      </p>
      <%= f.input :large_amount_acknowledged, as: :boolean,
            label: "Yes, this amount is correct." %>
    </div>
    <%# Required to SUBMIT but optional for a draft. Show the required star so
        the star set matches what submit needs (they were unstarred, so a
        rushed user filled only the starred fields and hit surprise errors),
        but leave client-side enforcement off (input_html required: false) so
        the "Save as draft" path and server-side validation keep working. %>
    <%= f.input :budget_record_id, label: "Budget", required: true,
          collection: budgets.map { |b| [ b.display_name, b.record_id ] },
          include_blank: "Choose a budget…",
          hint: "Not sure? Pick the closest and mention it in the description.",
          input_html: { required: false } %>

    <%= f.input :description, label: "Description", hint: "What's it for?", required: true,
          input_html: { required: false } %>

    <%# The live character counter is part of the hint, so it sits under the
        field it counts rather than at the card edge. %>
    <%= f.input :payment_reference, label: "Payment reference", required: true,
          hint: safe_join([ "What EUSA puts on the bank transfer. Invoices usually specify one; " \
                            "otherwise the invoice number or a short label. ",
                            tag.span(data: { reimbursements_receipt_target: "referenceCounter" }) ]),
          input_html: { required: false, maxlength: Reimbursements::ExpenseForm::REFERENCE_LIMIT,
                        data: { reimbursements_receipt_target: "reference",
                                action: "input->reimbursements-receipt#updateCounter" } } %>

    <%# Always shown (not a collapsible): tucked in an accordion, whether a
        third-party payee was filled in was invisible at a glance — a
        money-path detail that should be obvious. The heading colours to
        signal when it's in use. %>
    <% overrides_filled = form.payee_name_override.present? || form.sort_code_override.present? || form.account_number_override.present? %>
    <% invoice_selected = form.expense_type == Reimbursements::Expense::TYPE_INVOICE %>
    <div class="mb-4 border-t <%= overrides_filled ? 'border-warning/50' : 'border-gray-200' %> pt-3">
      <h3 class="mb-1">
        Pay someone else
        <%# Server-rendered for the no-JS case and for a 422 re-render; the
            controller's typeChanged keeps it honest as the type select changes. %>
        <span data-reimbursements-receipt-target="payeeOptional"
              class="<%= 'hidden' if invoice_selected || form.international? %> font-normal text-gray-500">(optional)</span>
        <span data-reimbursements-receipt-target="payeeRequired"
              class="<%= 'hidden' unless invoice_selected %> font-normal text-warning">(required for an invoice)</span>
        <span data-reimbursements-receipt-target="payeeInternational"
              class="<%= 'hidden' unless form.international? %> font-normal text-warning">(required)</span>
        <% if overrides_filled %>
          <%= render BadgeComponent.new(type: :warning, pill: true).with_content("In use") %>
        <% end %>
      </h3>
      <%# Two variants rather than one branch: the rail can change in the browser
          after this renders, and a heading reading "(optional)" over fields the
          server will reject is worse than no hint at all. %>
      <p data-reimbursements-receipt-target="ukPayeeCopy"
         class="<%= 'hidden' if form.international? %> mb-4 text-sm text-gray-600">
        Fill this out when EUSA should pay a third party directly — which is what an
        <strong>Invoice</strong> means, so all three are required there. Leave all three blank
        to be reimbursed yourself.
      </p>
      <p data-reimbursements-receipt-target="internationalPayeeCopy"
         class="<%= 'hidden' unless form.international? %> mb-4 text-sm text-gray-600">
        An international payment goes straight to the payee's own bank, so their account name,
        IBAN and BIC are always required — there is nothing on file to fall back to.
      </p>
    </div>
    <%= f.input :payee_name_override, label: "Payee account name" %>
    <div data-reimbursements-receipt-target="ukFields" class="<%= 'hidden' if form.international? %>">
      <%= f.input :sort_code_override, label: "Payee sort code" %>
      <%= f.input :account_number_override, label: "Payee account number" %>
    </div>
    <div data-reimbursements-receipt-target="internationalFields"
         class="<%= 'hidden' unless form.international? %>">
      <%= f.input :iban_override, label: "Payee IBAN",
            hint: "As printed on the invoice. Spaces are fine — we check the IBAN's own " \
                  "check digits, so a mistyped one is caught here rather than by the bank." %>
      <%= f.input :bic_override, label: "Payee BIC / SWIFT code",
            hint: "8 or 11 characters, e.g. DEUTDEFF or DEUTDEFF500." %>
    </div>
  <% end %>
<% end %>
