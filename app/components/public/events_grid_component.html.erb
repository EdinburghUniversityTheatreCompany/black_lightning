<% if any_items? %>
  <div class="<%= grid_classes %>">
    <% @items.each do |item| %>
      <div class="flex flex-col">
        <%= render CardComponent.new(html_class: "h-full mb-0", flush: true) do %>
          <% url = url_for_item(item) %>
          <%= link_to url do %>
            <%= render "shared/image", image: item[:event].fetch_image, variant: helpers.medium_variant, proxy: true,
                       srcset_variants: [ helpers.thumb_variant_public, helpers.medium_variant, helpers.slideshow_variant ],
                       alt: "#{item[:event].name} at Bedlam Theatre", image_options: { class: "block w-full h-auto rounded-t" } %>
          <% end %>

          <div class="p-4 flex flex-col">
            <%= link_to(item[:event].name_and_author, url, class: "text-base font-semibold") %>

            <%= render("shared/pages/public/partials/card_paragraphs", paragraphs: item[:paragraphs]) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
