<%= render "shared/back_link", text: "All people", path: admin_reimbursements_people_path %>

<%# form_with OUTSIDE the CardComponent: the footer is a component SLOT, so a
    form opened inside the card renders its submit button outside the <form>
    and the button silently does nothing. %>
<%= form_with url: admin_reimbursements_people_path, method: :post do %>
  <%= render CardComponent.new(title: "Register a person") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Add to the registry",
            cancel_path: admin_reimbursements_people_path %>
    <% end %>

    <p class="mb-4 text-sm text-gray-600">
      Adds someone to the payee registry so they can be given a budget to own, without
      waiting for them to file a claim. No bank details are asked for here — a budget owner
      may never claim a penny, and someone who does claim enters their own details in the
      portal. They'll show as <strong>Unverified</strong> until they do.
    </p>

    <% if @error.present? %>
      <%= render AlertComponent.new(type: :danger) do %><%= @error %><% end %>
    <% end %>

    <%= render "shared/form/field", label: "User account", name: :user_id,
          hint: "Start typing a name. Only existing Black Lightning accounts can be " \
                "registered — if they haven't got one yet, they need to sign up first." do %>
      <%# Only `simple-select2`: Tom Select copies the select's classes onto its
          own wrapper, which already draws the box. Remote-sourced rather than a
          full list of options, because there are thousands of accounts. %>
      <%= select_tag :user_id, options_for_select([]),
            class: "simple-select2",
            include_blank: true,
            data: {
              remote_source: "/admin/users/autocomplete_list",
              show_non_members: "1",
              query_field: "q[full_name_cont]",
              placeholder: "Search by name...",
              minimum_input_length: "2"
            } %>
    <% end %>
  <% end %>
<% end %>
