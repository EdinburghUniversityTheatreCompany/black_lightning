<%# locals: () %>

<%= simple_horizontal_form_for [:admin, @mass_mail] do |f| %>
  <% content_for :extra_form_actions do %>
    <% if @mass_mail.persisted? %>
      <%= submit_tag :Send, name: 'send', class: btn_classes(:primary),
                    data: { turbo_confirm: "Send this mass mail to every member on its send date? " \
                                           "Once you confirm, it can no longer be edited or deleted." } %>
    <% end %>
  <% end %>

  <%= render('shared/pages/form', f: f) do %>
    <%= f.input :draft, as: :hidden %>
    <%= f.input :subject %>
    <%= f.input :send_date %>

    <%= render MdEditorComponent.new(f: f, field: :body, rows: 12 ) %>
  <% end %>
<% end %>
