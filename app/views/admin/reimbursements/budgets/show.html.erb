<% finance = can?(:manage, :reimbursements_finance) %>

<%= render "shared/back_link",
           text: finance ? "← All budgets" : "← My budgets",
           path: finance ? admin_reimbursements_budgets_path : admin_reimbursements_my_budgets_path %>

<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <p class="text-gray-600">
      <%= @budget.cost_centre&.name || "No cost centre" %>
      <% if @budget.financial_year %>· <%= @budget.financial_year.label %><% end %>
      <% if finance && @budget.nominal_code.present? %>· <%= @budget.nominal_code %><% end %>
    </p>
    <p class="text-gray-600">
      <% if @budget.owners.any? %>
        <%= "Owner".pluralize(@budget.owners.size) %>: <%= @budget.owners.map(&:name).to_sentence %>
      <% end %>
    </p>
  </div>
  <% if finance %>
    <%= link_to "Edit budget", edit_admin_reimbursements_budget_path(@budget.record_id),
                class: btn_classes(:primary, :sm) %>
  <% end %>
</div>

<%= render Admin::Reimbursements::SpendFiguresComponent.new(summary: @summary, finance: finance) %>

<%= render Admin::Reimbursements::AreaClaimsComponent.new(
             claims: @claims, counts: @claim_counts, tab: @claim_tab, finance: finance,
             budget: @budget, current_person: current_person) %>

<p class="mt-4 text-sm text-gray-500">
  Figures exclude VAT, so they can be lower than the amounts people claimed.
</p>
