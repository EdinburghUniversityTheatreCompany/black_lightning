<%# locals: (title:, members:, name_size:, spaced: false) %>
<%# A heading with nothing under it reads as broken, and an all-crew or all-cast
    event is normal. The break-* rules only bite in the flowed layout (second
    column): keep a heading with its names and never split a name. %>
<% if members.any? %>
  <h2 class="<%= "mt-8" if spaced %> mb-5 break-after-avoid text-3xl font-semibold uppercase tracking-widest text-neutral-500"><%= title %></h2>
  <ul class="space-y-2">
    <% members.each do |name, detail| %>
      <li class="<%= name_size %> break-inside-avoid text-white">
        <span class="font-semibold"><%= name %></span>
        <span class="text-neutral-400"><%= detail %></span>
      </li>
    <% end %>
  </ul>
<% end %>
