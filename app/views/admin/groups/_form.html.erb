<%# locals: () %>

<%= simple_horizontal_form_for [:admin, @group] do |f| %>
    <%= render("shared/pages/form", f: f) do %>
        <% name_disabled = Group.hardcoded_name?(@group.name) %>

        <%= f.input :name, readonly: name_disabled, hint: name_disabled ? "You cannot change the name of this group." : "" %>
        <%= f.hidden_field :name if name_disabled %>
        <% if current_user.admin? && @group.name != "Admin" %>
            <h3>Overlords</h3>
            <%= render("shared/form/sections/nested_fields", f: f, association_name: :parents, partial_name: "parent_fields") %>

            <h3>Underlings</h3>
            <%= render("shared/form/sections/nested_fields", f: f, association_name: :children, partial_name: "child_fields") %>
        <% end %>
    <% end %>
<% end %>
