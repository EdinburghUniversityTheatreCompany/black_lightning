<p class="mb-4 text-gray-600">
  The shows and budgets you are responsible for.
  <%# The owner meets "Left", "waiting" and "endorse" here and nowhere else,
      so the glossary has to be reachable from this page rather than only from
      the finance sidebar. %>
  <%= link_to "What the words mean", admin_reimbursements_glossary_path, class: "underline" %>.
</p>

<%= render CardComponent.new(title: "Waiting for your sign-off") do %>
  <% if @pending.empty? %>
    <%# Designed as the MAIN state, not an edge case: no claim has ever waited
        on an owner in production, so this is what this card normally says. %>
    <p class="text-gray-600">
      Nothing is waiting on you. When somebody claims against one of your budgets it appears
      here, and you'll be emailed a reminder until you endorse or reject it.
    </p>
  <% else %>
    <p class="mb-3 text-sm text-gray-600">
      Check the receipt, then <strong>Endorse</strong> a claim (any owner can, and a claim an owner
      submitted is cleared automatically), or <strong>Reject</strong> it with a reason if it looks
      wrong.
    </p>
    <div class="flex flex-col gap-3">
      <% @pending.each do |expense| %>
        <% endorsement = @endorsements_by_expense[expense.record_id] %>
        <% covered = endorsement && ::Reimbursements::OwnerReview.endorsement_covers?(endorsement, expense) %>
        <% auto_bypassed = ::Reimbursements::OwnerReview.submitter_owns_budget?(expense) %>
        <div class="rounded border border-gray-200 p-3">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-medium">#<%= expense.auto_number %>: <%= expense.effective_payee_name %></span>
            <span><strong><%= reimbursements_money(expense.amount) %></strong></span>
            <span class="text-sm text-gray-600"><%= expense.budget&.display_name %></span>
            <span class="text-sm text-gray-500">
              <%= reimbursements_waiting_for(expense.submitted_at) %>
            </span>
          </div>

          <% if expense.description.present? %>
            <p class="mt-1 text-sm text-gray-700"><%= expense.description %></p>
          <% end %>

          <div class="mt-2">
            <p class="text-xs font-medium text-gray-500">Receipt</p>
            <%# Opened per claim, so a long list of claims to endorse stays
                scannable and loads no receipts until one is asked for. %>
            <%= render "admin/reimbursements/shared/receipt_viewer",
                       receipts: expense.receipts, key: "my-budgets-#{expense.record_id}",
                       label: "expense ##{expense.auto_number}",
                       group: "my-budgets-#{expense.record_id}" %>
          </div>

          <div class="mt-3 flex flex-wrap items-start gap-2">
            <% if covered && endorsement.owner_endorsement? %>
              <%= render BadgeComponent.new(type: :success, pill: true)
                    .with_content("Endorsed by #{@people_by_id[endorsement.endorsed_by_person_id]&.name || 'an owner'}") %>
              <%= button_to "Withdraw",
                    admin_reimbursements_withdraw_my_budget_path(expense.record_id),
                    method: :delete, class: btn_classes(:secondary, :sm),
                    "aria-label": "Withdraw your endorsement of ##{expense.auto_number}",
                    form: { class: "inline-block",
                            data: { turbo_confirm: "Withdraw your endorsement of ##{expense.auto_number}? Finance won't be able to pay it until it's endorsed again." } } %>
            <% elsif covered && endorsement.finance_override? %>
              <span title="Finance approved this without an owner's endorsement.">
                <%= render BadgeComponent.new(type: :info, pill: true).with_content("Cleared by finance") %>
              </span>
            <% elsif auto_bypassed %>
              <span title="Submitted by an owner of this budget, so it's cleared automatically.">
                <%= render BadgeComponent.new(type: :secondary, pill: true).with_content("Submitted by an owner") %>
              </span>
            <% else %>
              <% if endorsement %>
                <p class="w-full text-sm text-warning">
                  This claim changed since it was endorsed. Re-check the amount and receipt before endorsing again.
                </p>
              <% end %>
              <%= button_to "Endorse",
                    admin_reimbursements_endorse_my_budget_path(expense.record_id),
                    method: :post, class: btn_classes(:success, :sm),
                    "aria-label": "Endorse claim ##{expense.auto_number} from #{expense.effective_payee_name}",
                    form: { class: "inline-block",
                            data: { turbo_confirm: "Endorse ##{expense.auto_number} for #{reimbursements_money(expense.amount)}? Finance can then pay it." } } %>
              <%= form_with url: admin_reimbursements_reject_my_budget_path(expense.record_id),
                            method: :patch, class: "flex items-center gap-2",
                            data: { turbo_confirm: "Reject ##{expense.auto_number} and email the submitter? This can't be undone." } do %>
                <%= text_field_tag :rejection_reason, nil, placeholder: "Reason for rejection",
                                   "aria-label": "Reason for rejecting claim ##{expense.auto_number}",
                                   class: input_classes(width: nil) %>
                <%= submit_tag "Reject", "aria-label": "Reject ##{expense.auto_number}", class: btn_classes(:danger, :sm) %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Your shows and budgets", html_class: "mt-4") do %>
  <% if @rows.empty? %>
    <p class="text-gray-600">
      <%# An owner signs off claims and watches a show's spending, so the empty state says what
          owning one means as well as who sets it. The Budgets page is finance-gated, so naming
          it to anybody else — as text or as a link — points at a 403. %>
      You don't own any budgets yet. An owner signs off claims against their show before finance
      pays them, and can see what it has spent.
      <% if can?(:manage, :reimbursements_finance) %>
        Budget owners are set on the
        <%= link_to "Budgets page", admin_reimbursements_budgets_path, class: "underline" %>,
        or on an area's own form for a line inside one.
      <% else %>
        Ask the business manager to add you as an owner of the budgets you are responsible for.
      <% end %>
    </p>
  <% else %>
    <div class="table-scroll">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-300 text-left text-gray-600">
            <th scope="col" class="px-3 py-2">Show or budget</th>
            <th scope="col" class="px-3 py-2 text-right">Budget</th>
            <th scope="col" class="px-3 py-2 text-right">Spent</th>
            <th scope="col" class="px-3 py-2 text-right">Waiting</th>
            <th scope="col" class="px-3 py-2 text-right">Left</th>
            <th scope="col" class="px-3 py-2"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <% figures = row[:summary] %>
            <tr class="border-b border-gray-200">
              <td class="px-3 py-2">
                <%= link_to row[:name], row[:path], class: "font-semibold" %>
                <% if row[:waiting_count].positive? %>
                  <span class="ml-1 rounded-full border border-amber-200 bg-amber-50 px-2 text-xs font-semibold text-warning">
                    <%= row[:waiting_count] %> waiting
                  </span>
                <% end %>
                <%# Two production areas are both called "Tech", so every row
                    says which pot and which year it belongs to. %>
                <div class="text-xs text-gray-500">
                  <%= [ row[:scope], row[:detail] ].reject(&:blank?).join(" · ") %>
                </div>
              </td>
              <td class="px-3 py-2 text-right tabular-nums">
                <% if figures.no_budget_set? %>
                  <span class="text-gray-500">not set</span>
                <% else %>
                  <%= reimbursements_money(figures.budget_amount) %>
                  <% if figures.from_lines? %>
                    <div class="text-xs font-normal text-gray-500">no total agreed; what its lines add up to</div>
                  <% end %>
                <% end %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums"><%= reimbursements_money(figures.spent) %></td>
              <td class="px-3 py-2 text-right tabular-nums"><%= reimbursements_money(figures.waiting) %></td>
              <td class="px-3 py-2 text-right tabular-nums">
                <% if figures.no_budget_set? %>
                  <span class="text-gray-500">no budget set</span>
                <% elsif figures.over? %>
                  <span class="text-danger"><%= reimbursements_money(figures.over_by) %> over</span>
                <% else %>
                  <%= reimbursements_money(figures.left) %>
                <% end %>
              </td>
              <td class="px-3 py-2 text-right whitespace-nowrap">
                <%= link_to "Open", row[:path], class: btn_classes(:secondary, :sm) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<p class="mt-4 text-sm text-gray-500">
  Figures exclude VAT, so they can be lower than the amounts people claimed.
</p>
