#!/bin/sh

# Make the local buildx builder use host networking, so builds resolve DNS through the host's
# live resolver.
#
# For a remote registry (Docker Hub) Kamal creates its builder on the isolated `bridge` network,
# and Docker writes that container's /etc/resolv.conf once, at creation, from the host's uplink DNS.
# When the laptop roams networks or toggles a VPN that nameserver goes stale and builds fail with
# `lookup registry-1.docker.io on 10.140.80.38:53: i/o timeout`. A host-networked builder resolves
# via systemd-resolved (127.0.0.53), which tracks the current network. Kamal does this itself only
# for a local registry (Kamal::Commands::Builder::Base#driver_options).
#
# Runs before Kamal inspects the builder, so a host-networked builder of this name is reused as-is.
# Build cache is kept: the builder is only recreated when missing or not host-networked.

builder="kamal-local-docker-container"

# Read the builder's stored driver options, not the container's NetworkMode: buildx creates the
# container lazily on first build, but records `network=host` on the builder from the start.
recreate=false
if ! info="$(docker buildx inspect "$builder" 2>/dev/null)"; then
  recreate=true
elif ! printf '%s\n' "$info" | grep -q 'network="host"'; then
  recreate=true
fi

if [ "$recreate" = true ]; then
  echo "pre-build: (re)creating buildx builder '$builder' with host networking (stable DNS across network/VPN changes)..."
  docker buildx rm "$builder" >/dev/null 2>&1 || true
  docker buildx create --name "$builder" --driver docker-container --driver-opt network=host >/dev/null 2>&1 \
    || echo "pre-build: warning: could not create host-networked builder; Kamal will create its own" >&2
fi

exit 0
