<p class="mb-3 text-gray-600">
  Review submitted expenses before they go to EUSA. Each card shows a live modulus
  check on the details the money will actually be paid to, plus any duplicate or override
  warnings. Fix anything that needs attention, then approve or reject.
</p>

<% awaiting_owner_total = @awaiting_owner.sum { |e| e.amount || 0 } %>
<% to_approve_total = @to_approve.sum { |e| e.amount || 0 } %>
<% approved_total = @approved.sum { |e| e.amount || 0 } %>

<%# Each link is a full page navigation (a different tab: query param), not a
    client-side toggle — role="tab"/"tablist" would claim arrow-key-navigable
    widget behavior these plain links don't have. aria-current="page" is the
    correct pattern for "which of these navigation links is the current one". %>
<nav aria-label="Review status" class="mb-4 flex gap-2 border-b border-gray-200">
  <% tab_class = ->(active) { active ? "border-b-2 border-primary font-medium text-primary px-3 py-2" : "px-3 py-2 text-gray-600" } %>
  <%# Awaiting owner sits first because it is the earlier step in the claim's
      life, not because it is the finance team's queue — "To approve" is, and it
      is the tab every link into this page lands on. %>
  <%= link_to "Awaiting owner (#{@awaiting_owner.size})", admin_reimbursements_review_path(tab: "awaiting_owner"),
              "aria-current": (@tab == "awaiting_owner" ? "page" : nil), class: tab_class.call(@tab == "awaiting_owner") %>
  <%= link_to "To approve (#{@to_approve.size})", admin_reimbursements_review_path(tab: "to_approve"),
              "aria-current": (@tab == "to_approve" ? "page" : nil), class: tab_class.call(@tab == "to_approve") %>
  <%= link_to "Approved (#{@approved.size})", admin_reimbursements_review_path(tab: "approved"),
              "aria-current": (@tab == "approved" ? "page" : nil), class: tab_class.call(@tab == "approved") %>
  <span class="ml-auto self-center pb-1">
    <%# ?tab= already rides along in the query parameters, so the download
        follows whichever tab is on screen. %>
    <%= link_to "Download CSV",
                admin_reimbursements_review_path(request.query_parameters.merge(format: :csv)),
                title: "The expenses on this tab", class: btn_classes(:secondary, :sm) %>
  </span>
</nav>

<% case @tab %>
<% when "approved" %>
  <% if @approved.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      No approved expenses yet. Work the To approve tab first.
    <% end %>
  <% else %>
    <p class="mb-3 text-gray-600">
      <%= @approved.size %> approved, total <%= reimbursements_money(approved_total) %>.
      Ready to submit on the Build Batch page.
    </p>
    <% @approved.each do |expense| %>
      <%= render "expense_card", expense: expense, allow_approve: false, duplicates: nil %>
    <% end %>
  <% end %>

<% when "awaiting_owner" %>
  <% if @awaiting_owner.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      Nothing is waiting on a budget owner.
    <% end %>
  <% else %>
    <p class="mb-3 text-gray-600">
      <%= @awaiting_owner.size %> awaiting a budget owner's sign-off,
      total <%= reimbursements_money(awaiting_owner_total) %>.
    </p>
    <%= render AlertComponent.new(type: :info) do %>
      These are with their budget owners, who endorse them on their own My Budgets page — they are
      not yours to approve yet. Each card names the owners. Where no owner can act (nobody holds a
      portal account, say), you can override the sign-off and approve it here; the override is
      recorded against your account. A claim on a budget with no owner never appears here — it goes
      straight to To approve.
    <% end %>
    <%# The bulk toolbar is deliberately NOT rendered here: bulk approve skips
        every gated claim, so a "0 approved" summary is all it could ever
        report. Overriding is a per-claim judgement with a reason attached. %>
    <% @awaiting_owner.each do |expense| %>
      <%= render "expense_card", expense: expense, allow_approve: true, duplicates: @duplicates[expense.record_id] %>
    <% end %>
  <% end %>

<% else %>
  <% if @to_approve.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      Nothing to approve.
      <% if @awaiting_owner.any? %>
        <%= link_to pluralize(@awaiting_owner.size, "claim"),
                    admin_reimbursements_review_path(tab: "awaiting_owner"),
                    class: "text-primary underline" %>
        <%= @awaiting_owner.one? ? "is" : "are" %> still with a budget owner.
      <% end %>
    <% end %>
  <% else %>
    <p class="mb-3 text-gray-600">
      <%= @to_approve.size %> to approve, total <%= reimbursements_money(to_approve_total) %>.
    </p>

    <div data-controller="bulk-review">
      <%# Bulk toolbar: tick expenses below, then approve or reject them together.
          The per-card checkboxes are wired to this form via form="bulk-review-form". %>
      <div class="mb-4 flex flex-wrap items-center gap-3 rounded border border-gray-200 bg-gray-50 p-3">
        <label class="flex items-center gap-2 text-sm font-medium">
          <%= check_box_tag "select_all", "1", false,
                            data: { bulk_review_target: "selectAll", action: "bulk-review#toggleAll" },
                            class: "h-4 w-4" %>
          Select all
        </label>
        <span class="text-sm text-gray-600" data-bulk-review-target="counter">0 selected</span>
        <%= form_with url: admin_reimbursements_bulk_approve_review_path(tab: @tab), method: :patch,
                      id: "bulk-review-form", class: "flex flex-wrap items-center gap-2" do %>
          <%= text_field_tag :rejection_reason, nil, placeholder: "Reason (required to reject)",
                             data: { bulk_review_target: "reason" },
                             class: input_classes(width: nil) %>
          <%= submit_tag "Approve selected",
                         formaction: admin_reimbursements_bulk_approve_review_path(tab: @tab),
                         data: { bulk_review_target: "approveButton" }, disabled: true,
                         class: btn_classes(:success, :sm) %>
          <%= submit_tag "Reject selected",
                         formaction: admin_reimbursements_bulk_reject_review_path(tab: @tab),
                         data: { bulk_review_target: "rejectButton", disable_with: false,
                                 turbo_confirm: "Reject the selected expenses and email each producer?" },
                         disabled: true, class: btn_classes(:danger, :sm) %>
        <% end %>
      </div>

      <h2 class="mt-4 mb-2 text-lg font-semibold">Ready to approve (<%= @ready.size %>)</h2>
      <% if @ready.empty? %>
        <%= render AlertComponent.new(type: :info) do %>
          Every claim on this tab needs attention before approving.
        <% end %>
      <% else %>
        <% @ready.each do |expense| %>
          <%= render "expense_card", expense: expense, allow_approve: true, selectable: true, duplicates: @duplicates[expense.record_id] %>
        <% end %>
      <% end %>

      <h2 class="mt-6 mb-2 text-lg font-semibold">Needs attention (<%= @attention.size %>)</h2>
      <% if @attention.empty? %>
        <%= render AlertComponent.new(type: :info) do %>
          None: everything on this tab is ready to approve.
        <% end %>
      <% else %>
        <%= render AlertComponent.new(type: :warning) do %>
          These have a data problem to fix before approving: a missing excl.-VAT amount, no budget,
          no receipts, invalid bank details, over budget, or a possible duplicate.
        <% end %>
        <% @attention.each do |expense| %>
          <%= render "expense_card", expense: expense, allow_approve: true, selectable: true, duplicates: @duplicates[expense.record_id] %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
