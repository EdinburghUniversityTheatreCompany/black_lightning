<%# locals: (event:, cast:, crew:, tonight:) %>
<%
  # Which of the two layouts this show gets, and how big the names may be --
  # the measured arithmetic lives in DisplayHelper, next to the pixel figures
  # it depends on.
  layout = display_credits_layout(cast.size, crew.size)
  name_size = layout[:name_size]
  # Flattened to name/detail pairs so one partial can render either list: the
  # two read the same on screen and differ only in where the second column of
  # text comes from.
  cast_members = cast.map { |member| [ member.user_name, member.cast_display_name ] }
  crew_members = crew.map { |member| [ member.user_name, member.position ] }
  # Say what is behind the code. display_programme_url falls back to the event's
  # own page when no programme has been linked, and "Scan for the digital
  # programme" over a QR that opens a listing is worse than no QR at all.
  qr_label = event.digital_programme_url.present? ? "Scan for the digital programme" : "Scan for more about this show"
%>
<%# Captured, not written out repeatedly: it goes under one column or the other,
    or under both, depending on the layout. %>
<% qr_block = capture do %>
  <%# mt-auto, not a fixed offset: for a short list this drops the QR to the
      foot of the column beside it, so the two end together rather than leaving
      it floating under three names. %>
  <div class="mt-auto flex items-center gap-6 pt-8">
    <%= display_qr_code(display_programme_url(event), css_class: "h-32 w-32", label: qr_label) %>
    <p class="text-3xl leading-snug text-neutral-300"><%= qr_label %></p>
  </div>
<% end %>
<div class="flex h-full w-full flex-col bg-neutral-950 px-16 py-12">
  <div class="mb-10 flex items-start justify-between gap-10">
    <div class="min-w-0">
      <p class="mb-3 text-3xl font-bold uppercase tracking-[0.3em] text-display-accent">
        <%= tonight ? "Tonight's Credits" : "Next Show's Credits" %>
      </p>
      <%# leading-descender pairs with truncate -- see display.css. %>
      <h1 class="truncate text-7xl font-bold leading-descender text-white"><%= event.name %></h1>
    </div>
    <%= display_logo %>
  </div>

  <% if layout[:mode] == :flowed %>
    <%# Both lists as one sequence, down the first column and on into the second,
        so a short cast beside a long company list stops wasting half the screen.
        The browser balances the two itself, which also absorbs a name long
        enough to wrap -- something the row arithmetic cannot see coming. %>
    <div class="columns-2 gap-16 overflow-hidden" style="height: <%= layout[:flow_height] %>px">
      <%= render "display/panels/credits_section", title: "Cast", members: cast_members, name_size: name_size %>
      <%= render "display/panels/credits_section", title: "Company", members: crew_members,
                 name_size: name_size, spaced: cast_members.any? %>
    </div>
    <%= qr_block %>
  <% else %>
    <div class="grid flex-1 grid-cols-2 gap-16 overflow-hidden <%= layout[:block_position] %>">
      <div class="flex flex-col">
        <%# Capped in pixels rather than by a Tailwind class: the figure is
            derived from the measured constants in DisplayHelper, and Tailwind
            never generates a class name that is only ever built at runtime. %>
        <div class="overflow-hidden" style="max-height: <%= layout[:cast_list_height] %>px">
          <%= render "display/panels/credits_section", title: "Cast", members: cast_members, name_size: name_size %>
        </div>
        <%= qr_block if layout[:qr_in_cast_column] %>
      </div>

      <div class="flex flex-col">
        <div class="overflow-hidden" style="max-height: <%= layout[:crew_list_height] %>px">
          <%= render "display/panels/credits_section", title: "Company", members: crew_members, name_size: name_size %>
        </div>
        <%= qr_block unless layout[:qr_in_cast_column] %>
      </div>
    </div>
  <% end %>
</div>
