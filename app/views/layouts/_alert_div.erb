<%# locals: () %>
<%# turbo:load fires only for visits, never after a 422 re-render, so show the flash at once
    when the bundle is loaded (Turbo re-runs body scripts on every render) and wait for
    turbo:load only on the first full page load. data-turbo-temporary keeps the script out of
    the snapshot cache, so back/forward cannot replay an old flash. %>
<script nonce="<%= request.content_security_policy_nonce %>" data-turbo-temporary>
  (function () {
    const flash = <%= flash_alerts_for_script.to_json.html_safe %>;
    if (Object.keys(flash).length === 0) return;

    if (window.showFlashAlerts) {
      window.showFlashAlerts(flash);
    } else {
      document.addEventListener('turbo:load', function () {
        window.showFlashAlerts(flash);
      }, { once: true });
    }
  })();
</script>
