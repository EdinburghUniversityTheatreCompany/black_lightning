<%= render "admin/reimbursements/shared/year_selector" %>
<%= render "admin/reimbursements/shared/cost_centre_selector" %>

<%= render "tabs" %>
<%# Scrolls to the line a save came back for (?budget=); see scroll_to_controller. %>
<div data-controller="scroll-to" data-scroll-to-param-value="budget" data-scroll-to-prefix-value="budget_"></div>

<%= render "admin/reimbursements/shared/glossary_terms",
           summary: "About these figures",
           intro: "Every budget line with its live financials. Only the initial figure is typed; " \
                  "the rest is computed.",
           terms: ::Reimbursements::Glossary.terms(:initial_budget, :projected, :committed,
                                                   :remaining, :expected_outturn,
                                                   :variance, :eusa_actual) %>

<p class="mb-3 flex flex-wrap gap-2">
  <%= link_to "New budget",
        new_admin_reimbursements_budget_path(**scope_params),
        class: btn_classes(:primary, :sm) %>
  <%# Both selectors carry through, so the import lands in the year and centre
      on screen. %>
  <%= link_to "Import budgets",
        admin_reimbursements_budget_import_path(year: selected_financial_year&.key,
                                                cost_centre: selected_cost_centre&.key),
        class: btn_classes(:secondary, :sm) %>
</p>

<div class="mb-2 flex items-center justify-between gap-3">
  <p class="text-sm text-gray-600"><%= pluralize(@budgets.size, "budget") %></p>
  <%= link_to "Download CSV",
              admin_reimbursements_budgets_path(request.query_parameters.merge(format: :csv)),
              class: btn_classes(:secondary, :sm) %>
</div>

<% if @budgets.empty? %>
  <%= render CardComponent.new(title: @title) do %>
    <p class="py-4 text-center text-gray-600">No budgets found.</p>
  <% end %>
<% else %>
  <%# [label, money?]: money columns are right-aligned to line up the pence. %>
  <% headers = [ [ "Budget" ], [ "Initial", true ], [ "Projected", true ], [ "Committed", true ],
                 [ "EUSA actual", true ], [ "Expected outturn", true ], [ "Remaining", true ],
                 [ "Variance", true ], [ "Owners" ], [ "" ] ] %>
  <%
    # Grouped off the scoped budgets, so an area shows only its in-scope lines, in the order
    # Budget.index_order put them. Area figures come off @areas_by_id, never budget.area (which
    # would N+1).
    budgets_by_area_id = @budgets.group_by { |budget| budget.area&.record_id }
    none_budgets = budgets_by_area_id.delete(nil) || []
    ordered_area_ids = budgets_by_area_id.keys
  %>
  <%= render "shared/pages/index_results",
        resources: @budgets, resource_class: ::Reimbursements::Budget,
        include_pagination: false,
        content: render("grouped_table", headers: headers, ordered_area_ids: ordered_area_ids,
                        budgets_by_area_id: budgets_by_area_id, none_budgets: none_budgets,
                        areas_by_id: @areas_by_id) %>
<% end %>
