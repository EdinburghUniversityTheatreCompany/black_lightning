<%# locals: (submit:, cancel_path: nil, cancel_turbo_frame: nil, note: nil, submit_html: {}) %>
<%# The button row for a form's card footer: primary submit, optional Cancel
    link, optional one-line note under them. submit_tag rather than f.submit
    because FormBuilder#submit IS submit_tag, so this works the same inside a
    simple_form block and needs no builder passed in. Inside a Turbo Frame, pass
    `cancel_turbo_frame: "_top"` when the Cancel target has no matching frame, or
    Turbo replaces the frame with "Content missing". %>
<div class="form-actions flex flex-wrap items-center gap-2">
  <%= submit_tag submit, class: btn_classes(:primary), **submit_html %>
  <% if cancel_path %>
    <%= link_to "Cancel", cancel_path, class: btn_classes(:secondary),
                data: { turbo_frame: cancel_turbo_frame }.compact %>
  <% end %>
</div>
<% if note.present? %>
  <p class="mt-2 mb-0 text-sm text-gray-500"><%= note %></p>
<% end %>
