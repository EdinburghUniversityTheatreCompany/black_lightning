<dialog id="pretix-modal"
        class="pretix-modal"
        data-controller="modal"
        data-action="click->modal#backdropClose"
        data-pretix-modal-target="dialog">
  <div class="pretix-modal-header">
    <h5 data-pretix-modal-target="title">Book Tickets</h5>
    <button type="button" class="pretix-modal-close" data-action="click->modal#close" aria-label="Close">&times; Close</button>
  </div>
  <%# The widget itself is created by pretix_modal_controller on each open: pretix replaces the
      <pretix-widget> element it builds, so it cannot be a long-lived element in this markup. %>
  <div class="pretix-modal-body" data-pretix-modal-target="widgetContainer"></div>
</dialog>
