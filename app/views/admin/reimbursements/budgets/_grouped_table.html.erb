<%# locals: (headers:, ordered_area_ids:, budgets_by_area_id:, none_budgets:, areas_by_id:, people_by_id:) %>
<div class="table-scroll">
  <%# table-pinned-actions: at 1366x768 the Edit column sat 87px off screen. %>
  <table class="table table-hover table-sticky-head table-pinned-actions"
         data-controller="sticky-table">
    <thead>
      <tr>
        <% headers.each do |header| %>
          <th scope="col"><%= header %></th>
        <% end %>
      </tr>
    </thead>
    <% ordered_area_ids.each do |area_id| %>
      <% area = areas_by_id[area_id] %>
      <% visible_count = budgets_by_area_id[area_id].size %>
      <%# area.budgets is preloaded (store.areas), so .size reads the loaded
          array, not a COUNT. It counts every line linked to the area, matching
          the figures beside it. %>
      <% total_count = area.budgets.size %>
      <tbody data-area="<%= area_id %>">
        <tr class="bg-gray-50">
          <th scope="rowgroup" colspan="<%= headers.size %>" class="text-left py-2">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <%= link_to area.name, admin_reimbursements_area_path(area.record_id),
                          class: "font-semibold text-base" %>
              <%# Only shown when some of the area's lines sit in another year or cost centre. %>
              <% if visible_count < total_count %>
                <span class="text-sm text-gray-500">
                  <%= visible_count %> of <%= pluralize(total_count, "line") %> shown
                </span>
              <% end %>
              <%# no_budget_set?, not projected_amount.nil?: a £0 total with
                  nothing allocated is unset, and "Agreed total (expenses) £0.00"
                  would read as a claim about expenses. %>
              <% unless area.no_budget_set? %>
                <span class="text-sm text-gray-600">
                  <%= area.basis_label %> <%= reimbursements_money(area.projected_amount) %>
                </span>
              <% end %>
              <span class="text-sm text-gray-600">
                Allocated <%= reimbursements_area_allocation(area) %>
                <% unless area.unallocated.nil? %>
                  &middot; <%= reimbursements_money(area.unallocated) %> not yet allocated
                <% end %>
              </span>
              <span class="text-sm text-gray-600">
                Committed <%= reimbursements_money(area.committed_amount) %>
              </span>
              <%# Nil when nobody agreed a total: left out, since £0.00 would
                  read as fully overspent. %>
              <% unless area.remaining.nil? %>
                <span class="text-sm <%= "text-danger font-medium" if area.remaining.negative? %>">
                  Remaining <%= reimbursements_money(area.remaining) %>
                </span>
              <% end %>
            </div>
          </th>
        </tr>
        <%= render partial: "admin/reimbursements/budgets/budget_row", collection: budgets_by_area_id[area_id],
              as: :budget, locals: { people_by_id: people_by_id } %>
      </tbody>
    <% end %>
    <% if none_budgets.present? %>
      <tbody data-area="none">
        <tr class="bg-gray-50">
          <th scope="rowgroup" colspan="<%= headers.size %>" class="text-left font-semibold py-2">
            Not in an area
          </th>
        </tr>
        <%= render partial: "admin/reimbursements/budgets/budget_row", collection: none_budgets,
              as: :budget, locals: { people_by_id: people_by_id } %>
      </tbody>
    <% end %>
  </table>
</div>
