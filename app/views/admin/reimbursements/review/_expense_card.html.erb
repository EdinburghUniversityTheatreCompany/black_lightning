<%#
  One editable expense card. Locals:
  - expense: Reimbursements::Expense
  - allow_approve: whether to show the Approve button (Pending only)
  - duplicates: array of possible-duplicate expenses, or nil
  - selectable: whether to show the bulk-select checkbox (Pending only; default false)
%>
<%# Nil unless the check applies — see ReviewSupport.modulus_result, which owns
    that rule so this banner and the Review summary cannot disagree. %>
<% modulus = ::Reimbursements::ReviewSupport.modulus_result(expense, modulus_checker) %>
<% selectable = local_assigns.fetch(:selectable, false) %>
<% attention = ::Reimbursements::ReviewSupport.attention_summary(expense, @budget_by_id, modulus_checker) %>
<%# The owner-endorsement gate is a distinct, overridable blocking reason (see
    OwnerReview) — kept out of ReviewSupport so that stays pure/AR-free. %>
<% owner_gate_unmet = @owner_gate_unmet_ids&.include?(expense.record_id) %>
<% endorsement = @endorsements_by_expense&.[](expense.record_id) %>
<% endorsement_covers = endorsement && ::Reimbursements::OwnerReview.endorsement_covers?(endorsement, expense) %>
<% owners = expense.budget&.owner_ids.to_a.filter_map { |id| @people_by_id&.[](id) }.presence %>
<% attention_reasons = attention[:blocking] + attention[:advisory] %>
<%# The finance override control is drawn only when the owner gate is the ONLY
    thing in the way (see the Approve/Reject block below). A card blocked on
    something else promised an override that was not on the page. %>
<% override_offered = allow_approve && owner_gate_unmet && attention[:blocking].empty? %>

<%# review-decision guards the Approve/Reject/override buttons against dropping
    unsaved edits typed into the Save form below (which is a separate <form>). See
    review_decision_controller.js. Progressive enhancement: with JS off the
    buttons keep their server default. %>
<%# id + scroll-mt: every Review action redirects back with #expense-<id>, so
    the operator lands on the card they acted on rather than at the top of an
    unpaginated queue. The margin clears the admin layout's sticky header,
    which the browser would otherwise park the card underneath. %>
<div id="expense-<%= expense.record_id %>" class="mb-3 scroll-mt-20 rounded border border-gray-200 p-3"
     data-controller="review-decision">
  <%# Claim details on the left, the receipt beside them on the right: checking a
      claim means reading a figure on the document against the figure in the form,
      dozens of times in a sitting, which two browser tabs make needlessly hard.
      The columns stack on narrow screens, where side by side would squeeze both.

      Only a claim that HAS a receipt gets the second column. With no receipt
      there is no document to read beside the form, so a side column would
      reserve two fifths of the card, stretched to the full height of the
      details, for an attach button — and receiptless claims sort into Needs
      attention, i.e. the bottom of the queue, which is where that empty block
      was showing up. items-start keeps the columns at their own heights so the
      divider ends with the receipts rather than ruling a line down blank space.

      The content below is deliberately NOT re-indented into these two wrappers:
      two levels of indentation would rewrite every line of the card for no
      behaviour change and bury the next real diff. %>
  <% has_receipts = expense.receipts.any? %>
  <div class="flex flex-col gap-4<%= " lg:flex-row lg:items-start" if has_receipts %>">
  <div class="min-w-0 lg:flex-1">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <% if selectable %>
      <%# data-flagged feeds the bulk toolbar's Approve confirm, which warns
          how many selected cards are flagged before a bulk approval fires. %>
      <%= check_box_tag "expense_ids[]", expense.record_id, false,
                        id: "select_#{expense.record_id}", form: "bulk-review-form",
                        "aria-label": "Select ##{expense.auto_number} for bulk actions",
                        data: { bulk_review_target: "checkbox", action: "bulk-review#refresh",
                                flagged: attention_reasons.any? || owner_gate_unmet },
                        class: "h-4 w-4" %>
    <% end %>
    <span class="font-medium">
      #<%= expense.auto_number %>:
      <%# The payee's own registry row, where bank details and verification are
          fixed — the weekly route into People was a card telling you to go
          there in plain text. %>
      <% if expense.person&.record_id.present? %>
        <%= link_to expense.person.name.presence || "(no name)",
                    admin_reimbursements_people_path(person: expense.person.record_id,
                                                     anchor: "person-#{expense.person.record_id}"),
                    class: "text-primary underline" %>
      <% else %>
        (no payee)
      <% end %>
      <span class="text-gray-500">(<%= expense.person&.email.presence || "no email" %>)</span>
    </span>
    <%# Which kind of claim this is. Without it an Invoice — EUSA paying a
        supplier direct — renders exactly like a reimbursement. %>
    <%= render BadgeComponent.new(type: :secondary, pill: true).with_content(expense.expense_type) %>
    <% if expense.international? %>
      <%# The foreign figure comes first: it is what the submitter entered and
          what EUSA's form will say. The GBP amount beside it is finance's own
          estimate, and is blank until they enter it. The label follows the
          claim's own TYPE — an international reimbursement is not an invoice. %>
      <span><%= expense.expense_type == Reimbursements::Expense::TYPE_INVOICE ? "Invoice" : "Claimed" %>:
        <strong><%= reimbursements_payment_amount(expense) %></strong></span>
      <span>Amount: <strong><%= reimbursements_money(expense.amount) %></strong> GBP</span>
      <%# The IBAN/Missing badge the helper already renders for this rail. Left
          off, every international card showed no bank signal at all — the one
          thing this queue exists to check. %>
      <span class="flex items-center gap-1">Bank: <%= reimbursements_effective_modulus_badge(expense, checker: modulus_checker) %></span>
      <%= render BadgeComponent.new(type: :info, pill: true).with_content("International") %>
    <% else %>
      <span>Amount: <strong><%= reimbursements_money(expense.amount) %></strong></span>
      <% if expense.amount_excl_vat.nil? %>
        <%= render BadgeComponent.new(type: :warning, pill: true).with_content("Excl. VAT not set") %>
      <% else %>
        <span>Excl. VAT: <strong><%= reimbursements_money(expense.amount_excl_vat) %></strong></span>
      <% end %>
      <span class="flex items-center gap-1">Bank: <%= reimbursements_effective_modulus_badge(expense, checker: modulus_checker) %></span>
    <% end %>
    <span>Receipts: <%= expense.receipt_count %></span>
    <%# How long the producer has been waiting: the first thing asked of a claim
        in the queue, and what the nightly stale-Pending reminder chases on. %>
    <span class="text-gray-500">Submitted <%= reimbursements_date(expense.submitted_at) %></span>
    <%= render BadgeComponent.new(type: Reimbursements::Status.badge_variant(expense.status), pill: true).with_content(expense.status) %>
    <% if attention[:blocking].any? %>
      <%= render BadgeComponent.new(type: :danger, pill: true).with_content("Can't approve yet") %>
    <% elsif owner_gate_unmet %>
      <%= render BadgeComponent.new(type: :warning, pill: true).with_content("Awaiting owner sign-off") %>
    <% elsif attention[:advisory].any? %>
      <%= render BadgeComponent.new(type: :warning, pill: true).with_content("Check before approving") %>
    <% end %>
    <%# Positive confirmation the owner gate is met, so finance can see a claim
        WAS endorsed (and, after an edit re-opens it, that it no longer is). %>
    <% if endorsement_covers && endorsement.owner_endorsement? %>
      <%= render BadgeComponent.new(type: :success, pill: true)
            .with_content("Endorsed by #{@people_by_id&.[](endorsement.endorsed_by_person_id)&.name || 'an owner'}") %>
    <% elsif endorsement_covers && endorsement.finance_override? %>
      <%= render BadgeComponent.new(type: :info, pill: true).with_content("Owner sign-off overridden") %>
    <% end %>
  </div>

  <%# Reasons inline (not behind a click) so an operator scanning the queue
      reads them at a glance, with blocked (fix-first) clearly separated from
      advisory (approval still proceeds). %>
  <% if attention[:blocking].any? || attention[:advisory].any? || owner_gate_unmet %>
    <div class="mt-2 flex flex-col gap-1 text-sm">
      <% if attention[:blocking].any? %>
        <p class="text-danger">
          <span class="font-medium">Can't approve until fixed:</span>
          <%= attention[:blocking].join(", ") %>.
        </p>
      <% end %>
      <% if owner_gate_unmet %>
        <p class="text-warning">
          <span class="font-medium">Awaiting a budget owner's endorsement</span>
          (blocks approval until signed off or overridden).
          <%= reimbursements_waiting_since(expense.submitted_at) %>
          <% if owners %>
            <%# Each owner's address as a mailto, so chasing one is a click
                rather than a search through People. %>
            <% owner_links = owners.map do |owner|
                 label = owner.name.presence || owner.email.presence || "an owner"
                 owner.email.present? ? link_to(label, "mailto:#{owner.email}", class: "underline") : label
               end %>
            <%= safe_join(owner_links, ", ") %>
            <%= owners.one? ? "owns" : "own" %> the
            <%= link_to expense.budget.display_name,
                        edit_admin_reimbursements_budget_path(expense.budget.record_id),
                        class: "underline" %>
            budget and can sign off from My Budgets.
          <% end %>
          <%# The override is only drawn when nothing else blocks approval, so
              promising it otherwise sent the operator looking for a button
              that is not there. %>
          <% if override_offered %>
            Or use the finance override below.
          <% elsif attention[:blocking].any? %>
            Fix the blocking problem above first: the finance override only covers the owner sign-off.
          <% end %>
        </p>
      <% end %>
      <% if attention[:advisory].any? %>
        <p class="text-warning">
          <span class="font-medium">Check before approving:</span>
          <%= attention[:advisory].join(", ") %>
          <span class="text-gray-500">(approval still goes through)</span>.
        </p>
      <% end %>
    </div>
  <% end %>

  <%# --- Warnings --- %>
  <% if expense.payee_override? %>
    <div class="mt-2"><%= render AlertComponent.new(type: :warning) do %>
      Direct payment to <strong><%= expense.effective_payee_name %></strong>
      (not the submitter <%= expense.person&.name %>), paying
      <% if expense.international? %>
        IBAN <strong><%= Reimbursements::BankDetails.format_iban(expense.effective_iban) %></strong>
        (BIC <strong><%= expense.effective_bic %></strong>)
      <% else %>
        <%= render Admin::Reimbursements::BankDetailsComponent.new(
              sort_code: expense.effective_sort_code,
              account_number: expense.effective_account_number,
              payee: expense.effective_payee_name) %>
      <% end %>.
      Confirm these match the invoice before approving.
    <% end %></div>
  <% end %>

  <%# The two places either fix can be made, as links rather than as the names
      of screens to go and find. %>
  <% fix_links = capture do %>
    Fix the <%= link_to "payee override", edit_admin_reimbursements_expense_edit_path(expense.record_id),
                        class: "underline" %>
    <% if expense.person&.record_id.present? %>
      or <%= link_to "#{expense.person.name.presence || 'their'} People record",
                     admin_reimbursements_people_path(person: expense.person.record_id,
                                                      anchor: "person-#{expense.person.record_id}"),
                     class: "underline" %>
    <% else %>
      (this claim names no payee, so there is no People record to fix)
    <% end %>
  <% end %>

  <% if modulus == Reimbursements::ModulusCheck::INVALID %>
    <div class="mt-2"><%= render AlertComponent.new(type: :danger) do %>
      Modulus check failed for the effective sort code + account number. Likely a typo:
      <%= fix_links %> before approving.
    <% end %></div>
  <% end %>

  <% unless expense.effective_has_bank_details? %>
    <div class="mt-2"><%= render AlertComponent.new(type: :danger) do %>
      <% if expense.international? %>
        No IBAN and BIC on file for this payee, so there is nothing to put on EUSA's
        international payment form. <%= fix_links %>.
      <% else %>
        No bank details on file for this payee. <%= fix_links %>.
      <% end %>
    <% end %></div>
  <% end %>

  <% if expense.budget.nil? || expense.budget.record_id.blank? %>
    <div class="mt-2"><%= render AlertComponent.new(type: :danger) do %>
      No budget linked. Pick one below before approving.
    <% end %></div>
  <% end %>

  <% if duplicates.present? %>
    <div class="mt-2"><%= render AlertComponent.new(type: :warning) do %>
      Possible duplicate of
      <%# The named claim, opened where it can be compared and fixed. %>
      <%= safe_join(duplicates.map { |d|
            link_to("##{d.auto_number}", edit_admin_reimbursements_expense_edit_path(d.record_id),
                    class: "underline") }, ", ") %>:
      same payee and amount within 30 days. Check this isn't a double-submission.
    <% end %></div>
  <% end %>

  <%# --- Edit (Save) --- %>
  <%= form_with url: admin_reimbursements_save_review_path(expense.record_id, tab: @tab),
                method: :patch, class: "mt-3 grid gap-3 sm:grid-cols-2",
                data: { review_decision_target: "editForm" } do %>
    <%# The fx-rate controller shows the rate the typed pair implies, so the
        arithmetic finance was doing in their head is on the form. It knows no
        real rate and claims none — see the controller. %>
    <%= tag.div(reimbursements_fx_rate_data(expense)) do %>
      <%= label_tag "amount_#{expense.record_id}", "Amount (GBP)", class: FormStyles::LABEL %>
      <% if expense.international? %>
        <p class="mb-1 text-sm text-gray-600">
          What <%= reimbursements_payment_amount(expense) %> is expected to cost in pounds.
          The budget counts this figure, and reconciliation later corrects it to the rate the
          bank actually charged. It has to be filled in before the claim can be approved.
          <%= reimbursements_fx_converter_link(expense) %>
        </p>
      <% end %>
      <%= number_field_tag :amount, reimbursements_amount_value(expense.amount), step: 0.01, min: 0, id: "amount_#{expense.record_id}",
                           class: input_classes,
                           data: (expense.international? ? { fx_rate_target: "amount", action: "input->fx-rate#render" } : {}) %>
      <% if expense.international? %>
        <p class="mt-1 mb-0 text-sm text-gray-600" data-fx-rate-target="output" aria-live="polite"></p>
      <% end %>
    <% end %>
    <div>
      <%# A foreign invoice carries no reclaimable UK VAT, so ex-VAT follows the
          gross automatically and asking for it would invite a deduction nobody
          can claim. %>
      <%= label_tag "amount_excl_vat_#{expense.record_id}", "Amount excl. VAT (GBP)", class: FormStyles::LABEL %>
      <%= number_field_tag :amount_excl_vat, reimbursements_amount_value(expense.amount_excl_vat), step: 0.01, min: 0, id: "amount_excl_vat_#{expense.record_id}",
                           class: input_classes %>
    </div>
    <div class="sm:col-span-2">
      <%= label_tag "description_#{expense.record_id}", "Description", class: FormStyles::LABEL %>
      <%= text_area_tag :description, expense.description, id: "description_#{expense.record_id}", rows: 2,
                        class: input_classes %>
    </div>
    <div>
      <%= label_tag "payment_reference_#{expense.record_id}", "Payment reference", class: FormStyles::LABEL %>
      <%= text_field_tag :payment_reference, expense.payment_reference, id: "payment_reference_#{expense.record_id}",
                         maxlength: Reimbursements::ExpenseForm::REFERENCE_LIMIT,
                         class: input_classes %>
    </div>
    <div>
      <%= label_tag "budget_record_id_#{expense.record_id}", "Budget", class: FormStyles::LABEL %>
      <% budget_options = @budgets.map { |b| [ b.picker_label, b.record_id ] } %>
      <% if expense.budget && expense.budget.record_id.present? && budget_options.none? { |_, id| id == expense.budget.record_id } %>
        <% budget_options.unshift([ expense.budget.picker_label, expense.budget.record_id ]) %>
      <% end %>
      <%= select_tag :budget_record_id,
                     options_for_select(budget_options, expense.budget&.record_id),
                     include_blank: expense.budget&.record_id.blank?,
                     id: "budget_record_id_#{expense.record_id}",
                     class: input_classes %>
      <% if expense.budget&.record_id.present? %>
        <p class="<%= FormStyles::HINT %>">
          <%= link_to "Open #{expense.budget.display_name}",
                      edit_admin_reimbursements_budget_path(expense.budget.record_id),
                      class: "text-primary underline" %>
        </p>
      <% end %>
    </div>
    <div>
      <%= label_tag "nominal_code_override_#{expense.record_id}", "Nominal code override", class: FormStyles::LABEL %>
      <%= text_field_tag :nominal_code_override, expense.nominal_code_override, id: "nominal_code_override_#{expense.record_id}",
                         placeholder: "blank = use budget default",
                         class: input_classes %>
      <p class="<%= FormStyles::HINT %>">Effective nominal: <%= expense.effective_nominal_code.presence || "-" %></p>
    </div>
    <div class="sm:col-span-2">
      <%= submit_tag "Save changes", "aria-label": "Save changes to ##{expense.auto_number}",
                     class: btn_classes(:primary, :sm) %>
    </div>
  <% end %>

  <%# --- Approve / Reject --- %>
  <div class="mt-3 flex flex-wrap items-start gap-2">
    <% if allow_approve %>
      <% if attention[:blocking].any? %>
        <%# Blocking reasons are a hard server-side refusal, so a clickable
            "Approve anyway?" would only bounce — disable it and let the red
            badge + inline reasons say why. %>
        <%= button_to "Approve", "#", method: :patch, disabled: true,
                      "aria-label": "Approve ##{expense.auto_number} (blocked: #{attention[:blocking].join(', ')})",
                      class: "#{btn_classes(:success, :sm)} opacity-50 cursor-not-allowed" %>
      <% elsif owner_gate_unmet %>
        <%# The owner gate is the only hard block. Finance can't plain-approve,
            but CAN override the owner sign-off — recorded as who overrode, with
            an optional reason. The confirm states the consequence and names any
            advisory flags, so overriding a flagged claim keeps the same misclick
            safeguard the normal Approve has. Use only when no owner can act. %>
        <% override_confirm = "Approve ##{expense.auto_number} without an owner's sign-off? " \
             "This is recorded against your account. Use it only when no owner can sign off (e.g. no portal account)."
           override_confirm += " It is also flagged: #{attention[:advisory].join('; ')}." if attention[:advisory].any? %>
        <%= form_with url: admin_reimbursements_override_approve_review_path(expense.record_id, tab: @tab),
                      method: :patch, class: "flex flex-wrap items-center gap-2",
                      data: { turbo_confirm: override_confirm } do %>
          <%= text_field_tag :override_note, nil, placeholder: "Reason for override (optional)",
                             "aria-label": "Reason for overriding the owner sign-off on ##{expense.auto_number}",
                             class: input_classes(width: nil) %>
          <%= submit_tag "Approve (override sign-off)",
                         "aria-label": "Approve ##{expense.auto_number}, overriding the owner sign-off",
                         data: { action: "review-decision#guard", decision_verb: "approving" },
                         class: btn_classes(:warning, :sm) %>
        <% end %>
      <% else %>
        <%# An advisory-only card gets a confirm NAMING its reasons — approval
            commits real money to a BACS batch and advisory reasons (over
            budget, no receipt, possible duplicate) don't block server-side, so
            this dialog is the only thing between a misclick and an approved
            flagged expense. Clean cards keep one-click approval. %>
        <%= button_to "Approve",
                      admin_reimbursements_approve_review_path(expense.record_id, tab: @tab),
                      method: :patch, "aria-label": "Approve ##{expense.auto_number}",
                      form: attention[:advisory].any? ? { data: { turbo_confirm:
                        "##{expense.auto_number} is flagged: #{attention[:advisory].join('; ')}. Approve anyway?" } } : {},
                      data: { action: "review-decision#guard", decision_verb: "approving" },
                      class: btn_classes(:success, :sm) %>
      <% end %>
    <% end %>
    <%= form_with url: admin_reimbursements_reject_review_path(expense.record_id, tab: @tab),
                  method: :patch, class: "flex items-center gap-2",
                  data: { turbo_confirm: "Reject ##{expense.auto_number} and email the producer? This can't be undone." } do %>
      <%# required, so the browser stops a blank reason BEFORE the "this can't
          be undone" confirm: agreeing to something irreversible and then being
          told the submit was refused is the wrong order. The field is always
          visible, so a required attribute here can never be the unreachable
          kind that silently breaks a form. The server check stays — it is the
          one that holds with JavaScript off. %>
      <%= text_field_tag :rejection_reason, nil, placeholder: "Reason for rejection", required: true,
                         "aria-label": "Reason for rejecting expense ##{expense.auto_number}",
                         class: input_classes(width: nil) %>
      <%= submit_tag "Reject", "aria-label": "Reject ##{expense.auto_number}",
                     data: { action: "review-decision#guard", decision_verb: "rejecting" },
                     class: btn_classes(:danger, :sm) %>
    <% end %>
    <%# Full finance edit (any status, incl. payee overrides). %>
    <%= link_to "Edit (any status)", edit_admin_reimbursements_expense_edit_path(expense.record_id),
                "aria-label": "Edit ##{expense.auto_number} (any status)", class: btn_classes(:secondary, :sm) %>
  </div>
  </div>

  <%# --- Receipts (opened on demand beside the details; attach/detach inline) --- %>
  <div class="min-w-0 border-t border-gray-200 pt-3<%= " lg:w-2/5 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-4" if has_receipts %>">
    <p class="text-sm font-medium">Receipts</p>
    <div class="mt-1">
      <%= render "admin/reimbursements/shared/receipt_viewer",
                 receipts: expense.receipts, key: expense.record_id,
                 label: "expense ##{expense.auto_number}",
                 group: "receipts-#{expense.record_id}" %>
    </div>
    <% if expense.receipts.any? %>
      <ul class="mt-2 flex flex-col gap-1">
        <% expense.receipts.each do |receipt| %>
          <li class="flex items-center gap-2 text-sm">
            <span class="truncate text-gray-600"><%= receipt.filename.presence || "receipt" %></span>
            <%= button_to "Remove",
                          admin_reimbursements_review_receipt_path(expense.record_id, receipt.attachment_id, tab: @tab),
                          method: :delete, form: { data: { turbo_confirm: "Remove this receipt?" } },
                          "aria-label": "Remove #{receipt.filename.presence || 'receipt'} from expense ##{expense.auto_number}",
                          class: btn_classes(:danger, :sm) %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with url: admin_reimbursements_review_receipts_path(expense.record_id, tab: @tab),
                  method: :post, multipart: true, class: "mt-2 flex items-center gap-2" do %>
      <%= file_field_tag "receipts[]", multiple: true, accept: "application/pdf,image/*",
                         "aria-label": "Attach receipts to expense ##{expense.auto_number}",
                         class: file_input_classes %>
      <%= submit_tag "Attach", class: btn_classes(:secondary, :sm) %>
    <% end %>
  </div>
  </div>

  <%# Unsaved-edits confirmation: shown by review_decision_controller only when
      the Save form above has unsaved changes and a decision button is clicked.
      The title text is set from the clicked button's verb (approving/rejecting). %>
  <dialog data-review-decision-target="dialog"
          data-action="click->review-decision#backdropClose close->review-decision#closed"
          aria-labelledby="unsaved-edits-title-<%= expense.record_id %>"
          <%# m-auto is load-bearing: Tailwind's preflight sets margin:0 on
              every element, which defeats the UA stylesheet's dialog:modal
              { margin: auto } and parked this dialog in the viewport's top
              left corner, over the sidebar. %>
          class="m-auto rounded border border-gray-200 p-0 shadow-lg backdrop:bg-black/40">
    <div class="max-w-sm p-4">
      <h2 class="text-base font-medium" id="unsaved-edits-title-<%= expense.record_id %>"
          data-review-decision-target="title">
        Do you want to save the changes before continuing?
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        You have unsaved edits on this expense. Save them first, discard them, or go back.
      </p>
      <div class="mt-4 flex flex-wrap justify-end gap-2">
        <button type="button" data-action="review-decision#cancel" class="<%= btn_classes(:secondary, :sm) %>">Cancel</button>
        <button type="button" data-action="review-decision#discardThenDecide" class="<%= btn_classes(:danger, :sm) %>">Discard Changes</button>
        <button type="button" data-action="review-decision#saveThenDecide" class="<%= btn_classes(:primary, :sm) %>">Save Changes</button>
      </div>
    </div>
  </dialog>
</div>
