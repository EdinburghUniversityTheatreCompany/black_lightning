<%# locals: (f:, partial_name:, association_name:, display_link_to_add: true, container_class: nil, wrapper_class: nil, sortable: false, collection: nil, add_object_name: nil, template_object: nil) %>
<%# KEEP %>
<%# `collection:` renders a custom set of records instead of the association. Keep the rows in
    document order: TeamMemberOrdering stamps display_order from each row's posted position. %>

<% if f.object.errors[association_name].present? then %>
  <p id="<%= association_name %>_errors" class="p-4 rounded border mb-4 bg-danger/10 border-danger/30 text-danger">
    <%= f.error association_name %>
  </p>
<% end %>

<%# SortableJS only reorders direct children, so the sortable controller sits on the rows' parent. %>
<div data-controller="nested-form">
  <%= content_tag :div, class: "#{container_class} mb-3", data: (sortable ? { controller: "sortable" } : {}) do %>
    <%= f.simple_fields_for(*[ association_name, collection ].compact) do |nested_f| %>
      <% wrapper_data = { new_record: nested_f.object.new_record? } %>
      <% wrapper_data[:sortable_item] = true if sortable %>
      <%= content_tag :div, class: "nested-form-wrapper #{wrapper_class}", data: wrapper_data do %>
        <%= render partial_name, f: nested_f %>
        <%= nested_f.hidden_field :_destroy %>
      <% end %>
    <% end %>

    <div data-nested-form-target="target" class="hidden"></div>
  <% end %>

  <template data-nested-form-target="template">
    <%# template_object: for a collection that is not an association (ticket_prices). %>
    <% blank_record = template_object || f.object.class.reflect_on_association(association_name).klass.new %>
    <%= f.simple_fields_for(association_name, blank_record, child_index: "NEW_RECORD") do |nested_f| %>
      <% wrapper_data = { new_record: true } %>
      <% wrapper_data[:sortable_item] = true if sortable %>
      <%= content_tag :div, class: "nested-form-wrapper #{wrapper_class}", data: wrapper_data do %>
        <%= render partial_name, f: nested_f %>
        <%= nested_f.hidden_field :_destroy %>
      <% end %>
    <% end %>
  </template>

  <% if display_link_to_add %>
    <div class="mt-2">
      <%= link_to_add f, association_name, object_name: add_object_name, div_html_class: wrapper_class %>
    </div>
  <% end %>
</div>
