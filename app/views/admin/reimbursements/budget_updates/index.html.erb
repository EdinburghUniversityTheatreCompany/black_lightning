<%= render "admin/reimbursements/shared/year_selector" %>

<p class="mb-3 text-gray-600">
  A log of multi-budget forecast revisions. Each one revised several budgets' forecasts at once
  under a shared effective date and note. The individual forecasts stay editable from each
  budget's own forecast log.
</p>

<p class="mb-3">
  <%= link_to "New budget update", new_admin_reimbursements_budget_update_path,
        class: btn_classes(:primary, :sm) %>
</p>

<%= render CardComponent.new(title: "Budget updates", flush: true) do %>
  <% if @budget_updates.empty? %>
    <p class="py-4 text-center text-gray-600">No budget updates logged yet.</p>
  <% else %>
    <div class="table-scroll">
      <table class="table table-hover table-sticky-head">
        <thead>
          <tr>
            <th scope="col">Effective date</th>
            <th scope="col">Note</th>
            <th scope="col">Revised</th>
            <th scope="col">Logged by</th>
          </tr>
        </thead>
        <tbody>
          <% @budget_updates.each do |update| %>
            <tr>
              <td class="whitespace-nowrap"><%= reimbursements_date(update.effective_date) %></td>
              <td><%= update.note.presence || "-" %></td>
              <td>
                <%# An update groups BOTH levels — a budget import can revise a show's
                    agreed total alongside its lines' allocations — so an area forecast
                    (budget_id nil) has to be named too, and marked, or an area-only
                    update read "1 budget" naming nothing. %>
                <% names = update.forecasts.filter_map do |forecast|
                     if forecast.budget_id
                       @budgets_by_id[forecast.budget_id]&.display_name
                     else
                       area = @areas_by_id[forecast.area_id.to_s]
                       "#{area.name} (area total)" if area
                     end
                   end %>
                <%= names.any? ? names.sort.join(", ") : pluralize(update.forecasts.size, "line") %>
              </td>
              <td class="whitespace-nowrap"><%= update.created_by&.full_name.presence || "-" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
