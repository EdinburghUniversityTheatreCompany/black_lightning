<%# locals: (budget:) %>
<%
  # The name links to the edit form too: at 1366x768 the Edit button sits off
  # screen.
  name = safe_join([
    # The accessible name is the QUALIFIED one (the rowgroup heading is not
    # announced with the link), and deliberately does not start with "Edit",
    # which is the row's button.
    link_to(budget.name.presence || "-", edit_admin_reimbursements_budget_path(budget.record_id, **scope_params),
            class: "font-medium text-primary underline",
            "aria-label": budget.display_name),
    (content_tag(:span, " · #{budget.nominal_code}", class: "text-gray-500") if budget.nominal_code.present?),
    reimbursements_budget_health_badge(budget),
    (content_tag(:span, "(hidden)", class: "text-gray-400 text-xs") unless budget.active)
  ].compact, " ")
  # "No owner" warns only on a Visible line: hidden overheads (payroll, NI)
  # never have one.
  owners = budget_owner_names(budget).presence ||
           (if budget.active
              render(BadgeComponent.new(type: :warning, pill: true).with_content("No owner"))
            else
              content_tag(:span, reimbursements_value(nil), class: "text-gray-400")
            end)
  # Server-side as well as :target, because a Turbo redirect drops the fragment.
  # Every cell, since the pinned first and last cells paint their own background.
  highlighted = params[:budget] == budget.record_id
  highlight = class_names("group-target:bg-yellow-50", "bg-yellow-50" => highlighted)
  money = class_names("text-right whitespace-nowrap", highlight)
%>
<tr id="budget_<%= budget.record_id %>" class="group scroll-mt-28">
  <td class="<%= class_names("sticky left-0 z-10", highlight,
                             "bg-white group-hover:bg-gray-50" => !highlighted) %>"><%= name %></td>
  <td class="<%= money %>"><%= reimbursements_money(budget.initial_budget) %></td>
  <td class="<%= money %>"><%= reimbursements_budget_projected(budget) %></td>
  <td class="<%= money %>"><%= reimbursements_money(budget.committed_amount) %></td>
  <td class="<%= money %>"><%= reimbursements_money(budget.eusa_actual_amount) %></td>
  <td class="<%= money %>"><%= reimbursements_money(budget.expected_outturn) %></td>
  <td class="<%= money %>"><%= reimbursements_budget_remaining(budget) %></td>
  <td class="<%= money %>"><%= reimbursements_budget_variance(budget) %></td>
  <td class="<%= highlight %>"><%= owners %></td>
  <td class="<%= highlight %>">
    <%= link_to("Edit", edit_admin_reimbursements_budget_path(budget.record_id, **scope_params),
          "aria-label": "Edit #{budget.display_name}", class: btn_classes(:secondary, :sm)) %>
  </td>
</tr>
