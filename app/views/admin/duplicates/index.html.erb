<%= render(QuickActionsCardComponent.new) do %>
  <%= get_link(User, :index, link_text: "Back to Users") %>
<% end %>

<% total_count = @duplicates.values.sum(&:size) %>

<% if total_count == 0 %>
  <%= render AlertComponent.new(type: :success) do %>
    <strong>No potential duplicates found!</strong> All users appear to be unique.
  <% end %>
<% else %>

  <% if @duplicates[:same_id].any? %>
    <%= render CardComponent.new(title: "Definite Duplicates (Same Student/Associate ID): #{@duplicates[:same_id].size} group(s)", variant: :danger) do %>
      <p class="text-gray-500">These users share the same student or associate ID, or have equivalent email addresses (e.g. s1234567@sms.ed.ac.uk and s1234567@ed.ac.uk). They are almost certainly duplicates and should be merged.</p>
      <table class="table table-sm table-hover table-sticky-head">
        <thead>
          <tr>
            <th>Match Type</th>
            <th>ID Value</th>
            <th>Users</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @duplicates[:same_id].each do |dup| %>
            <% target = dup[:users].first %>
            <% source = dup[:users].second %>
            <tr id="pair-<%= target.id %>-<%= source.id %>">
              <td><%= render(BadgeComponent.new(type: :danger)) { dup[:match_type].to_s.titleize } %></td>
              <td><code><%= dup[:id_value] %></code></td>
              <td>
                <% dup[:users].each do |user| %>
                  <% years = cached_years_active(user, dup[:years_active_cache]) %>
                  <%= link_to user.name_or_email, admin_user_path(user) %>
                  <small class="text-gray-500">(<%= user.email %>)</small>
                  <% if years.any? %>
                    <small class="text-gray-500">- Active: <%= years.map { |y| format_academic_year(y) }.join(", ") %></small>
                  <% end %>
                  <br>
                <% end %>
              </td>
              <td>
                <%= link_to "Merge", merge_admin_user_path(target, source_user_id: source.id), class: btn_classes(:warning, :sm), data: { turbo_frame: "merge-modal" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <% {
    fuzzy_name_overlapping: [ "Likely Duplicates (Name Match + Overlapping Activity)", :warning, "These users have matching last names, similar first names, and were active during overlapping time periods. They are likely the same person." ],
    fuzzy_name_non_overlapping: [ "Possible Duplicates (Name Match, Different Time Periods)", :info, "These users have matching names but were active in different time periods (more than 4 years apart). They are less likely to be the same person, but you may want to review them." ],
    fuzzy_both_overlapping: [ "Fuzzy Name Match (Both Names), Overlapping Years", :secondary, "Users with similar first AND last names who were active during overlapping years." ],
    fuzzy_both_no_overlap: [ "Fuzzy Name Match (Both Names), No Overlapping Years", :default, "Users with similar first AND last names active in different time periods (lower confidence)." ]
  }.each do |key, (title, variant, blurb)| %>
    <% next if @duplicates[key].empty? %>
    <%= render CardComponent.new(title: "#{title}: #{@duplicates[key].size} pair(s)", variant: variant) do %>
      <p class="text-gray-500"><%= blurb %></p>
      <table class="table table-sm table-hover table-sticky-head">
        <thead>
          <tr>
            <th>User 1</th>
            <th>User 2</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @duplicates[key].each do |dup| %>
            <% u1, u2 = dup[:users] %>
            <tr id="pair-<%= u1.id %>-<%= u2.id %>">
              <% dup[:users].each do |user| %>
                <% years = cached_years_active(user, dup[:years_active_cache]) %>
                <td>
                  <%= link_to user.name_or_email, admin_user_path(user) %><br>
                  <small class="text-gray-500"><%= user.email %></small><br>
                  <small class="text-gray-500">
                    <% if years.any? %>
                      Active: <%= years.map { |y| format_academic_year(y) }.join(", ") %>
                    <% else %>
                      No activity recorded
                    <% end %>
                  </small>
                </td>
              <% end %>
              <td>
                <%= link_to "Merge", merge_admin_user_path(u1, source_user_id: u2.id), class: btn_classes(:warning, :sm), data: { turbo_frame: "merge-modal" } %>
                <%= button_to "Not Duplicates", mark_not_duplicate_admin_duplicates_path(user_id: u1.id, other_user_id: u2.id), method: :post, class: btn_classes(:secondary, :sm) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

<% end %>

<dialog id="merge-modal-dialog"
        data-controller="modal"
        data-action="click->modal#backdropClose"
        class="bg-transparent border-0 p-0 w-full max-w-5xl m-auto max-h-screen overflow-y-auto backdrop:bg-black/50">
  <turbo-frame id="merge-modal" data-action="turbo:frame-load->modal#open">
  </turbo-frame>
</dialog>
