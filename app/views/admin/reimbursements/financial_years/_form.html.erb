<%# locals: (financial_year:, url:, title:, submit_label:, show_key:, intro:) %>
<%# The whole card, form included, so the buttons sit in the card footer like
    every other admin form. `intro` is the caller's captured block above the
    fields (the status badge on edit, the draft explanation on new). `show_key`
    is true only on new: the key is the URL slug, so it is settable at creation
    and fixed afterwards. %>
<%= simple_form_for financial_year, as: :financial_year, url: url do |f| %>
  <%= render CardComponent.new(title: title) do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: submit_label,
            cancel_path: admin_reimbursements_financial_years_path %>
    <% end %>

    <%= intro %>

    <%= f.input :label, placeholder: "e.g. Fringe 2027",
          hint: "What this year is called throughout the portal. Must be unique." %>

    <div class="grid gap-x-4 sm:grid-cols-2">
      <%= f.input :starts_on, as: :date, label: "Starts on" %>
      <%= f.input :ends_on, as: :date, label: "Ends on" %>
    </div>
    <p class="<%= FormStyles::HINT %> -mt-2 <%= show_key ? 'mb-4' : 'mb-0' %>">
      Both are for reference on this screen — the active year is whichever one you've switched to,
      not whichever one today falls inside.
    </p>

    <% if show_key %>
      <%= render CollapsibleSectionComponent.new(title: "Advanced") do %>
        <%# required: false — see settings/new: derived when blank, and a required
            control in a collapsed section blocks the submit. %>
        <%= f.input :key, label: "URL key (slug)", placeholder: "auto-generated from the label",
              required: false, wrapper_html: { class: "mb-0" },
              hint: "Leave blank to derive it from the label. If you set it, use lowercase letters, " \
                    "numbers and hyphens only (it appears in links to this year and can't be changed " \
                    "later)." %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
