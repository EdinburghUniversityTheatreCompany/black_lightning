<div class="flex flex-col gap-4">
  <%= render "shared/form/field", label: "Financial year", name: :year,
        html_class: "sm:w-1/2" do %>
    <%= select_tag :year,
                   options_from_collection_for_select(@financial_years, :key, :label, @financial_year&.key),
                   class: input_classes %>
  <% end %>

  <%# A whole sheet in the wrong pot is a large quiet mistake, so the select is preselected only
      from the link, the sole centre or the operator's home centre. %>
  <%= render "shared/form/field", label: "Cost centre", name: :cost_centre_id,
        html_class: "sm:w-1/2" do %>
    <%= select_tag :cost_centre_id,
                   options_from_collection_for_select(@cost_centres, :id, :name, @cost_centre&.id),
                   include_blank: "Choose a cost centre…", class: input_classes %>
  <% end %>

  <%= render "shared/form/paste_or_upload",
        text_name: :pasted_text, text_label: "Paste the sheet", text_value: @pasted_text,
        rows: 12, placeholder: @placeholder,
        file_name: :file, file_label: "…or upload an .xlsx", file_accept: ".xlsx",
        file_hint: "The first sheet's first row is read as the header. A file takes precedence " \
                   "over pasted text." %>
</div>
