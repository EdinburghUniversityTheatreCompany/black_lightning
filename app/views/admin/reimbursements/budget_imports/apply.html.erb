<%= render CardComponent.new(title: "Imported into #{@financial_year.label}") do %>
  <ul class="mb-4 list-disc pl-5 text-sm">
    <li><strong><%= pluralize(@result.created, "budget") %></strong> created.</li>
    <li>
      <strong><%= pluralize(@result.revised, "figure") %></strong> revised
      <%= "(logged as one budget update)" if @result.budget_update %>.
    </li>
    <% if @result.owners_synced.positive? %>
      <li><strong><%= pluralize(@result.owners_synced, "budget") %></strong> had their owners updated.</li>
    <% end %>
  </ul>

  <% if @import.unknown_owner_emails.any? %>
    <p class="mb-4 text-sm text-amber-800">
      These owner emails matched nobody and were skipped:
      <%= @import.unknown_owner_emails.to_sentence %>.
    </p>
  <% end %>

  <div class="flex flex-wrap gap-3">
    <%= link_to "See the budgets",
                admin_reimbursements_budgets_path(year: @financial_year.key),
                class: btn_classes(:primary) %>
    <%= link_to "Import another sheet", import_path, class: btn_classes(:secondary) %>
    <% unless @financial_year.active? %>
      <%= link_to "Financial years", admin_reimbursements_financial_years_path,
                  class: btn_classes(:secondary) %>
    <% end %>
  </div>

  <% unless @financial_year.active? %>
    <p class="mt-4 text-sm text-gray-600">
      <%= @financial_year.label %> is still a draft — submitters won't see these budgets until you
      make it the active year.
    </p>
  <% end %>
<% end %>
