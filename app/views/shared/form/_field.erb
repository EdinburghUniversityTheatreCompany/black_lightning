<%# locals: (label:, name:, hint: nil, html_class: "mb-4", id: nil) %>
<%# One field of a hand-rolled `form_with url:` form: label, the yielded control, then hint,
    styled from FormStyles like simple_form's vertical wrapper. `id` is needed only when the
    control's id is not its name (a per-row form on a list). %>
<div class="<%= html_class %>">
  <%= label_tag (id || name), label, class: FormStyles::LABEL %>
  <%= yield %>
  <% if hint.present? %>
    <%# id so a caller can point its control's aria-describedby here. %>
    <small id="<%= id || name %>_hint" class="<%= FormStyles::HINT %>"><%= hint %></small>
  <% end %>
</div>
