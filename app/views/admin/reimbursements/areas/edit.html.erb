<%= render "shared/back_link", text: "All areas", path: admin_reimbursements_areas_path(year: selected_financial_year&.key) %>

<%= simple_form_for @area, as: :reimbursements_area,
                    url: admin_reimbursements_area_path(@area.record_id) do |form| %>
  <%= render CardComponent.new(title: "Edit #{@area.name.presence || 'area'}") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Save",
            cancel_path: admin_reimbursements_areas_path(year: selected_financial_year&.key) %>
    <% end %>

    <%= render "fields", form: form, people: @people, owner_ids: @owner_ids %>

    <h3 class="mt-6 mb-2 text-sm font-semibold text-gray-700">Budget lines</h3>
    <p class="mb-3 text-sm text-gray-600">
      Detaching a line does not delete it — it becomes a standalone budget again, keeping its
      claims and history.
    </p>
    <%# budgets is a real has_many association (unlike ticket_prices, a JSON
        column), so this needs no template_object: — the partial reflects on
        the association itself to build the blank "Add" row. %>
    <%= render "shared/form/sections/nested_fields", f: form, association_name: :budgets,
          partial_name: "budget_fields", add_object_name: "budget line" %>
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Financials (read-only)", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-3">
    Computed from this area's own agreed total and the budget lines above.
  </p>
  <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2 text-sm">
    <div><dt class="text-gray-500">Agreed total</dt><dd class="font-medium"><%= reimbursements_money(@area.projected_amount) %></dd></div>
    <div><dt class="text-gray-500" title="How much of the agreed total has been split out into budget lines. Lines with no agreed figure of their own are skipped, not counted as zero.">Allocated to lines</dt><dd class="font-medium"><%= reimbursements_money(@area.allocated) %></dd></div>
    <div><dt class="text-gray-500" title="The part of the agreed total not yet assigned to a line — not spare money.">Unallocated</dt><dd class="font-medium"><%= reimbursements_money(@area.unallocated) %></dd></div>
    <div><dt class="text-gray-500">Committed</dt><dd class="font-medium"><%= reimbursements_money(@area.committed_amount) %></dd></div>
    <div>
      <dt class="text-gray-500">Remaining</dt>
      <dd class="font-medium <%= "text-danger" if @area.remaining&.negative? %>"><%= reimbursements_money(@area.remaining) %></dd>
    </div>
  </dl>
<% end %>
