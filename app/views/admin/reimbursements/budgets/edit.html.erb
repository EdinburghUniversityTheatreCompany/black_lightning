<%= render "shared/back_link", text: "All budgets", path: admin_reimbursements_budgets_path %>

<%= form_with url: admin_reimbursements_budget_path(@budget.record_id), method: :patch do |form| %>
  <%= render CardComponent.new(title: "Edit #{@budget.display_name.presence || 'budget'}") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Save budget", cancel_path: admin_reimbursements_budgets_path %>
    <% end %>

    <%# owner_ids is the budget's OWN rows, which is what this form writes —
        never @budget.owner_ids, which resolves through the area. An
        area-bound budget renders them read-only instead (owners_from_area). %>
    <%= render "fields", form: form, people: @people,
          name: @budget.name, nominal_code: @budget.nominal_code, budget_type: @budget.budget_type,
          initial_budget: @budget.initial_budget, notes: @budget.notes,
          active: @budget.active, owner_ids: @budget.own_owners.map(&:record_id),
          areas: @areas, area_id: @budget.area_id, owners_from_area: @budget.area %>
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Financials (read-only)", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-3">
    Computed from the expenses, forecasts and EUSA actuals linked to this budget.
  </p>
  <% if @budget.over_budget? %>
    <p class="mb-3">
      <%= render(BadgeComponent.new(type: :danger, pill: true).with_content("Over budget")) %>
    </p>
  <% elsif @budget.over_initial_budget? %>
    <p class="mb-3">
      <%= render(BadgeComponent.new(type: :warning, pill: true).with_content("Over original budget")) %>
    </p>
  <% end %>
  <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2 text-sm">
    <div><dt class="text-gray-500">Current forecast</dt><dd class="font-medium"><%= reimbursements_money(@budget.current_forecast) %></dd></div>
    <div><dt class="text-gray-500">Committed</dt><dd class="font-medium"><%= reimbursements_money(@budget.committed_amount) %></dd></div>
    <div><dt class="text-gray-500">Pipeline</dt><dd class="font-medium" title="Pending expenses not yet approved."><%= reimbursements_money(@budget.pipeline_amount) %></dd></div>
    <div><dt class="text-gray-500">Paid (portal)</dt><dd class="font-medium"><%= reimbursements_money(@budget.paid_portal_amount) %></dd></div>
    <div><dt class="text-gray-500">EUSA actual</dt><dd class="font-medium" title="Reconciled EUSA ledger spend for this line."><%= reimbursements_money(@budget.eusa_actual_amount) %></dd></div>
    <div><dt class="text-gray-500">Expected outturn</dt><dd class="font-medium" title="The greater of the current projection and what's already been spent or committed, so the number never drops below reality. Blank on income lines, where the same figure would read as best-case income instead."><%= reimbursements_money(@budget.expected_outturn) %></dd></div>
    <div><dt class="text-gray-500">Remaining</dt><dd class="font-medium <%= "text-danger" if @budget.remaining&.negative? %>"><%= reimbursements_money(@budget.remaining) %></dd></div>
    <div>
      <dt class="text-gray-500">Variance</dt>
      <dd class="font-medium <%= "text-danger" if @budget.variance&.positive? %><%= "text-success" if @budget.variance&.negative? %>">
        <%= reimbursements_money(@budget.variance) %>
      </dd>
    </div>
  </dl>
<% end %>

<%= render CardComponent.new(title: "Budget forecasts", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-3">
    A versioned log of projected-spend updates for this budget. The latest feeds the
    current forecast above. Add a new one whenever the projection changes.
  </p>

  <%= form_with url: forecast_admin_reimbursements_budget_path(@budget.record_id), method: :post,
                class: "flex flex-wrap items-end gap-3 mb-4" do %>
    <%= render "shared/form/field", label: "Amount (£, excl. VAT)", name: :amount, html_class: "w-40" do %>
      <%= number_field_tag :amount, nil, step: "0.01", class: input_classes %>
    <% end %>
    <%# html_class: "" drops the partial's default mb-4 — in an items-end row it
        would float this field above its neighbours, which pass their own class. %>
    <%= render "shared/form/field", label: "Date", name: :date, html_class: "" do %>
      <%= date_field_tag :date, Date.current, class: input_classes(width: nil) %>
    <% end %>
    <%= render "shared/form/field", label: "Reason / notes", name: :reason, html_class: "grow" do %>
      <%= text_field_tag :reason, nil, class: input_classes %>
    <% end %>
    <%= submit_tag "Add forecast", class: btn_classes(:primary, :sm) %>
  <% end %>

  <% if @forecasts.empty? %>
    <p class="py-2 text-center text-gray-600">No forecasts logged yet.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-gray-200">
            <th scope="col" class="py-2 pr-3">Date</th>
            <th scope="col" class="py-2 pr-3 text-right">Amount</th>
            <th scope="col" class="py-2">Reason / notes</th>
            <th scope="col" class="py-2 text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @forecasts.each do |forecast| %>
            <% if forecast.record_id == @editing_forecast_id %>
              <tr class="border-b border-gray-100 bg-amber-50">
                <td colspan="4" class="py-2">
                  <%= form_with url: update_forecast_admin_reimbursements_budget_path(@budget.record_id),
                                method: :patch, class: "flex flex-wrap items-end gap-3" do %>
                    <%= hidden_field_tag :forecast_id, forecast.record_id %>
                    <%= render "shared/form/field", label: "Amount (£, excl. VAT)", name: :amount,
                          id: "edit_amount_#{forecast.record_id}", html_class: "w-40" do %>
                      <%= number_field_tag :amount, reimbursements_amount_value(forecast.amount),
                                           step: "0.01", id: "edit_amount_#{forecast.record_id}",
                                           class: input_classes %>
                    <% end %>
                    <%= render "shared/form/field", label: "Date", name: :date,
                          id: "edit_date_#{forecast.record_id}", html_class: "" do %>
                      <%= date_field_tag :date, forecast.date, id: "edit_date_#{forecast.record_id}",
                                         class: input_classes(width: nil) %>
                    <% end %>
                    <%= render "shared/form/field", label: "Reason / notes", name: :reason,
                          id: "edit_reason_#{forecast.record_id}", html_class: "grow" do %>
                      <%= text_field_tag :reason, forecast.reason, id: "edit_reason_#{forecast.record_id}",
                                         class: input_classes %>
                    <% end %>
                    <%= submit_tag "Save", class: btn_classes(:primary, :sm) %>
                    <%= link_to "Cancel", edit_admin_reimbursements_budget_path(@budget.record_id), class: btn_classes(:secondary, :sm) %>
                  <% end %>
                </td>
              </tr>
            <% else %>
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-3 whitespace-nowrap"><%= reimbursements_date(forecast.date) %></td>
                <td class="py-2 pr-3 text-right"><%= reimbursements_money(forecast.amount) %></td>
                <td class="py-2">
                  <%= forecast.reason.presence || "-" %>
                  <% if forecast.budget_update_id.present? %>
                    <span class="ml-1 text-xs text-gray-500">(part of a budget update
                      on <%= reimbursements_date(forecast.budget_update.effective_date) %>)</span>
                  <% end %>
                </td>
                <td class="py-2 text-right whitespace-nowrap">
                  <%= link_to "Edit",
                        edit_admin_reimbursements_budget_path(@budget.record_id, edit_forecast: forecast.record_id),
                        "aria-label": "Edit forecast from #{reimbursements_date(forecast.date)}",
                        class: btn_classes(:secondary, :sm) %>
                  <%# inline-block on the button_to FORM (not the inner button) so
                      Delete sits beside Edit instead of dropping to its own line. %>
                  <%= button_to "Delete",
                        delete_forecast_admin_reimbursements_budget_path(@budget.record_id, forecast_id: forecast.record_id),
                        method: :delete, class: btn_classes(:danger, :sm),
                        "aria-label": "Delete forecast from #{reimbursements_date(forecast.date)}",
                        form: { class: "inline-block",
                                data: { turbo_confirm: "Remove this forecast? This changes the budget's rolled-up current forecast." } } %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
