<%# locals: (opportunities:) %>
<div class="flex h-full w-full flex-col bg-neutral-950 px-16 py-12">
  <%# h-18, What's On's header height, so both lists start at the same place on the
      screen. shrink-0, or a long list squeezes it down to the logo's. %>
  <div class="mb-10 flex h-18 shrink-0 items-center justify-between gap-10">
    <%= display_label("Get Involved", tag: :h1) %>
    <%= display_logo %>
  </div>

  <% if opportunities.any? %>
    <%# Same auto-scroll as What's On: the kiosk has no pointer, so overflow would
        be unreachable. Chrome is 25rem here, not the 17.25rem default — this
        panel's footer carries the QR code (h-40). See display.css. %>
    <div class="display-marquee" style="--display-marquee-chrome: 25rem">
      <ul class="display-marquee__track flex flex-col divide-y divide-neutral-800">
        <% opportunities.each do |opportunity| %>
          <%# grow, like What's On's items: spreads a short list over the frame,
              and is inert once the list overflows. justify-center keeps the two
              lines of an item together inside its grown box. %>
          <li class="flex grow flex-col justify-center py-5">
            <p class="truncate text-5xl font-bold leading-descender text-white"><%= opportunity.display_title %></p>
            <% if opportunity.roles.any? %>
              <p class="mt-2 truncate text-3xl leading-descender text-neutral-400">
                <%= opportunity.roles.map(&:position).join(" · ") %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="flex flex-1 flex-col justify-center">
      <div class="max-w-6xl text-5xl leading-relaxed text-neutral-300">
        <%= display_block_text(Display::Panels::GetInvolved::EMPTY_STATE_BLOCK) %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 flex items-center gap-8">
    <%= display_qr_code(get_involved_opportunities_url, css_class: "h-40 w-40", label: "Scan to see opportunities") %>
    <p class="text-4xl text-neutral-300">
      <%= opportunities.any? ? "Scan for the full list and to apply" : "Scan to submit an opportunity" %>
    </p>
  </div>
</div>
