#!/usr/bin/env sh
# Hot-restart the running Puma dev server in place (SIGUSR2).
#
# Puma re-execs on SIGUSR2 keeping its PID, so `mise run serve` sees no child die and Vite keeps
# running. Use it to reload boot-time state: config/initializers, config/*, Gemfile, env vars and
# new/enum-backed DB columns. App code reloads by itself. Not `touch tmp/restart.txt`, which
# only works with Passenger.

set -e

# Puma tags its process with the directory it was started from, so a worktree's server is
# `[<worktree>]`, not `[BlackLightning]`. The literal name restarted the main checkout's server
# from every worktree.
tag=$(basename "$(cd "$(dirname "$0")/.." && pwd)")
pid=$(pgrep -f "puma .* \[$tag\]" || true)

if [ -z "$pid" ]; then
  echo "No running Puma dev server found (is the dev server running?)." >&2
  exit 1
fi

echo "Hot-restarting Puma (pid $pid) via SIGUSR2..."
kill -USR2 "$pid"
echo "Done. Watch the dev server for the restart log."
