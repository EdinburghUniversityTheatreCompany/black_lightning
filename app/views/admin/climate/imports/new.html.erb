<%= render "shared/back_link", text: "Back to the charts", path: admin_climate_dashboard_path %>

<% if @sensors.empty? %>
  <%= render CardComponent.new(title: "Import a Govee export") do %>
    <%= render AlertComponent.new(type: :info) do %>
      There are no sensors to import against yet.
      <%= link_to "Add one first", new_admin_climate_sensor_path, class: "text-primary underline" %>.
    <% end %>
  <% end %>
<% else %>
  <%= form_with url: admin_climate_import_path, method: :post, multipart: true,
                data: { turbo: false } do %>
    <%= render CardComponent.new(title: "Import a Govee export") do |card| %>
      <% card.with_footer do %>
        <%= render "shared/form/actions", submit: "Import", cancel_path: admin_climate_dashboard_path %>
      <% end %>

      <p class="text-gray-600 mb-3">
        Open the Govee Home app, pick the sensor and choose <strong>Export Data</strong>. Since the
        dressing room access point went in at the start of August 2026 the sensors upload to Govee's
        cloud on their own, so you can do this from anywhere. If one looks stuck, stand in the
        dressing room with the app open and let it sync over Bluetooth instead.
      </p>

      <p class="text-gray-600 mb-4">
        <% if Climate::Settings.mailbox.present? %>
          A daily report already goes to <code><%= Climate::Settings.mailbox %></code> and imports
          itself, so you only need this page to backfill a gap or to pull something in sooner. Either
          way, importing
        <% else %>
          Importing
        <% end %>
        the same file twice is harmless: readings are keyed by sensor and timestamp, so an overlap
        overwrites rather than duplicates.
      </p>

      <div class="flex flex-col gap-4">
        <%= render "shared/form/field", label: "Which sensor is this file from?", name: :sensor_id,
              hint: "The export doesn't say which device it came from, so this is worth " \
                    "double-checking. Readings land against whichever sensor is picked here." do %>
          <%= select_tag :sensor_id,
                         options_from_collection_for_select(@sensors, :id, :to_label, params[:sensor_id]),
                         include_blank: "Choose a sensor…", class: input_classes %>
        <% end %>

        <%= render "shared/form/paste_or_upload", file_first: true,
              file_name: :file, file_label: "CSV file", file_accept: ".csv,text/csv",
              text_name: :pasted_text, text_label: "…or paste the contents", text_value: params[:pasted_text],
              rows: 8, placeholder: "Timestamp,Temperature_Celsius,Relative_Humidity" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render CollapsibleSectionComponent.new(title: "What the importer expects", html_class: "mt-4") do %>
  <ul class="list-disc pl-5 space-y-2 text-gray-700">
    <li>
      A header row naming a <strong>timestamp</strong>, a <strong>temperature</strong> and a
      <strong>humidity</strong> column, then one row per reading. Comma or tab separated.
    </li>
    <li>
      <strong>The temperature column must say its unit.</strong> Govee exports
      <code>Temperature_Celsius</code> or <code>Temperature_Fahrenheit</code> depending on what the
      app displays. A file that doesn't say is refused.
    </li>
    <li>
      Timestamps are read as Edinburgh local time, matching what the app exports.
    </li>
    <li>
      Readings outside <%= Climate::ReadingIngest::PLAUSIBLE_CELSIUS %> °C or
      <%= Climate::ReadingIngest::PLAUSIBLE_HUMIDITY %> % are skipped and reported.
    </li>
  </ul>
<% end %>
