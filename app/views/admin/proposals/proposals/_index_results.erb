<%# locals: () %>

<% can_act = can_act_on_proposals(@proposals) %>
<% redirect_param = { redirect_to: admin_proposals_call_proposals_path(@call) } %>

<% headers = [:show_title] %>
<% headers << "Actions" if can_act %>

<% field_sets = @proposals.map do |proposal|
  fields = [
    proposal,
    "#{get_link(proposal, :show, link_target: admin_proposals_proposal_path(proposal))} #{proposal_labels(proposal, true)}".html_safe
  ]

  fields << safe_join(proposal_action_buttons(proposal).compact, " ") if can_act

  { fields: fields }
end %>

<% call_info_fields = {
  submission_deadline: l(@call.submission_deadline, format: :longy),
  editing_deadline: l(@call.editing_deadline, format: :longy),
} %>

<%= render CardComponent.new(title: "Proposals", flush: true) do %>
  <%= render FieldListComponent.new(fields: call_info_fields, admin_site: @admin_site) %>
  <%= render(IndexTableComponent.new(headers: headers, field_sets: field_sets, q: @q, include_edit_button: true, include_link_to_item: false, resource_class: Admin::Proposals::Proposal)) %>
<% end %>
