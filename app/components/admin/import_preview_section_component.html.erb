<%= render CardComponent.new(variant: @variant, flush: true) do |c| %>
  <% c.with_tools do %>
    <span class="text-base font-semibold flex-1"><%= @title %></span>
    <%= render(BadgeComponent.new(type: badge_type, html_class: "ml-2")) { @items.size.to_s } %>
    <small class="ml-auto"><%= @hint %></small>
  <% end %>
  <table class="table table-sm table-hover mb-0">
    <thead class="table-light">
      <tr>
        <% @headers.each do |label, width| %>
          <%= tag.th(label, style: ("width: #{width};" if width)) %>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= content %>
    </tbody>
  </table>
<% end %>
