<%# locals: (event:, dim: false) %>
<%# nil when the blob is missing from storage: degrade to text over black, not a 500. %>
<% if (image_url = display_image_url(event)) %>
  <%= image_tag image_url, class: [ "absolute inset-0 h-full w-full object-cover", ("opacity-70" if dim) ], alt: "" %>
<% end %>

<%# The logo carries its own scrim: white on a pale poster would vanish. %>
<div class="absolute inset-x-0 top-0 flex justify-end bg-gradient-to-b from-black/70 to-transparent px-16 pb-24 pt-10">
  <%= display_logo %>
</div>
