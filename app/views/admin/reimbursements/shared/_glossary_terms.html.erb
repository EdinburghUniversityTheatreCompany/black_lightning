<%# locals: (terms:, summary: "What these columns mean", intro: nil) %>
<%# <details>, not a title= tooltip, which touch screens and keyboards never show. %>
<details class="mb-3 rounded border border-gray-200 bg-gray-50 p-3">
  <summary class="cursor-pointer text-sm font-medium"><%= summary %></summary>
  <% if intro %>
    <p class="mt-2 mb-0 text-sm text-gray-700"><%= intro %></p>
  <% end %>
  <dl class="mt-2 flex flex-col gap-2">
    <% terms.each do |term| %>
      <div>
        <dt class="text-sm font-medium"><%= term.term %></dt>
        <dd class="text-sm text-gray-700"><%= term.definition %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-2 mb-0 text-sm">
    <%= link_to "Every word this portal uses", admin_reimbursements_glossary_path,
                class: "underline" %>
  </p>
</details>
