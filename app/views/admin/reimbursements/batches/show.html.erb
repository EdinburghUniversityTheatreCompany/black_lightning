<%= render "shared/back_link", text: "Back to history", path: admin_reimbursements_batches_path %>

<%= render CardComponent.new(title: @batch.name.presence || @batch.record_id) do %>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <%# The date typed on the build form, which is what EUSA is asked to pay on.
        It was labelled "Date sent" for a draft nobody has necessarily sent —
        nothing in the portal records the manual send. %>
    <dt class="font-medium">BACS date</dt>
    <dd><%= reimbursements_date(@batch.date_sent) %></dd>
    <dt class="font-medium">EUSA draft created</dt>
    <dd>
      <% if @batch.eusa_draft_created %>
        <%= render BadgeComponent.new(type: :success, pill: true).with_content("Yes") %>
      <% else %>
        <%= render BadgeComponent.new(type: :warning, pill: true).with_content("No: needs a look") %>
      <% end %>
    </dd>
    <%# What is actually recorded is that the send was ATTEMPTED, not that it
        arrived: BatchProcessor sets the flag after the Graph call returns, and
        a bounce afterwards is invisible here. "Yes" read as delivery. %>
    <dt class="font-medium">Producer emails</dt>
    <dd>
      <% if @batch.producer_notifications_sent %>
        <%= render BadgeComponent.new(type: :success, pill: true).with_content("Sent") %>
        <span class="text-gray-500">(sending was recorded as successful; delivery is not tracked)</span>
      <% else %>
        <%= render BadgeComponent.new(type: :warning, pill: true).with_content("Not sent: needs a look") %>
      <% end %>
    </dd>
    <% if @batch.sharepoint_backup_url.present? %>
      <dt class="font-medium">BACS xlsx</dt>
      <dd><%= link_to @batch.sharepoint_backup_url, @batch.sharepoint_backup_url,
                      class: "text-info underline", target: "_blank", rel: "noopener" %></dd>
    <% end %>
  </dl>

  <% if @batch.notes.present? %>
    <div class="mt-3">
      <p class="text-sm font-medium">Notes</p>
      <pre class="mt-1 whitespace-pre-wrap text-xs text-gray-600"><%= @batch.notes %></pre>
    </div>
  <% end %>
<% end %>

<%= render CardComponent.new(title: "#{@expenses.size} #{'expense'.pluralize(@expenses.size)}", html_class: "mt-4") do %>
  <% if @expenses.empty? %>
    <p class="py-2 text-gray-600">No expenses linked to this batch.</p>
  <% else %>
    <div class="table-scroll">
      <table class="w-full text-sm table-sticky-head">
        <thead class="text-left text-gray-500 border-b border-gray-200">
          <tr>
            <th scope="col" class="py-1 pr-3">#</th>
            <th scope="col" class="py-1 pr-3">Payee</th>
            <th scope="col" class="py-1 pr-3 text-right">Amount</th>
            <th scope="col" class="py-1 pr-3">Budget</th>
            <th scope="col" class="py-1 pr-3">Nominal</th>
            <th scope="col" class="py-1 pr-3">Status</th>
            <th scope="col" class="py-1 pr-3">Description</th>
          </tr>
        </thead>
        <tbody>
          <% @expenses.each do |expense| %>
            <tr class="border-b border-gray-100 align-top">
              <%# Open the claim itself: the rows named a number and nothing
                  else, so checking one meant searching for it by hand. %>
              <td class="py-1 pr-3">
                <%= link_to expense.auto_number,
                            edit_admin_reimbursements_expense_edit_path(expense.record_id),
                            class: "text-primary underline" %>
              </td>
              <td class="py-1 pr-3"><%= expense.effective_payee_name %></td>
              <td class="py-1 pr-3 text-right"><%= reimbursements_money(expense.amount) %></td>
              <td class="py-1 pr-3"><%= expense.budget&.display_name %></td>
              <td class="py-1 pr-3"><%= expense.effective_nominal_code %></td>
              <td class="py-1 pr-3">
                <%= render BadgeComponent.new(type: ::Reimbursements::Status.badge_variant(expense.status), pill: true)
                              .with_content(expense.status) %>
              </td>
              <td class="py-1 pr-3"><%= expense.description %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
