<% @answers.each_with_index do |answer, index| %>
  <div class="<%= separator_class if index > 0 %>">
    <div class="<%= question_class %>"><%= helpers.render_markdown answer.question.question_text %></div>
    <div class="<%= answer_class %>">
      <% if answer.attachments.present? %>
        <%# Normally one attachment, but more is possible. %>
        <% if answer.attachments.one? %>
          <%= render AttachmentCardComponent.new(attachment: answer.attachments.first) %>
        <% else %>
          <%= render AttachmentsGalleryComponent.new(attachments: answer.attachments) %>
        <% end %>
      <% end %>

      <% if answer.answer.present? %>
        <%= helpers.render_markdown answer.answer %>
      <% elsif answer.attachments.empty? %>
        <span class="italic text-gray-400">This question has not been answered.</span>
      <% end %>
    </div>
  </div>
<% end %>
