<p>Hi <%= eusa_contact_name.presence || "Finance Team" %>,</p>

<p>
  Please find attached the BACS request from <%= cost_centre_name %> for <%= reimbursements_date(bacs_date) %>,
  covering <%= expense_count %> <%= "expense".pluralize(expense_count) %> totalling
  <%= reimbursements_money(total) %>.
</p>

<p>Individual receipts are also attached, named by date, budget and description.</p>

<% if international_count.positive? %>
  <p>
    <%= international_count %> of these <%= international_count == 1 ? "is an" : "are" %>
    international <%= "payment".pluralize(international_count) %>, each on its own
    international payment request form, attached alongside. Their amounts below are shown in
    the currency of the payment.
  </p>
<% end %>

<table border="1" cellspacing="0" cellpadding="4" style="border-collapse: collapse; font-family: sans-serif;">
  <thead style="background-color: #f0f0f0;">
    <tr>
      <th scope="col">Payee</th>
      <th scope="col">Amount</th>
      <th scope="col">Budget</th>
      <th scope="col">Nominal</th>
      <th scope="col">Description</th>
    </tr>
  </thead>
  <tbody>
    <% expenses.each do |expense| %>
      <tr>
        <td><%= expense.effective_payee_name %></td>
        <td><%= reimbursements_payment_amount(expense) %></td>
        <td><%= expense.budget&.display_name %></td>
        <td><%= expense.effective_nominal_code %></td>
        <td><%= expense.description %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>
  All the best,<br>
  <%= sender_name %><br>
  <%= cost_centre_name %>
</p>
