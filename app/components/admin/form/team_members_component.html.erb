<div class="form-horizontal">
  <%= render(CollapsibleSectionComponent.new(title: 'Team Members', html_class: "mb-4")) do %>
    <div>
      <%= helpers.display_block("Adding Team Members Explanation", false) %>
    </div>

    <% if show_bulk_import_link? %>
      <div class="mb-3">
        <%= helpers.get_link @f.object, :edit, link_text: "Bulk Import Team", link_target: bulk_import_path %>
      </div>
    <% end %>

    <%# In saved order, not id order: the sortable controller renumbers every row from its
        on-screen position after a drag, so rows laid out in id order would have one drag
        overwrite the whole saved ordering. %>
    <%= render('shared/form/sections/nested_fields', f: @f, association_name: :team_members, partial_name: 'team_member_fields', sortable: true,
               collection: TeamMember.in_display_order(@f.object.team_members)) %>
  <% end %>
</div>
