<%# The cost-centre scope for the finance lists. URL-as-state: each centre is a
    plain link carrying the page's other query parameters, so a filter or a CSV
    link survives switching pot. "All" is the default, because
    CostCentre.default is order(:id).first — defaulting to a centre would
    silently empty the other one's screens. Its link sends an explicit empty
    cost_centre= so the user's home centre does not replace it on the sidebar's
    next click. Renders nothing until a
    second cost centre exists — one is not a choice. %>
<% if selectable_cost_centres.size > 1 %>
  <div class="mb-3 flex flex-wrap items-center gap-2" role="group" aria-label="Cost centre">
    <span class="text-sm text-gray-600">Cost centre:</span>
    <% [ nil, *selectable_cost_centres ].each do |centre| %>
      <% selected = centre == selected_cost_centre %>
      <%= link_to centre&.name || "All",
                  url_for(request.query_parameters.merge(cost_centre: centre&.key || "",
                                                         cost_centre_id: nil, page: nil)),
                  "aria-current": (selected ? "true" : nil),
                  class: class_names(
                    "rounded border px-2 py-1 text-sm",
                    "border-blue-600 bg-blue-50 font-medium text-blue-800" => selected,
                    "border-gray-300 text-gray-700 hover:bg-gray-50" => !selected
                  ) %>
    <% end %>
    <% if selected_cost_centre %>
      <% if current_user.reimbursements_cost_centre_id == selected_cost_centre.id %>
        <span class="text-sm text-gray-600">Your default</span>
        <%= button_to "Clear default", admin_reimbursements_home_cost_centre_path, method: :delete,
                      class: "text-sm text-gray-600 underline", form_class: "inline" %>
      <% else %>
        <%= button_to "Make this my default",
                      admin_reimbursements_home_cost_centre_path(cost_centre: selected_cost_centre.key),
                      method: :patch, class: "text-sm text-primary underline", form_class: "inline" %>
      <% end %>
    <% end %>
  </div>
<% end %>
