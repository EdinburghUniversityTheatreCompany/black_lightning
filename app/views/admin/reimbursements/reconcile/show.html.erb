<%# The whole wizard lives in one Turbo Frame: preview/apply POST back the full
    pasted text and render their step directly (the wizard is stateless, so a
    redirect can't carry the paste). Outside a frame Turbo Drive REJECTS
    non-redirect form responses and silently discards them — the buttons would
    do nothing. Inside the frame, direct renders are valid and turbo_confirm
    still works. %>
<%= turbo_frame_tag "reconcile" do %>
<p class="mb-3 text-gray-600">
  Import the monthly EUSA actuals sheet and reconcile it against submitted expenses
  and income budgets. Copy the actuals rows from Excel or the email and paste them
  below. Both the legacy format (Nominal, Cost Centre, Ref, …) and the Sage export
  (AccountNumber, …, GoodsValueInBaseCurrency) are accepted; the header identifies
  the columns automatically.
</p>

<% if flash[:alert].present? %>
  <%= render AlertComponent.new(type: :danger) do %><%= flash[:alert] %><% end %>
<% end %>

<%= form_with url: preview_admin_reimbursements_reconciliation_path, method: :post do %>
  <%= render CardComponent.new(title: "Step 1: Paste actuals data") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Parse and match" %>
    <% end %>

    <%= render "shared/form/paste_or_upload",
          text_name: :pasted_text,
          text_label: "Actuals data (tab- or comma-separated, include the header row)",
          text_value: @pasted_text, rows: 10,
          placeholder: "Nominal\tCost Centre\tRef\tDate\tPeriod\tNarrative\tNarrative 1\tDebit\tCredit\tNet",
          text_hint: "Each row's EUSA period (P1–P12) and cost centre are read from the pasted data, so " \
                     "there's no need to enter a month or pick a cost centre. A paste may cover several " \
                     "cost centres: each row is imported under its own, rows naming a cost centre that " \
                     "isn't set up here are skipped (and reported), and rows with no cost centre at all " \
                     "will ask you where they belong." %>
  <% end %>
<% end %>
<% end %>
