<%# Every step lives in one Turbo Frame: Turbo Drive drops a non-redirect
    response to a form POST, and a stateless wizard cannot redirect without
    losing the paste. Inside a frame a direct render works. %>
<%= turbo_frame_tag "budget_import" do %>
<%# A link out of the frame needs turbo_frame: "_top", or it lands as
    "Content missing". %>
<%= render "shared/back_link", text: "All budgets", turbo_frame: "_top",
           path: admin_reimbursements_budgets_path(year: selected_financial_year&.key) %>

<%# The layout's flash is outside this frame. %>
<% if flash[:alert].present? %>
  <%= render AlertComponent.new(type: :danger) do %><%= flash[:alert] %><% end %>
<% end %>

<%= form_with url: preview_admin_reimbursements_budget_import_path,
              method: :post, multipart: true do %>
  <%= render CardComponent.new(title: "Import budgets") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Preview import",
            cancel_path: admin_reimbursements_budgets_path(year: selected_financial_year&.key),
            submit_html: { data: { disable_with: "Reading…" } } %>
    <% end %>

    <p class="mb-4 text-sm text-gray-600">
      Paste the committee's budget sheet (including its header row) or upload the .xlsx. Nothing is
      written yet: the next screen shows exactly what would be created and what would change, and
      you confirm from there. Re-importing a revised sheet later is fine: matching lines are updated
      rather than duplicated, and their agreed opening figure is left alone.
    </p>

    <p class="mb-4 text-sm text-gray-600">
      Only the budget name is required. Two columns hold money: <strong>Area total</strong> is the
      show's agreed total, repeated on every row of that area, and <strong>Budget amount</strong> is
      that line's own figure.
      <%= link_to "Download a template",
                  template_admin_reimbursements_budget_import_path(format: :csv),
                  class: "text-primary underline", data: { turbo_frame: "_top" } %>.
    </p>

    <div class="flex flex-col gap-4">
      <%= render "shared/form/field", label: "Financial year", name: :year,
            html_class: "sm:w-1/2" do %>
        <%= select_tag :year,
                       options_from_collection_for_select(selectable_financial_years, :key, :label,
                                                          selected_financial_year&.key),
                       class: input_classes %>
      <% end %>

      <%= render "shared/form/field", label: "Cost centre", name: :cost_centre_id,
            html_class: "sm:w-1/2" do %>
        <%= select_tag :cost_centre_id,
                       options_from_collection_for_select(selectable_cost_centres, :id, :name,
                                                          (chosen_cost_centre || current_user.reimbursements_cost_centre)&.id),
                       include_blank: "Choose a cost centre…", class: input_classes %>
      <% end %>

      <%= render "shared/form/paste_or_upload",
            text_name: :pasted_text, text_label: "Paste the sheet", text_value: params[:pasted_text],
            rows: 12, placeholder: ::Reimbursements::BudgetImport::TSV_HEADERS.join("\t"),
            file_name: :file, file_label: "…or upload an .xlsx", file_accept: ".xlsx",
            file_hint: "The first sheet's first row is read as the header. A file takes precedence " \
                       "over pasted text." %>
    </div>
  <% end %>
<% end %>
<% end %>
