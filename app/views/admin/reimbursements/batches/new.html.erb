<p class="mb-3 text-gray-600">
  Every Approved expense goes into one BACS request. The money path uses each expense's
  <strong>effective</strong> payee and bank details, so an invoice override pays the third party
  directly (flagged "→ third party" below). Processing creates a <strong>draft</strong> in
  <%= @cost_centre.send_mailbox %> for you to review and send. Nothing is emailed to EUSA
  automatically.
</p>

<% if @expenses.empty? %>
  <%= render AlertComponent.new(type: :info) do %>
    No approved expenses to batch. Approve some on the Review queue first.
  <% end %>
<% else %>
  <%= render CardComponent.new(title: "#{@expenses.size} #{'expense'.pluralize(@expenses.size)} (#{reimbursements_money(@total)})") do %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-gray-500 border-b border-gray-200">
          <tr>
            <th scope="col" class="py-1 pr-3">#</th>
            <th scope="col" class="py-1 pr-3">Payee</th>
            <th scope="col" class="py-1 pr-3">Bank details</th>
            <th scope="col" class="py-1 pr-3 text-right">Amount</th>
            <th scope="col" class="py-1 pr-3">Nominal</th>
            <th scope="col" class="py-1 pr-3">Budget</th>
            <th scope="col" class="py-1 pr-3">Description</th>
            <th scope="col" class="py-1 pr-3 text-right">Receipts</th>
          </tr>
        </thead>
        <tbody>
          <% @expenses.each do |expense| %>
            <tr class="border-b border-gray-100 align-top">
              <td class="py-1 pr-3"><%= expense.auto_number %></td>
              <td class="py-1 pr-3">
                <%= expense.effective_payee_name %>
                <% if expense.payee_override? %>
                  <%= render BadgeComponent.new(type: :warning, pill: true).with_content("→ third party") %>
                <% end %>
              </td>
              <%# The one screen that would otherwise print every payee's
                  account number on page load. %>
              <td class="py-1 pr-3">
                <%= render Admin::Reimbursements::BankDetailsComponent.new(
                      sort_code: expense.effective_sort_code,
                      account_number: expense.effective_account_number,
                      payee: expense.effective_payee_name) %>
              </td>
              <td class="py-1 pr-3 text-right"><%= reimbursements_money(expense.amount) %></td>
              <td class="py-1 pr-3"><%= expense.effective_nominal_code %></td>
              <td class="py-1 pr-3"><%= expense.budget&.name %></td>
              <td class="py-1 pr-3"><%= expense.description %></td>
              <td class="py-1 pr-3 text-right"><%= expense.receipt_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%= form_with url: admin_reimbursements_batches_path, method: :post do %>
    <%= render CardComponent.new(title: "EUSA email", html_class: "mt-4") do |card| %>
      <% card.with_footer do %>
        <%= render "shared/form/actions", submit: "Create draft and process batch",
              cancel_path: admin_reimbursements_batches_path,
              submit_html: { data: { turbo_confirm: "Create the EUSA draft and mark #{@expenses.size} " \
                                                    "#{'expense'.pluralize(@expenses.size)} as Submitted?" } },
              note: "Processing will: generate the xlsx, upload it and every receipt to SharePoint, " \
                    "create the EUSA draft (you send it manually), record the batch, mark these " \
                    "expenses Submitted, and email each producer that their expense was submitted." %>
      <% end %>

      <div class="flex flex-col gap-4">
        <div class="grid gap-4 sm:grid-cols-3">
          <%= render "shared/form/field", label: "BACS date", name: :bacs_date do %>
            <%= date_field_tag :bacs_date, @bacs_date, class: input_classes %>
          <% end %>
          <%= render "shared/form/field", label: "EUSA recipient", name: :eusa_recipient do %>
            <%= text_field_tag :eusa_recipient, @eusa_recipient, class: input_classes %>
          <% end %>
          <%= render "shared/form/field", label: "Your name (signature)", name: :sender_name do %>
            <%= text_field_tag :sender_name, @sender_name, class: input_classes %>
          <% end %>
        </div>

        <%= render "shared/form/field", label: "Subject", name: :eusa_subject do %>
          <%= text_field_tag :eusa_subject, @default_email.subject, class: input_classes %>
        <% end %>

        <%= render "shared/form/field", label: "Body (HTML)", name: :eusa_body,
              hint: "Sent from #{@cost_centre.send_mailbox}." do %>
          <%= text_area_tag :eusa_body, @default_email.body_html, rows: 16, class: input_classes("font-mono") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
