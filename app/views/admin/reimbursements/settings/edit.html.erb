<%= render "shared/back_link", text: "All cost centres", path: admin_reimbursements_settings_path %>

<%= simple_form_for @cost_centre, as: :cost_centre,
                    url: admin_reimbursements_setting_path(@cost_centre.key), method: :patch do |f| %>
  <%= render CardComponent.new(title: "#{@cost_centre.name} (#{@cost_centre.eusa_code})") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Save settings",
            cancel_path: admin_reimbursements_settings_path %>
    <% end %>

    <%= f.input :short_code, label: "Short code",
          placeholder: @cost_centre.eusa_code,
          hint: "Prefixes this cost centre's budgets in every picker " \
                "(\"BF - Improverts: Other\"), so a producer choosing a budget can tell two " \
                "centres' lines apart. Left blank it falls back to the EUSA code." %>

    <div class="grid gap-x-4 sm:grid-cols-2">
      <%= f.input :receive_mailbox, label: "Receive mailbox (email-in)" %>
      <%= f.input :send_mailbox, label: "Send-from mailbox (drafts)" %>
    </div>
    <p class="<%= FormStyles::HINT %> -mt-2 mb-4">
      Changing a mailbox breaks email-in / draft-sending until the new address is added to the app's
      Exchange management scope (see the Microsoft setup page linked below). Run the access
      check after changing it.
    </p>

    <%= f.input :notification_email, label: "Notification email",
          placeholder: "finance@bedlamfringe.co.uk",
          wrapper_html: { class: (@cost_centre.notification_recipients_empty? ? "mb-2" : "mb-4") },
          hint: "This cost centre's own finance mailbox. It gets the nightly reminders: claims " \
                "stuck awaiting approval, and the queue ready to batch. Separate several " \
                "addresses with semicolons. (A claim waiting on a budget owner is emailed to " \
                "that owner instead, not here.)" %>
    <% if @cost_centre.notification_recipients_empty? %>
      <div class="mb-4">
        <%= render AlertComponent.new(type: :warning) do %>
          <strong>Nobody gets this cost centre's reminders</strong> until an address is set here.
          The nightly logs a warning and retries rather than marking the day handled, so nothing
          is lost, but nothing is sent either.
        <% end %>
      </div>
    <% end %>

    <%= f.input :sharepoint_site_url, label: "SharePoint site URL",
          placeholder: "https://tenant.sharepoint.com/sites/Finance",
          hint: safe_join([ "The site holding this cost centre's receipts + BACS folders. The app is granted ",
                            tag.code("write"),
                            " on just this site (Sites.Selected), and the folder picker below browses it. ",
                            "The grant command is on the Microsoft setup page linked below." ]) %>

    <div class="grid gap-x-4 sm:grid-cols-3">
      <%= f.input :eusa_recipient, label: "EUSA recipient",
            placeholder: ::Reimbursements::CostCentre::DEFAULT_EUSA_RECIPIENT,
            hint: "Where the completed BACS request email (with the bank-detail attachments) is sent. " \
                  "Leave blank to use EUSA finance's default address." %>
      <%= f.input :eusa_contact_name, label: "EUSA contact name", placeholder: "Finance Team",
            hint: "Who the BACS request email greets: the EUSA finance person handling our payments. " \
                  "Leave blank to open with \"Hi Finance Team,\"." %>
      <%= f.input :eusa_signature_name, label: "EUSA email signature name",
            hint: "Who that email is signed off as when no operator name is available. " \
                  "Leave blank to sign off as \"#{@cost_centre.name} Finance\"." %>
    </div>

    <%= f.input :nightly_run_days, as: :check_boxes, label: "Nightly reminders run on",
          collection: Date::DAYNAMES.each_with_index.map { |day_name, wday| [ day_name, wday ] },
          wrapper: :vertical_collection_inline, wrapper_html: { class: "mb-0" },
          hint: "Pick at least one day; the nightly can't be turned off by unchecking them all." %>
  <% end %>
<% end %>

<%# The Microsoft 365 setup steps moved to their OWN page: they are needed once
    per cost centre, by somebody with Exchange or SharePoint admin rights who is
    usually not the person editing these settings, and a wall of PowerShell and
    Graph JSON sat between the routine controls an operator edits weekly. %>
<%= render AlertComponent.new(type: :info, html_class: "mb-4") do %>
  Setting this cost centre up for the first time?
  <%= link_to "What IT has to do in Microsoft 365",
              microsoft_setup_admin_reimbursements_setting_path(@cost_centre.key),
              class: "underline font-medium" %>
  covers mailbox authorisation and the SharePoint grant. Day-to-day use needs none of it, and
  that page is safe to forward.
<% end %>

<%= render CardComponent.new(title: "Check Microsoft access", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-2">
    Probe this cost centre's mailboxes and SharePoint site with the app's own credentials, so you can
    confirm the Microsoft grants worked before relying on email-in or Build Batch.
  </p>
  <%= button_to "Run access check", test_access_admin_reimbursements_setting_path(@cost_centre.key),
                method: :post, class: btn_classes(:secondary, :sm),
                data: { turbo_submits_with: "Testing…" } %>
  <div id="access_check_results" aria-live="polite">
    <%= render "access_checks", checks: @access_checks %>
  </div>
<% end %>

<%= render CardComponent.new(title: "SharePoint destinations", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-3">
    Where the nightly and Build Batch upload renamed receipts and the BACS request xlsx. Browse to a
    folder and choose it; the drive and folder are stored so uploads land in the same place every time.
  </p>
  <%= render "folder_picker", purpose: "receipts", label: "Receipts folder",
             folder: @cost_centre.receipts_folder %>
  <div class="mt-4">
    <%= render "folder_picker", purpose: "bacs", label: "BACS request folder",
               folder: @cost_centre.bacs_folder %>
  </div>
<% end %>

<%= render CardComponent.new(title: "Budgets", html_class: "mt-4") do %>
  <p class="text-sm text-gray-600 mb-3">
    Set this cost centre's budgets up from the committee's spreadsheet: paste it or upload the
    .xlsx, check what it would do, then confirm. You pick the financial year in the wizard, so the
    same sheet can be imported into next year while this one is still being paid out of.
  </p>
  <%= link_to "Import budgets into #{@cost_centre.name}",
              admin_reimbursements_budget_import_path(cost_centre: @cost_centre.key),
              class: btn_classes(:secondary, :sm) %>
<% end %>

<%= render "nominal_codes", nominal_codes_locals(@cost_centre) %>
