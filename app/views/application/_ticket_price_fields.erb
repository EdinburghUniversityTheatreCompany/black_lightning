<%# locals: (f:, dynamic: nil) %>

<div class="ticket-price mb-2 flex flex-wrap items-end gap-3">
  <%= f.input :amount, label: 'Amount', wrapper: :inline_form,
        input_html: { step: '0.01', min: 0, placeholder: 'Amount', value: f.object.amount_field_value } %>

  <%# Fixed width: a select sizes itself to its longest option, so without this
      every row ends at a different x and the Remove buttons come out ragged. %>
  <div class="w-40 shrink-0">
    <%= f.input :category, label: 'Band', wrapper: :inline_form, include_blank: false,
          collection: Event::TicketPrice::CATEGORY_LABELS.map { |value, label| [label, value] } %>
  </div>

  <%# Only meaningful for the Other band, so it does not get to dominate the row. %>
  <div class="w-56 shrink-0">
    <%= f.input :label, placeholder: 'Label (Other only)', wrapper: :inline_form %>
  </div>

  <%= link_to_remove(f) %>
</div>
