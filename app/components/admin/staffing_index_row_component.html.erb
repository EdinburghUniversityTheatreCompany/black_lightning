<table class="table table-hover mb-0">
  <thead>
    <tr>
      <th scope="col" style="width: 48%;">Name</th>
      <th scope="col" style="width: 40%;">Dates</th>
      <th scope="col" style="width: 12%;">Positions</th>
    </tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr class="<%= 'table-warning' if row[:show_warning] %>">
        <td><%= link_to row[:show_title], row[:href], class: "block" %></td>
        <td><%= link_to row[:date_range], row[:href], class: "block" %></td>
        <td><%= link_to row[:positions_filled], row[:href], class: "block" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
