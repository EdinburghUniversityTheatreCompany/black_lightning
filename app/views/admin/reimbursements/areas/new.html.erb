<%= render "shared/back_link", text: "All areas", path: admin_reimbursements_areas_path(year: selected_financial_year&.key) %>

<%= simple_form_for @area, as: :reimbursements_area,
                    url: admin_reimbursements_areas_path(year: selected_financial_year&.key) do |form| %>
  <%= render CardComponent.new(title: "New area") do |card| %>
    <% card.with_footer do %>
      <%= render "shared/form/actions", submit: "Create area",
            cancel_path: admin_reimbursements_areas_path(year: selected_financial_year&.key) %>
    <% end %>

    <p class="mb-4 text-sm text-gray-600">
      A show, project or heading several budget lines belong to. Once it exists you can add
      its budget lines from the edit page.
      <% if selected_financial_year %>
        This area will belong to <strong><%= selected_financial_year.label %></strong>.
      <% end %>
    </p>

    <%= render "fields", form: form, people: @people, cost_centres: @cost_centres,
          owner_ids: @owner_ids, cost_centre_id: selected_cost_centre&.id %>
  <% end %>
<% end %>
