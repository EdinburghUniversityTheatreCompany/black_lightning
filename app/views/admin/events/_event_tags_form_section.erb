<%# locals: (f:) %>

<%# An untagged event is advisory, not an error: say so under the field rather
    than in a red box between two unrelated rows. %>
<% no_tags_hint = "This event has no tags yet. Tag it so it appears in the right lists." if f.object.event_tags.empty? %>

<%= f.association(:event_tags, collection: EventTag.accessible_by(current_ability),
      input_html: { multiple: 'multiple' },
      hint: no_tags_hint, hint_html: { id: "no_event_tags_warning", class: "text-warning" }) %>
