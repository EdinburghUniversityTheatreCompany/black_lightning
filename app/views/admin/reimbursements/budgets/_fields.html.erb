<%# locals: (form:, people:, name:, nominal_code:, budget_type:, initial_budget:, active:, owner_ids:, notes:, cost_centres: [], cost_centre_id: nil, areas: [], area_id: nil, owners_from_area: nil) %>
<%# The budget fields, shared by new (values from params) and edit (values
    from the budget). The cost centre picker only exists on new and only when
    there is a choice to make. %>
<div class="flex flex-col gap-4" data-controller="reimbursements-budget-area">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "shared/form/field", label: "Name", name: :name do %>
      <%= text_field_tag :name, name, class: input_classes %>
    <% end %>
    <%= render "shared/form/field", label: "Nominal code", name: :nominal_code do %>
      <%= text_field_tag :nominal_code, nominal_code, class: input_classes %>
    <% end %>
    <%= render "shared/form/field", label: "Type", name: :budget_type do %>
      <%= select_tag :budget_type, options_for_select(::Reimbursements::Budget::TYPES, budget_type),
                     class: input_classes %>
    <% end %>
    <%= render "shared/form/field", label: "Initial budget (£)", name: :initial_budget do %>
      <%= number_field_tag :initial_budget, reimbursements_amount_value(initial_budget), step: "0.01", class: input_classes %>
    <% end %>
    <%= render "shared/form/field", label: "Area", name: :area_id,
          hint: "Leave blank for a standalone line like Contingency or payroll." do %>
      <%# input_classes, not simple-select2: the Type and Cost centre selects on
          this form are already plain styled ones, and a lone Tom Select widget
          among them would read as a different kind of control. %>
      <%= select_tag :area_id,
            options_from_collection_for_select(areas, :record_id, :name, area_id),
            include_blank: "— none —", class: input_classes,
            data: { reimbursements_budget_area_target: "area",
                    action: "change->reimbursements-budget-area#areaChanged" } %>
    <% end %>
    <% if cost_centres.size > 1 %>
      <%= render "shared/form/field", label: "Cost centre", name: :cost_centre_id do %>
        <%= select_tag :cost_centre_id,
                       options_from_collection_for_select(cost_centres, :id, :name, cost_centre_id),
                       class: input_classes %>
      <% end %>
    <% end %>
  </div>

  <label class="inline-flex items-center gap-2 text-sm text-gray-700">
    <%= check_box_tag :active, "1", active, class: checkbox_classes %>
    Visible to submitters
  </label>

  <% if owners_from_area %>
    <%# READ-ONLY, and deliberately so. The area owns and its budgets inherit,
        so Budget#owners READS the area's owners while sync_owner_ids! WRITES
        the budget's own rows — an editable list here reads one table and
        writes another, deleting the own-owner rows the backfill kept so it
        can be reversed (silently, since the screen keeps showing the area's
        owners). BudgetsController#budget_params omits owner_ids entirely for
        an area-bound budget, so nothing posted from here can be written
        either. Ownership is edited on the AREA. %>
    <div>
      <p class="<%= FormStyles::LABEL %>">Owners</p>
      <% owner_names = owners_from_area.owners.map { |person| person.name.presence || person.email } %>
      <p class="text-sm text-gray-700">
        <% if owner_names.any? %>
          Owned by <%= owner_names.to_sentence %> —
        <% else %>
          <%= render(BadgeComponent.new(type: :warning, pill: true).with_content("No owner")) %> —
        <% end %>
        <%= link_to "edit on the area", edit_admin_reimbursements_area_path(owners_from_area.record_id),
              class: "text-primary underline" %>
      </p>
      <% if owner_names.empty? %>
        <%# An area naming nobody switches the gate OFF for every line under it
            (OwnerReview.gate_applies? is false with no owners), so the form
            that can attach a line to one says so. %>
        <p class="mt-1 text-sm text-warning">
          This area names nobody, so claims on this line skip budget-owner sign-off entirely.
        </p>
      <% end %>
    </div>
  <% else %>
    <%# Disabled by the reimbursements-budget-area controller the moment an area
        is chosen, because the area owns and its budgets inherit: the list would
        write own_owners, which Budget#owners stops reading as soon as there is
        an area. BudgetsController refuses such a post rather than storing rows
        nothing consults, so with JavaScript off the operator is told; with it
        on they never reach the refusal. %>
    <fieldset aria-describedby="owner_ids_hint"
              data-reimbursements-budget-area-target="owners">
      <legend class="<%= FormStyles::LABEL %>">Owners</legend>
      <%# A checkbox list instead of a native Ctrl/Cmd-click multi-select. Rails'
          collection_check_boxes emits the empty hidden field itself, so unticking
          everyone still clears the owners. %>
      <div class="flex max-h-48 flex-col gap-1 overflow-y-auto">
        <%= form.collection_check_boxes(:owner_ids, people, :record_id,
              ->(person) { person.name.presence || person.email },
              { checked: owner_ids }) do |b| %>
          <%= b.label(class: "flex items-center gap-2 text-sm text-gray-700") do %>
            <%= b.check_box(class: checkbox_classes) %><%= b.text %>
          <% end %>
        <% end %>
      </div>
      <p id="owner_ids_hint" class="<%= FormStyles::HINT %>">Tick everyone who owns this budget.
        A line placed in an area takes its owners from the area, and they are set there.</p>
    </fieldset>
    <p class="text-sm text-gray-700" hidden
       data-reimbursements-budget-area-target="notice">
      This line goes in an area, so it takes the area's owners — set them on the area itself.
    </p>
  <% end %>

  <%= render "shared/form/field", label: "Notes", name: :notes do %>
    <%= text_area_tag :notes, notes, rows: 3, class: input_classes %>
  <% end %>
</div>
