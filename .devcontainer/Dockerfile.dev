# syntax=docker/dockerfile:1
# Development container for BlackLightning.
#
# mise (mise/config.toml + mise/mise.lock) is the single source of truth for the toolchain: Ruby,
# Node and the hk / pkl / gitleaks / zizmor / actionlint dev tools. This image installs only mise
# plus the OS libraries to run the toolchain and compile the app's native gems; `mise install`
# in setup.sh does the rest. Never pin a language version here (no `ruby:x.y` base, no
# `apt-get install nodejs`): that reintroduces the drift. To change a version, edit mise/config.toml.
#
# Base: debian:trixie-slim, the same Debian release (glibc 2.41) as production's `ruby:4.0.2-slim`,
# so native gems compiled into the persistent /bundle volume load in both (a bookworm base
# fails with "GLIBC_2.xx not found"). Bump this with the Ruby image.
FROM debian:trixie-slim

# System packages: dev tooling, a C toolchain + headers for the app's native gems (bcrypt, mysql2,
# nio4r, puma; Ruby itself is precompiled, see mise/config.toml), and the app's runtime libraries.
# Keep the last group in step with the production Dockerfile's base stage. poppler-utils renders a
# PDF's first page for ActiveStorage previews (the receipt viewer), and libheif-plugin-libde265
# lets libvips decode the HEVC inside a HEIC (iOS photos), which receipts convert to JPEG.
RUN --mount=type=cache,id=apt-cache-dev,target=/var/cache/apt,sharing=locked \
    apt-get update -qq && \
    apt-get install --no-install-recommends -y -o Acquire::Retries=3 \
      build-essential \
      ca-certificates \
      curl \
      git \
      gnupg \
      sudo \
      extrepo \
      libssl-dev \
      zlib1g-dev \
      libyaml-dev \
      libffi-dev \
      libmariadb-dev-compat \
      pkg-config \
      default-mysql-client \
      libvips \
      libheif-plugin-libde265 \
      poppler-utils \
      libjemalloc2 \
      tzdata && \
    rm -rf /var/lib/apt/lists/*

# Install mise from its apt repository rather than `curl | sh`: extrepo verifies the repo's
# metadata against keys shipped in extrepo-data, so the package is GPG-verified.
RUN --mount=type=cache,id=apt-cache-dev,target=/var/cache/apt,sharing=locked \
    extrepo enable mise && \
    apt-get update -qq && \
    apt-get install --no-install-recommends -y -o Acquire::Retries=3 mise && \
    rm -rf /var/lib/apt/lists/*

# Non-root user with passwordless sudo. The container runs as root so volume mounts are
# writable; remoteUser in devcontainer.json switches the developer shell to vscode.
RUN groupadd --gid 1000 vscode && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash vscode && \
    echo "vscode ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/vscode

USER vscode

# The toolchain lives under MISE_DATA_DIR, a named volume in compose.yaml so it survives rebuilds.
# Shims go on PATH for non-interactive commands (VS Code tasks); interactive shells activate mise.
ENV MISE_DATA_DIR=/home/vscode/.local/share/mise
ENV PATH=${MISE_DATA_DIR}/shims:${PATH}
# Create the mise data and state dirs as vscode before the volume mounts, so a fresh volume is
# owned by vscode and ~/.local stays writable (mise keeps its trusted configs in ~/.local/state).
RUN mkdir -p "${MISE_DATA_DIR}" /home/vscode/.local/state/mise && \
    echo 'eval "$(mise activate bash)"' >> /home/vscode/.bashrc

WORKDIR /workspaces/BlackLightning
