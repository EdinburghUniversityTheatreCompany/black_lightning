<%# Reuses the ?person=<id> this page already carries, rather than a second
    parameter meaning the same thing — the row is opened server-side and this
    scrolls to it. See scroll_to_controller for why a redirect's fragment is
    not enough. %>
<div data-controller="scroll-to" data-scroll-to-param-value="person"
     data-scroll-to-prefix-value="person-"></div>
<p class="mb-3 text-gray-600">
  The finance team's payee registry. Edit a person's bank details (every change is
  recorded in their notes) and mark them verified once their details are confirmed.
</p>

<% if @duplicates.any? %>
  <%= render AlertComponent.new(type: :warning) do %>
    <p class="font-medium mb-1">Duplicate name or email detected, please review:</p>
    <ul class="list-disc list-inside">
      <% @duplicates.each do |person| %>
        <li>
          <strong><%= person.name.presence || "(no name)" %></strong>
          (<%= person.email.presence || "no email" %>)
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Find a person") do %>
  <%# A GET with the term in the URL, so a search is a link somebody can send
      or bookmark (house rule: the URL is the state). %>
  <%= form_with url: admin_reimbursements_people_path, method: :get,
                class: "flex flex-wrap items-end gap-3" do %>
    <div>
      <%= label_tag :q, "Name or email", class: FormStyles::LABEL %>
      <%= text_field_tag :q, @query, placeholder: "part of a name or address",
                         class: input_classes(width: "w-64") %>
    </div>
    <%= submit_tag "Search", class: btn_classes(:secondary, :sm) %>
    <% if @query.present? %>
      <%= link_to "Clear", admin_reimbursements_people_path, class: "text-sm text-gray-600 underline" %>
    <% end %>
  <% end %>

  <%# What the six badges mean, once, where they are read. "Outside spec" in
      particular says nothing about the details being wrong: Pay.UK publishes
      no rule for that sort code (or the rule files are missing), so the check
      could not run. %>
  <details class="mt-3 text-sm">
    <summary class="cursor-pointer text-gray-600 underline">What the badges mean</summary>
    <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-gray-600">
      <dt><%= render BadgeComponent.new(type: :success, pill: true).with_content("Valid") %></dt>
      <dd>The sort code and account number pass Pay.UK's modulus check: they are a
          self-consistent pair. It catches typos, not fraud.</dd>
      <dt><%= render BadgeComponent.new(type: :danger, pill: true).with_content("Invalid") %></dt>
      <dd>They fail that check, so at least one digit is wrong. Fix them before paying.</dd>
      <dt><%= render BadgeComponent.new(type: :warning, pill: true).with_content("Outside spec") %></dt>
      <dd>Pay.UK publishes no rule covering that sort code, so the check could not run.
          This does <strong>not</strong> mean the details are wrong.</dd>
      <dt><%= render BadgeComponent.new(type: :warning, pill: true).with_content("Missing") %></dt>
      <dd>No bank details on file. A budget owner who never claims needs none.</dd>
      <dt><%= render BadgeComponent.new(type: :success, pill: true).with_content("Verified") %></dt>
      <dd>Somebody in finance confirmed these details against the payee. Saving a change
          clears it, since nobody has re-checked what replaced them.</dd>
      <dt><%= render BadgeComponent.new(type: :secondary, pill: true).with_content("Unverified") %></dt>
      <dd>Nobody has confirmed them yet. The correct end state for a budget owner who
          never claims.</dd>
    </dl>
  </details>
<% end %>

<div class="mb-2 flex flex-wrap items-center justify-end gap-2">
  <%= link_to "Register a person", new_admin_reimbursements_person_path,
              class: btn_classes(:primary, :sm) %>
  <%= link_to "Download CSV",
              admin_reimbursements_people_path(request.query_parameters.merge(format: :csv)),
              title: "Bank details are masked to their last four digits",
              class: btn_classes(:secondary, :sm) %>
</div>

<%= render CardComponent.new(title: "#{@people.total_count} #{'person'.pluralize(@people.total_count)}") do %>
  <% if @people.total_count.zero? %>
    <p class="py-4 text-center text-gray-600">No people found in the registry.</p>
  <% else %>
    <div class="flex flex-col gap-2">
      <% @people.each do |person| %>
        <% editing = @edit_person_id == person.record_id %>
        <% claims = @claim_counts[person.record_id].to_i %>
        <%# id + scroll-mt: a save redirects back to ?person=<id>#person-<id>,
            so the row reopens where the operator left it instead of collapsing
            and throwing them to the top. The margin clears the sticky header. %>
        <%= tag.details id: "person-#{person.record_id}",
                        class: "group scroll-mt-20 rounded border border-gray-200",
                        open: editing || @open_person_id == person.record_id do %>
          <summary class="flex flex-wrap items-center gap-x-4 gap-y-1 px-3 py-2 cursor-pointer">
            <%# A visible affordance: nothing said these rows opened, so the
                bank-details editor may as well not have been there. %>
            <i class="fas fa-chevron-right w-3 text-xs text-gray-400 transition-transform group-open:rotate-90"
               aria-hidden="true"></i>
            <span class="font-medium min-w-40"><%= person.name.presence || "-" %></span>
            <span class="text-gray-600 grow"><%= person.email.presence || "-" %></span>
            <%= reimbursements_modulus_badge(person, checker: modulus_checker) %>
            <% if person.verified %>
              <%= render BadgeComponent.new(type: :success, pill: true).with_content("Verified") %>
            <% else %>
              <%= render BadgeComponent.new(type: :secondary, pill: true).with_content("Unverified") %>
            <% end %>
            <%# Their claims, filtered to them. A person had no link out to
                anything, so "what has this payee actually claimed?" meant
                searching the expenses index by hand. %>
            <% if claims.positive? %>
              <%= link_to pluralize(claims, "claim"),
                          admin_reimbursements_expense_edits_path(person: person.record_id),
                          class: "text-sm text-primary underline" %>
            <% else %>
              <span class="text-sm text-gray-500">No claims</span>
            <% end %>
          </summary>

          <div class="border-t border-gray-200 px-3 py-3">
            <% error_id = "bank_details_error_#{person.record_id}" if editing && @edit_error.present? %>
            <%# The fields hold the REAL values — the operator is here to correct
                a typo — so they are hidden as a password rather than masked,
                which would invite saving "****4958" as an account number. %>
            <%= form_with url: admin_reimbursements_person_path(person.record_id), method: :patch,
                          class: "flex flex-wrap items-end gap-3",
                          data: { controller: "bank-details" } do %>
              <div>
                <%= label_tag "sort_code_#{person.record_id}", "Sort code", class: "block text-sm font-medium" %>
                <%= text_field_tag :sort_code, editing ? @edit_sort_code : person.sort_code,
                                   id: "sort_code_#{person.record_id}",
                                   placeholder: "80-22-60", autocomplete: "off",
                                   "aria-describedby": error_id, "aria-invalid": error_id.present?,
                                   data: { "bank-details-target": "field" },
                                   class: input_classes(width: nil) %>
              </div>
              <div>
                <%= label_tag "account_number_#{person.record_id}", "Account number", class: "block text-sm font-medium" %>
                <%= text_field_tag :account_number, editing ? @edit_account_number : person.account_number,
                                   id: "account_number_#{person.record_id}",
                                   placeholder: "12345678", autocomplete: "off",
                                   "aria-describedby": error_id, "aria-invalid": error_id.present?,
                                   data: { "bank-details-target": "field" },
                                   class: input_classes(width: nil) %>
              </div>
              <button type="button" class="<%= btn_classes(:secondary, :sm) %>"
                      aria-pressed="false"
                      aria-label="Reveal bank details for <%= person.name.presence || "this person" %>"
                      data-bank-details-target="toggle"
                      data-action="bank-details#toggle">Reveal</button>
              <%= submit_tag "Save bank details", "aria-label": "Save bank details for #{person.name.presence || 'this person'}",
                             class: btn_classes(:primary, :sm) %>
            <% end %>

            <% if error_id %>
              <p id="<%= error_id %>" role="alert" class="mt-2 text-sm text-danger"><%= @edit_error %></p>
            <% end %>

            <%= form_with url: admin_reimbursements_person_path(person.record_id), method: :patch,
                          class: "mt-3" do %>
              <%= hidden_field_tag :verify, "1" %>
              <% verify_hint_id = "verify_hint_#{person.record_id}" unless person.bank_details? %>
              <%= submit_tag "Mark as verified",
                             disabled: !person.bank_details?,
                             "aria-describedby": verify_hint_id,
                             "aria-label": "Mark #{person.name.presence || 'this person'} as verified",
                             class: "#{btn_classes(:secondary, :sm)} disabled:opacity-50 disabled:cursor-not-allowed" %>
              <% if verify_hint_id %>
                <span id="<%= verify_hint_id %>" class="text-xs text-gray-500 ml-1">
                  Only available when bank details are present
                </span>
              <% end %>
            <% end %>

            <% if person.notes.present? %>
              <div class="mt-3">
                <p class="text-sm font-medium">Notes</p>
                <pre class="mt-1 whitespace-pre-wrap text-xs text-gray-600"><%= person.notes %></pre>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
    <% if @people.total_pages > 1 %>
      <div class="mt-3"><%= paginate @people, window: 2 %></div>
    <% end %>
  <% end %>
<% end %>
