<%# ?focus=expense-<id> survives a Turbo form submission; the redirect's
    fragment does not. %>
<div data-controller="scroll-to" data-scroll-to-param-value="focus"></div>
<%= render "admin/reimbursements/shared/cost_centre_selector" %>
<p class="mb-3 text-gray-600">
  Review submitted expenses before they go to EUSA. Fix anything flagged, then approve or
  reject. UK claims with bank details on file carry a live modulus check.
  <%= link_to "What the words mean", admin_reimbursements_glossary_path, class: "underline" %>.
</p>

<%= render "admin/reimbursements/shared/glossary_terms",
           summary: "What the words on these cards mean",
           terms: ::Reimbursements::Glossary.terms(:statuses, :endorse, :committed, :batch) %>

<%# Plain navigation links, so aria-current, not role="tab", which promises
    arrow-key widget behaviour. Awaiting owner sits first as the earlier step
    in a claim's life; To approve is the default. %>
<nav aria-label="Review status" class="mb-4 flex gap-2 border-b border-gray-200">
  <% { "awaiting_owner" => @awaiting_owner, "to_approve" => @to_approve, "approved" => @approved }.each do |tab, list| %>
    <%= link_to "#{tab.humanize} (#{list.size})", admin_reimbursements_review_path(tab: tab),
                "aria-current": ("page" if @tab == tab),
                class: (@tab == tab ? "border-b-2 border-primary font-medium text-primary px-3 py-2" : "px-3 py-2 text-gray-600") %>
  <% end %>
  <span class="ml-auto self-center pb-1">
    <%# The query carries ?tab=, so the download follows the tab. %>
    <%= link_to "Download CSV",
                admin_reimbursements_review_path(request.query_parameters.merge(format: :csv)),
                title: "The expenses on this tab", class: btn_classes(:secondary, :sm) %>
  </span>
</nav>

<% case @tab %>
<% when "approved" %>
  <% if @approved.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      No approved expenses yet. Work the To approve tab first.
    <% end %>
  <% else %>
    <p class="mb-3 text-gray-600">
      <%= @approved.size %> approved, total <%= reimbursements_money(@approved.sum { |e| e.amount || 0 }) %>.
      <%# Carries the selected cost centre: a batch is built for one pot. %>
      Ready to submit on
      <%= link_to "the Build Batch page",
                  new_admin_reimbursements_batch_path(cost_centre: selected_cost_centre&.key),
                  class: "text-primary underline" %>.
    </p>
    <% @approved.each do |expense| %>
      <%= render "expense_card", expense: expense, allow_approve: false, duplicates: nil %>
    <% end %>
  <% end %>

<% when "awaiting_owner" %>
  <% if @awaiting_owner.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      Nothing is waiting on a budget owner.
    <% end %>
  <% else %>
    <p class="mb-3 text-gray-600">
      <%= @awaiting_owner.size %> awaiting a budget owner's sign-off,
      total <%= reimbursements_money(@awaiting_owner.sum { |e| e.amount || 0 }) %>.
    </p>
    <%= render AlertComponent.new(type: :info) do %>
      These are with their budget owners, who endorse them from My Budgets. Where no owner can
      act, override the sign-off here: the override is recorded against your account.
      <%# Describes NightlyBatchJob#remind_budget_owners (no age threshold). %>
      An owner with an address on file is reminded on each run day until they sign off or the
      claim is rejected. An owner with no address is never emailed: chase them, or override the
      sign-off below.
    <% end %>
    <%# No bulk approve here: it skips every gated claim, so could only ever
        report "0 approved". %>
    <div data-controller="bulk-review">
      <div class="mb-4 flex flex-wrap items-center gap-3 rounded border border-gray-200 bg-gray-50 p-3">
        <label class="flex items-center gap-2 text-sm font-medium">
          <%= check_box_tag "select_all", "1", false,
                            data: { bulk_review_target: "selectAll", action: "bulk-review#toggleAll" },
                            class: "h-4 w-4" %>
          Select all
        </label>
        <span class="text-sm text-gray-600" data-bulk-review-target="counter">0 selected</span>
        <%= form_with url: admin_reimbursements_bulk_override_approve_review_path(tab: @tab),
                      method: :patch, id: "bulk-review-form",
                      class: "flex flex-wrap items-center gap-2" do %>
          <%= text_field_tag :override_note, nil,
                             placeholder: "Why are you overriding? (required)",
                             "aria-label": "Why you are overriding sign-off",
                             data: { bulk_review_target: "reason", action: "bulk-review#refresh" },
                             class: input_classes(width: nil) %>
          <%= submit_tag "Override sign-off and approve",
                         data: { bulk_review_target: "overrideButton", disable_with: false },
                         disabled: true, class: btn_classes(:warning, :sm) %>
        <% end %>
      </div>

      <% @awaiting_owner.each do |expense| %>
        <%= render "expense_card", expense: expense, allow_approve: true, selectable: true,
                   duplicates: @duplicates[expense.record_id] %>
      <% end %>
    </div>
  <% end %>

<% else %>
  <% if @to_approve.empty? %>
    <%= render AlertComponent.new(type: :info) do %>
      Nothing to approve.
      <% if @awaiting_owner.any? %>
        <%= link_to pluralize(@awaiting_owner.size, "claim"),
                    admin_reimbursements_review_path(tab: "awaiting_owner"),
                    class: "text-primary underline" %>
        <%= @awaiting_owner.one? ? "is" : "are" %> still with a budget owner.
      <% end %>
    <% end %>
  <% else %>
    <p class="mb-3 text-gray-600">
      <%= @to_approve.size %> to approve, total <%= reimbursements_money(@to_approve.sum { |e| e.amount || 0 }) %>.
    </p>

    <div data-controller="bulk-review">
      <%# The cards' checkboxes join this form through form="bulk-review-form". %>
      <div class="mb-4 flex flex-wrap items-center gap-3 rounded border border-gray-200 bg-gray-50 p-3">
        <label class="flex items-center gap-2 text-sm font-medium">
          <%= check_box_tag "select_all", "1", false,
                            data: { bulk_review_target: "selectAll", action: "bulk-review#toggleAll" },
                            class: "h-4 w-4" %>
          Select all
        </label>
        <span class="text-sm text-gray-600" data-bulk-review-target="counter">0 selected</span>
        <%= form_with url: admin_reimbursements_bulk_approve_review_path(tab: @tab), method: :patch,
                      id: "bulk-review-form", class: "flex flex-wrap items-center gap-2" do %>
          <%# Deliberately NOT required: the box is shared with Approve selected.
              bulk-review enables Reject only once it is filled. %>
          <%= text_field_tag :rejection_reason, nil, placeholder: "Reason (required to reject)",
                             data: { bulk_review_target: "reason", action: "bulk-review#refresh" },
                             class: input_classes(width: nil) %>
          <%= submit_tag "Approve selected",
                         data: { bulk_review_target: "approveButton" }, disabled: true,
                         class: btn_classes(:success, :sm) %>
          <%= submit_tag "Reject selected",
                         formaction: admin_reimbursements_bulk_reject_review_path(tab: @tab),
                         data: { bulk_review_target: "rejectButton", disable_with: false,
                                 turbo_confirm: "Reject the selected expenses and email each producer?" },
                         disabled: true, class: btn_classes(:danger, :sm) %>
        <% end %>
      </div>

      <h2 class="mt-4 mb-2 text-lg font-semibold">Ready to approve (<%= @ready.size %>)</h2>
      <% if @ready.empty? %>
        <%= render AlertComponent.new(type: :info) do %>
          Every claim on this tab needs attention before approving.
        <% end %>
      <% else %>
        <% @ready.each do |expense| %>
          <%= render "expense_card", expense: expense, allow_approve: true, selectable: true, duplicates: @duplicates[expense.record_id] %>
        <% end %>
      <% end %>

      <h2 class="mt-6 mb-2 text-lg font-semibold">Needs attention (<%= @attention.size %>)</h2>
      <% if @attention.empty? %>
        <%= render AlertComponent.new(type: :info) do %>
          None: everything on this tab is ready to approve.
        <% end %>
      <% else %>
        <%= render AlertComponent.new(type: :warning) do %>
          These have a data problem to fix before approving: a missing excl.-VAT amount, no budget,
          no receipts, invalid bank details, over budget, or a possible duplicate.
        <% end %>
        <% @attention.each do |expense| %>
          <%= render "expense_card", expense: expense, allow_approve: true, selectable: true, duplicates: @duplicates[expense.record_id] %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
