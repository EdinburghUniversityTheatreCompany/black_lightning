<%# locals: (image:, variant: nil, full_width: true, priority: false, alt: nil, image_options: {}, proxy: false) -%>
<%# KEEP %>

<%# full_width and priority used to be one flag called eager_load, which set the layout classes
    AND loading="eager" together. That coupled a styling decision to a performance one and got
    the performance one backwards: every card below the fold loaded eagerly while the masthead,
    the largest thing above it, inherited the app-wide lazy default. Measured on the live
    homepage, that cost 1552ms of LCP on a throttled phone.

    loading is left unset unless priority is passed, so it falls through to
    config.action_view.image_loading ("lazy"). %>

<% if variant.nil?
  if Rails.env.local?
    raise ArgumentError, "_image partial called without a variant — this serves the full-size blob. Pass variant: or use image_tag directly if you intentionally want full size."
  else
    Rails.logger.warn("[_image.erb] called without variant for blob #{image.try(:blob)&.id} — serving full-size. Fix the caller.")
  end
end
%>

<% width_and_height = if variant.present?
  variant_width_and_height_html(variant)
else
  base_width_and_height_html(image)
end
%>

<% image_options = image_options.merge(width_and_height) %>

<%# Always an alt attribute. Every image on the site was missing one entirely, which is a
    WCAG 2.2 1.1.1 failure; an explicit empty alt at least marks an image as decorative, which
    is the correct answer for the ones that carry no information a caption does not. %>
<% image_options = image_options.merge(alt: alt.to_s) %>

<% if full_width %>
  <% image_options = image_options.merge({ class: "w-full h-auto #{image_options[:class]}" }) %>
<% end %>

<% if priority %>
  <% image_options = image_options.merge({ loading: "eager", fetchpriority: "high" }) %>
<% end %>

<% if variant.present? %>
  <% image = image.variant(variant) %>
<% end %>

<% if proxy %>
  <%= image_tag(active_storage_proxy_url(image), image_options) %>
<% else %>
  <%= image_tag(image, image_options) %>
<% end %>
