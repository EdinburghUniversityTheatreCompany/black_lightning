<%= turbo_frame_tag "reconcile" do %>
<% if @reconciliation_errors.present? %>
  <%= render AlertComponent.new(type: :warning) do %>
    <p>Reconciliation finished, but <%= @reconciliation_errors.size %>
      row<%= "s" unless @reconciliation_errors.size == 1 %> hit a problem; everything else below
      still committed. Check these before assuming the paste is fully applied:</p>
    <ul class="list-disc list-inside mt-1">
      <% @reconciliation_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <%= render AlertComponent.new(type: :success) do %>
    Reconciliation complete.
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Summary") do %>
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 text-center">
    <% [ [ @expenses_paid, "Expenses marked Paid" ],
         [ @offsets_linked, "Offsetting pairs linked" ],
         [ @credits_linked, "Credit rows linked to budgets" ],
         [ @unmatched_saved, "Unmatched rows saved" ],
         [ @skipped_count, "Already-imported rows skipped" ] ].each do |count, label| %>
      <div>
        <div class="text-2xl font-semibold"><%= count %></div>
        <div class="text-sm text-gray-600"><%= label %></div>
      </div>
    <% end %>
  </div>
<% end %>

<%# Rows deliberately not imported are reported again here, so the summary is never quietly smaller
    than the paste. %>
<%= render "attribution_skips", attribution: @attribution %>

<p class="mt-2 text-sm text-gray-600">
  Nobody was emailed. Producers hear from us when their claim goes into a batch, and by the
  time these actuals arrive the money is already in their account.
</p>

<%# "_top": the ledger has no matching frame, so a plain link out of this one renders "Content missing". %>
<div class="mt-4 flex flex-wrap gap-2">
  <% if @unmatched_saved.positive? %>
    <%= link_to "See the #{pluralize(@unmatched_saved, 'unmatched row')} on the EUSA Actuals ledger",
                admin_reimbursements_actuals_path(
                  state: ::Admin::Reimbursements::ActualsController::STATE_NEEDS_ATTENTION
                ),
                class: btn_classes(:primary), data: { turbo_frame: "_top" } %>
  <% end %>
  <%= link_to "Reconcile another month", admin_reimbursements_reconciliation_path,
              class: btn_classes(:secondary) %>
</div>
<% end %>
